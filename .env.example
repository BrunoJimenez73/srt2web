# SRT2Web Environment Variables
# Cross-platform: works on Windows, macOS, Linux
#
# First-time setup: this file is auto-copied to .env by Install.bat / install_Mac.sh.
# If SRT2WEB_JWT_SECRET is empty, the installer generates a secure random value
# using `secrets.token_urlsafe(32)`. You can also set it manually:
#   Windows PowerShell:  $env:SRT2WEB_JWT_SECRET = "your-secret-here"
#   macOS/Linux bash:    export SRT2WEB_JWT_SECRET="your-secret-here"
#   (or just edit this .env file after install)
#
# To rotate the JWT secret at any time, run the installer again or use:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# Security
# SRT2WEB_JWT_SECRET: signing key for JWT auth tokens (used by core/auth_db.py).
# Leave empty for the installer to generate a secure value automatically.
SRT2WEB_JWT_SECRET=

# Server
SERVER_HOST=127.0.0.1
SERVER_PORT=9999

# Input - SRT
SRT_LISTEN_PORT=9000
SRT_MODE=listener
SRT_LATENCY_MS=200
SRT_CALLER_ADDRESS=

# Input - RTMP
RTMP_LISTEN_PORT=1935
RTMP_APP=live
RTMP_STREAM_KEY=stream
RTMP_URL=

# Output
OUTPUT_DIR=./output

# FFmpeg (auto-detected if left empty)
# FFMPEG_PATH=
#   Windows: C:\ffmpeg\bin\ffmpeg.exe
#   macOS:   /opt/homebrew/bin/ffmpeg (Homebrew)
#   Linux:   /usr/bin/ffmpeg

# GPU (optional)
# CUDA_VISIBLE_DEVICES=0      # Windows/Linux NVIDIA
# On macOS (Apple Silicon): MPS is auto-detected, no env needed

# Logging
LOG_LEVEL=INFO
# LOG_DIR overrides default log directory (platform-dependent):
#   Windows: %LOCALAPPDATA%/srt2web/Logs/
#   macOS:   ~/Library/Logs/srt2web/
#   Linux:   ~/.cache/srt2web/log/
# LOG_DIR=./logs

# Pipeline
PIPELINE_CHUNK_DURATION_SEC=10
PIPELINE_MODE=thread_parallel
PIPELINE_MAX_CONCURRENT_CHUNKS=3
PIPELINE_BUFFER_SIZE=5
PIPELINE_RETRY_ATTEMPTS=2
PIPELINE_RETRY_DELAY=1.0

# Modules
MODULES_TRANSCRIBER_MODEL=tiny
MODULES_TRANSCRIBER_LANGUAGE=en
# Device: auto | cuda | mps | cpu (auto detects platform)
MODULES_TRANSCRIBER_DEVICE=auto
MODULES_TRANSCRIBER_BEAM_SIZE=2

MODULES_TRANSLATOR_SOURCE_LANG=en
MODULES_TRANSLATOR_TARGET_LANG=es

MODULES_SUBTITLE_GENERATOR_FORMAT=webvtt
MODULES_SUBTITLE_GENERATOR_USE_TRANSLATED=true
MODULES_SUBTITLE_GENERATOR_CHUNK_DURATION=10

MODULES_TTS_ENGINE_ENABLED=true
MODULES_TTS_ENGINE_ENGINE=piper
# Device: auto | cuda | mps | cpu (auto detects platform on macOS)
MODULES_TTS_ENGINE_DEVICE=auto
MODULES_TTS_ENGINE_VOICE=es_ES-davefx-medium
MODULES_TTS_ENGINE_SPEED=1.2

MODULES_AUDIO_MIXER_ENABLED=true
MODULES_AUDIO_MIXER_ORIGINAL_VOLUME=0.8
MODULES_AUDIO_MIXER_TTS_VOLUME=1.0
MODULES_AUDIO_MIXER_DUBBED_VOLUME=1.0

MODULES_VIDEO_MUXER_ENABLED=true
MODULES_VIDEO_MUXER_ENGINE=hls
MODULES_VIDEO_MUXER_HLS_SEGMENT_DURATION=4
MODULES_VIDEO_MUXER_HLS_LIST_SIZE=6
MODULES_VIDEO_MUXER_AUDIO_OFFSET_MS=0
# Encoder: auto | passthrough | cpu | gpu_nvenc (NVENC) | videotoolbox (macOS)
MODULES_VIDEO_MUXER_ENCODER_MODE=auto
MODULES_VIDEO_MUXER_VIDEO_QUALITY=medium
MODULES_VIDEO_MUXER_VIDEO_CRF=23
MODULES_VIDEO_MUXER_AUDIO_CODEC=aac
MODULES_VIDEO_MUXER_AUDIO_BITRATE=128k
MODULES_VIDEO_MUXER_AUDIO_SAMPLERATE=48000
MODULES_VIDEO_MUXER_VIDEO_BITRATE=500k
MODULES_VIDEO_MUXER_VIDEO_FPS=15
MODULES_VIDEO_MUXER_VIDEO_WIDTH=320
MODULES_VIDEO_MUXER_VIDEO_HEIGHT=240
MODULES_VIDEO_MUXER_GPU_PRESET=p7
MODULES_VIDEO_MUXER_VIDEO_PRESET=medium
