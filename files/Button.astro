---
/**
 * Componente Button reutilizable.
 * Soporta variantes, tamaños, estados loading/disabled y es accesible (WCAG 2.1 AA).
 */
export interface Props {
  /** Variante visual del botón */
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'danger';
  /** Tamaño del botón */
  size?: 'xs' | 'sm' | 'md' | 'lg';
  /** Tipo HTML del botón */
  type?: 'button' | 'submit' | 'reset';
  /** Muestra spinner de carga y deshabilita el botón */
  loading?: boolean;
  /** Deshabilita el botón */
  disabled?: boolean;
  /** URL si el botón actúa como enlace */
  href?: string;
  /** Clases CSS adicionales */
  class?: string;
  /** Atributos ARIA adicionales */
  'aria-label'?: string;
}

const {
  variant = 'primary',
  size = 'md',
  type = 'button',
  loading = false,
  disabled = false,
  href,
  class: className = '',
  'aria-label': ariaLabel,
  ...rest
} = Astro.props;

const isDisabled = disabled || loading;

const BASE =
  'inline-flex items-center justify-center gap-2 rounded-md font-semibold ' +
  'transition-all duration-200 focus-visible:outline focus-visible:outline-2 ' +
  'focus-visible:outline-offset-2 disabled:pointer-events-none disabled:opacity-50 ' +
  'select-none';

const VARIANTS = {
  primary:   'bg-blue-600 text-white hover:bg-blue-700 focus-visible:outline-blue-600',
  secondary: 'bg-gray-100 text-gray-900 hover:bg-gray-200 focus-visible:outline-gray-500',
  outline:   'border-2 border-blue-600 text-blue-600 hover:bg-blue-50 focus-visible:outline-blue-600',
  ghost:     'text-blue-600 hover:bg-blue-50 focus-visible:outline-blue-600',
  danger:    'bg-red-600 text-white hover:bg-red-700 focus-visible:outline-red-600',
};

const SIZES = {
  xs: 'h-7  px-2.5 text-xs',
  sm: 'h-8  px-3   text-sm',
  md: 'h-10 px-4   text-sm',
  lg: 'h-12 px-6   text-base',
};

const classes = [BASE, VARIANTS[variant], SIZES[size], className].join(' ');
---

{href ? (
  <a
    href={href}
    class={classes}
    aria-label={ariaLabel}
    aria-disabled={isDisabled}
    {...rest}
  >
    {loading && (
      <svg
        class="h-4 w-4 animate-spin"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
      >
        <circle
          class="opacity-25"
          cx="12" cy="12" r="10"
          stroke="currentColor" stroke-width="4"
        />
        <path
          class="opacity-75"
          fill="currentColor"
          d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
        />
      </svg>
    )}
    <slot />
  </a>
) : (
  <button
    type={type}
    class={classes}
    disabled={isDisabled}
    aria-label={ariaLabel}
    aria-busy={loading}
    {...rest}
  >
    {loading && (
      <svg
        class="h-4 w-4 animate-spin"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
      >
        <circle
          class="opacity-25"
          cx="12" cy="12" r="10"
          stroke="currentColor" stroke-width="4"
        />
        <path
          class="opacity-75"
          fill="currentColor"
          d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
        />
      </svg>
    )}
    <slot />
  </button>
)}
