# ────────────────────────────────────────────────────────────────────────────
# .env.example — Copia este archivo a .env y rellena los valores.
# NUNCA commits el archivo .env real al repositorio.
# ────────────────────────────────────────────────────────────────────────────

# ─── App ─────────────────────────────────────────────────────────────────────
APP_NAME="Mi Proyecto API"
APP_VERSION="0.1.0"
# Opciones: development | staging | production
ENVIRONMENT=development
DEBUG=False

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite para desarrollo local (sin instalar Postgres):
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# PostgreSQL para producción:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname

POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpass
POSTGRES_DB=devdb

# Pool settings
DB_ECHO=False
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=3600

# ─── Security ─────────────────────────────────────────────────────────────────
# IMPORTANTE: Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_PLEASE_USE_SECRETS_TOKEN_URLSAFE

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Lista separada por comas de orígenes permitidos
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Logging ──────────────────────────────────────────────────────────────────
# Opciones: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ─── Redis (opcional, para cache y background tasks) ──────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Frontend ─────────────────────────────────────────────────────────────────
PUBLIC_API_URL=http://localhost:8000
PUBLIC_API_TIMEOUT=30000
