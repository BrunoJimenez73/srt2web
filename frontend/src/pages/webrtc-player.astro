---
const pageTitle = "SRT2Web — WebRTC Player";
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <div id="video-container">
        <video id="video-player" controls autoplay playsinline></video>
        <div id="waiting" class="waiting-text">Conectando WebRTC...</div>
        <div id="error-overlay" class="error-overlay" style="display: none;">
            <div class="error-content">
                <span class="error-icon">⚠️</span>
                <span class="error-message" id="error-message">Error de conexión</span>
                <button class="btn-retry" id="btn-retry">Reintentar</button>
            </div>
        </div>
        <div id="stats-overlay" class="stats-overlay">
            <span id="latency-stat" class="stat-item">Latencia: --</span>
            <span id="resolution-stat" class="stat-item">Resolución: --</span>
            <span id="bitrate-stat" class="stat-item">Bitrate: --</span>
        </div>
    </div>
</body>
</html>

<style>
    :root {
        --bg-deep: #0a0a0f;
        --accent: #6366f1;
    }

    body, html {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        background-color: #000;
        overflow: hidden;
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: 'Inter', system-ui, sans-serif;
    }
    
    #video-container {
        width: 100%;
        height: 100%;
        position: relative;
    }

    #video-player {
        width: 100%;
        height: 100%;
        background-color: #000;
        object-fit: contain;
    }

    .waiting-text {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        color: rgba(255,255,255,0.6);
        text-align: center;
        pointer-events: none;
        font-size: 18px;
    }

    .error-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.85);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 10;
    }

    .error-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
        padding: 24px;
        background: #1a1a24;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.1);
    }

    .error-icon {
        font-size: 48px;
    }

    .error-message {
        color: #ef4444;
        font-size: 16px;
        text-align: center;
    }

    .btn-retry {
        background: #6366f1;
        color: white;
        border: none;
        padding: 10px 24px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
    }

    .btn-retry:hover {
        background: #7c7ff7;
    }

    .stats-overlay {
        position: absolute;
        top: 10px;
        left: 10px;
        display: flex;
        gap: 12px;
        z-index: 5;
    }

    .stat-item {
        background: rgba(0, 0, 0, 0.7);
        color: #fff;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 12px;
        font-family: monospace;
    }
</style>

<script is:inline>
class WebRTCPlayer {
    constructor() {
        this.video = document.getElementById('video-player');
        this.waiting = document.getElementById('waiting');
        this.errorOverlay = document.getElementById('error-overlay');
        this.errorMessage = document.getElementById('error-message');
        this.btnRetry = document.getElementById('btn-retry');
        this.latencyStat = document.getElementById('latency-stat');
        this.resolutionStat = document.getElementById('resolution-stat');
        this.bitrateStat = document.getElementById('bitrate-stat');
        
        this.pc = null;
        this.clientId = null;
        this.connectTime = null;
        this.statsInterval = null;
        
        this.init();
    }

    init() {
        this.btnRetry.addEventListener('click', () => this.connect());
        this.connect();
    }

    async connect() {
        try {
            this.showError(false);
            this.waiting.style.display = 'block';
            this.waiting.textContent = 'Conectando WebRTC...';

            // Create RTCPeerConnection
            this.pc = new RTCPeerConnection({
                iceServers: [
                    { urls: 'stun:stun.l.google.com:19302' },
                    { urls: 'stun:stun1.l.google.com:19302' }
                ]
            });

            // Add video element
            this.video.srcObject = new MediaStream();
            
            // Handle incoming tracks
            this.pc.ontrack = (event) => {
                console.log('Received track:', event.track.kind);
                const stream = event.streams[0];
                this.video.srcObject = stream;
                this.waiting.style.display = 'none';
                this.startStats();
            };

            // Handle connection state changes
            this.pc.onconnectionstatechange = () => {
                console.log('Connection state:', this.pc.connectionState);
                switch(this.pc.connectionState) {
                    case 'connected':
                        this.connectTime = Date.now();
                        this.waiting.style.display = 'none';
                        break;
                    case 'disconnected':
                    case 'failed':
                        this.showError(true, 'Conexión WebRTC perdida');
                        this.stopStats();
                        break;
                    case 'closed':
                        this.stopStats();
                        break;
                }
            };

            // Handle ICE connection state
            this.pc.oniceconnectionstatechange = () => {
                console.log('ICE state:', this.pc.iceConnectionState);
            };

            // Create offer
            const offer = await this.pc.createOffer();
            await this.pc.setLocalDescription(offer);

            // Wait for ICE gathering to complete
            await this.waitForIceGathering();

            // Send offer to server
            const response = await fetch('/webrtc/offer', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    sdp: this.pc.localDescription.sdp,
                    type: this.pc.localDescription.type
                })
            });

            if (!response.ok) {
                throw new Error(`Server error: ${response.status}`);
            }

            const answer = await response.json();
            this.clientId = answer.client_id;

            // Set remote description (answer)
            await this.pc.setRemoteDescription(new RTCSessionDescription({
                sdp: answer.sdp,
                type: answer.type
            }));

            console.log('WebRTC connection established');

        } catch (error) {
            console.error('WebRTC connection error:', error);
            this.showError(true, `Error: ${error.message}`);
        }
    }

    waitForIceGathering() {
        return new Promise((resolve) => {
            if (this.pc.iceGatheringState === 'complete') {
                resolve();
            } else {
                const checkState = () => {
                    if (this.pc.iceGatheringState === 'complete') {
                        this.pc.removeEventListener('icegatheringstatechange', checkState);
                        resolve();
                    }
                };
                this.pc.addEventListener('icegatheringstatechange', checkState);
                
                // Timeout after 5 seconds
                setTimeout(resolve, 5000);
            }
        });
    }

    startStats() {
        this.statsInterval = setInterval(() => this.updateStats(), 2000);
    }

    stopStats() {
        if (this.statsInterval) {
            clearInterval(this.statsInterval);
            this.statsInterval = null;
        }
    }

    async updateStats() {
        if (!this.pc || this.pc.connectionState !== 'connected') {
            return;
        }

        try {
            const stats = await this.pc.getStats();
            let bytesReceived = 0;
            let packetsLost = 0;
            let framesDecoded = 0;
            let frameWidth = 0;
            let frameHeight = 0;
            let framerate = 0;

            stats.forEach(report => {
                if (report.type === 'inbound-rtp' && report.kind === 'video') {
                    bytesReceived = report.bytesReceived || 0;
                    packetsLost = report.packetsLost || 0;
                    framesDecoded = report.framesDecoded || 0;
                    frameWidth = report.frameWidth || 0;
                    frameHeight = report.frameHeight || 0;
                    framerate = report.framesPerSecond || 0;
                }
            });

            // Calculate latency (approximate)
            let latency = '--';
            if (this.connectTime) {
                const elapsed = Date.now() - this.connectTime;
                latency = `${(elapsed / 1000).toFixed(1)}s`;
            }

            // Update stats display
            this.latencyStat.textContent = `Latencia: ${latency}`;
            this.resolutionStat.textContent = `Resolución: ${frameWidth}x${frameHeight}`;
            this.bitrateStat.textContent = `FPS: ${framerate.toFixed(1)}`;

        } catch (error) {
            console.error('Error getting stats:', error);
        }
    }

    showError(show, message = '') {
        this.errorOverlay.style.display = show ? 'flex' : 'none';
        if (message) {
            this.errorMessage.textContent = message;
        }
    }

    disconnect() {
        this.stopStats();
        
        if (this.clientId) {
            fetch('/webrtc/close', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ client_id: this.clientId })
            }).catch(() => {});
        }

        if (this.pc) {
            this.pc.close();
            this.pc = null;
        }
    }
}

// Initialize player when DOM is ready
document.addEventListener('DOMContentLoaded', () => {
    window.player = new WebRTCPlayer();
});

// Cleanup on page unload
window.addEventListener('beforeunload', () => {
    if (window.player) {
        window.player.disconnect();
    }
});
</script>