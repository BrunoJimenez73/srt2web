---
const pageTitle = "SRT2Web — Live Player";
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <div id="video-container">
    <video id="video-player" controls autoplay playsinline crossorigin="anonymous"></video>
        <div id="waiting" class="waiting-text">
            <span class="loading-spinner"></span>
            <span class="waiting-message">Esperando stream...</span>
            <span class="waiting-hint">Inicia OBS y el pipeline para comenzar</span>
        </div>
        <div id="error-overlay" class="error-overlay" style="display: none;">
            <div class="error-content">
                <span class="error-icon">⚠️</span>
                <span class="error-message" id="error-message">Error de conexión</span>
                <button class="btn-retry" id="btn-retry">Reintentar</button>
            </div>
        </div>
        <button id="btn-cc" class="cc-btn" title="Activar/desactivar subtítulos" aria-label="Subtítulos">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2" />
                <path d="M8.5 10.5a1.5 1.5 0 0 1 2.5-1.1l1.4-1A3.5 3.5 0 1 0 9 14.5a3.5 3.5 0 0 0 2.4-1l-1.4-1a1.5 1.5 0 1 1-1.5-2z" />
                <path d="M15.5 10.5a1.5 1.5 0 0 1 2.5-1.1l1.4-1A3.5 3.5 0 1 0 16 14.5a3.5 3.5 0 0 0 2.4-1l-1.4-1a1.5 1.5 0 1 1-1.5-2z" />
            </svg>
        </button>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/hls.js@1.5.7/dist/hls.min.js" integrity="sha384-1B+J55elPxu+trIhW7QThjZg3evX8C5P6zjB82Xnn46RKPAXpL+vkanRSjCidsJv" crossorigin="anonymous"></script>
    <script>
        // Always (re-)register the service worker on the player page too. Without this,
        // a user opening /player first (before the dashboard) keeps the old SW
        // (or no SW at all), so they can replay cached HLS segments from a previous
        // session — the "stale images" bug. Registering here is idempotent and
        // fast; the browser will skip the install step if the SW is up to date.
        if ("serviceWorker" in navigator) {
            window.addEventListener("load", () => {
                navigator.serviceWorker
                    .register("/service-worker.js")
                    .catch(() => {
                        /* registration can fail in dev (no HTTPS) — non-fatal */
                    });
            });
        }
    </script>
    <script>
        import { initHlsPlayer } from '../lib/modules/player';
        initHlsPlayer();
    </script>
</body>
</html>

<style>
    :root {
        --bg-deep: #0a0a0f;
        --accent: #6366f1;
    }

    body, html {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        background-color: #000;
        overflow: hidden;
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: 'Inter', system-ui, sans-serif;
    }

    #video-container {
        width: 100%;
        height: 100%;
        position: relative;
    }

    #video-player {
        width: 100%;
        height: 100%;
        background-color: #000;
        object-fit: contain;
    }

    #subtitle-renderer-cue {
        position: absolute;
        bottom: 52px;
        left: 50%;
        transform: translateX(-50%);
        color: #fff;
        background-color: rgba(0, 0, 0, 0.82);
        padding: 6px 14px;
        border-radius: 4px;
        font-size: 1.2em;
        font-family: 'Inter', system-ui, sans-serif;
        font-weight: 500;
        text-align: center;
        pointer-events: none;
        z-index: 10;
        max-width: 80%;
        line-height: 1.4;
        display: none;
    }

    /* Hide ALL CC buttons across all browsers and Shadow DOM implementations */
    video::-webkit-media-controls-toggle-closed-captions-button {
        display: none !important;
    }
    video::-webkit-media-controls-overlay-toggle-closed-captions-button {
        display: none !important;
    }
    video::-moz-media-controls-toggle-closed-captions-button {
        display: none !important;
    }
    video::-ms-toggle-closed-captions-button {
        display: none !important;
    }
    /* HLS.js injects its own CC button into the shadow DOM — hide by parent */
    video + .hlsjs-subtitle-controls,
    video ~ .hlsjs-subtitle-controls {
        display: none !important;
    }
    /* Safari/WebKit native CC button in AVPlayer */
    video::-webkit-media-controls {
        --webkit-media-controls-toggle-closed-captions-button-display: none;
    }

    .cc-btn {
        position: absolute;
        bottom: 72px;
        right: 12px;
        z-index: 10;
        background: rgba(0,0,0,0.55);
        border: 1px solid rgba(255,255,255,0.15);
        border-radius: 6px;
        color: rgba(255,255,255,0.6);
        padding: 6px 7px;
        cursor: pointer;
        display: none;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        opacity: 0;
        line-height: 0;
    }
    .cc-btn.visible {
        display: flex;
        opacity: 1;
    }
    .cc-btn:hover {
        background: rgba(0,0,0,0.75);
        color: #fff;
        border-color: rgba(255,255,255,0.35);
    }
    .cc-btn.active {
        color: #818cf8;
        border-color: #818cf8;
    }

    .waiting-text {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        color: rgba(255,255,255,0.6);
        text-align: center;
        pointer-events: none;
        font-size: 18px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
    }

    .loading-spinner {
        width: 40px;
        height: 40px;
        border: 3px solid rgba(255,255,255,0.2);
        border-top-color: #6366f1;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @keyframes spin {
        to { transform: rotate(360deg); }
    }

    .waiting-message {
        font-size: 18px;
        color: rgba(255,255,255,0.8);
    }

    .waiting-hint {
        font-size: 13px;
        color: rgba(255,255,255,0.4);
    }

    .error-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.85);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 10;
    }

    .error-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
        padding: 24px;
        background: #1a1a24;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.1);
    }

    .error-icon {
        font-size: 48px;
    }

    .error-message {
        color: #ef4444;
        font-size: 16px;
        text-align: center;
    }

    .btn-retry {
        background: #6366f1;
        color: white;
        border: none;
        padding: 10px 24px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
    }

    .btn-retry:hover {
        background: #7c7ff7;
    }
</style>
