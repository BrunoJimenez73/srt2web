---
const pageTitle = "SRT2Web — Live Player";
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <div id="video-container">
        <video id="video-player" controls playsinline crossorigin="anonymous" muted>
        </video>
        <div id="waiting" class="waiting-text">
            <span class="loading-spinner"></span>
            <span class="waiting-message">Esperando stream...</span>
            <span class="waiting-hint">Inicia OBS y el pipeline para comenzar</span>
        </div>
        <div id="error-overlay" class="error-overlay" style="display: none;">
            <div class="error-content">
                <span class="error-icon">⚠️</span>
                <span class="error-message" id="error-message">Error de conexión</span>
                <button class="btn-retry" id="btn-retry">Reintentar</button>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/hls.js@1.5.1"></script>
    <script>
        import { initHlsPlayer } from '../lib/modules/player';
        initHlsPlayer();
    </script>
</body>
</html>

<style>
    :root {
        --bg-deep: #0a0a0f;
        --accent: #6366f1;
    }

    body, html {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        background-color: #000;
        overflow: hidden;
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: 'Inter', system-ui, sans-serif;
    }
    
    #video-container {
        width: 100%;
        height: 100%;
        position: relative;
    }

    #video-player {
        width: 100%;
        height: 100%;
        background-color: #000;
        object-fit: contain;
    }

    ::cue {
        background-color: rgba(0, 0, 0, 0.8) !important;
        color: #fff !important;
        font-family: 'Inter', system-ui, sans-serif;
        font-size: 1.2em !important;
        font-weight: 500;
        padding: 4px 8px;
    }
    
    video::-webkit-media-text-track-display {
        background-color: rgba(0, 0, 0, 0.8) !important;
    }

    .waiting-text {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        color: rgba(255,255,255,0.6);
        text-align: center;
        pointer-events: none;
        font-size: 18px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
    }

    .loading-spinner {
        width: 40px;
        height: 40px;
        border: 3px solid rgba(255,255,255,0.2);
        border-top-color: #6366f1;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @keyframes spin {
        to { transform: rotate(360deg); }
    }

    .waiting-message {
        font-size: 18px;
        color: rgba(255,255,255,0.8);
    }

    .waiting-hint {
        font-size: 13px;
        color: rgba(255,255,255,0.4);
    }

    .error-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.85);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 10;
    }

    .error-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
        padding: 24px;
        background: #1a1a24;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.1);
    }

    .error-icon {
        font-size: 48px;
    }

    .error-message {
        color: #ef4444;
        font-size: 16px;
        text-align: center;
    }

    .btn-retry {
        background: #6366f1;
        color: white;
        border: none;
        padding: 10px 24px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
    }

    .btn-retry:hover {
        background: #7c7ff7;
    }
</style>