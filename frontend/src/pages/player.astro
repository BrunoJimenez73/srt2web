---
const pageTitle = "SRT2Web — Live Player";
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <div id="video-container">
        <video id="video-player" controls autoplay playsinline crossorigin="anonymous"></video>
        <div id="waiting" class="waiting-text">Esperando stream...</div>
        <div id="error-overlay" class="error-overlay" style="display: none;">
            <div class="error-content">
                <span class="error-icon">⚠️</span>
                <span class="error-message" id="error-message">Error de conexión</span>
                <button class="btn-retry" id="btn-retry">Reintentar</button>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/hls.js@1.5.1"></script>
</body>
</html>

<style>
    :root {
        --bg-deep: #0a0a0f;
        --accent: #6366f1;
    }

    body, html {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        background-color: #000;
        overflow: hidden;
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: 'Inter', system-ui, sans-serif;
    }
    
    #video-container {
        width: 100%;
        height: 100%;
        position: relative;
    }

    #video-player {
        width: 100%;
        height: 100%;
        background-color: #000;
        object-fit: contain;
    }

    ::cue {
        background-color: rgba(0, 0, 0, 0.8) !important;
        color: #fff !important;
        font-family: 'Inter', system-ui, sans-serif;
        font-size: 1.2em !important;
        font-weight: 500;
        padding: 4px 8px;
    }
    
    video::-webkit-media-text-track-display {
        background-color: rgba(0, 0, 0, 0.8) !important;
    }

    .waiting-text {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        color: rgba(255,255,255,0.6);
        text-align: center;
        pointer-events: none;
        font-size: 18px;
    }

    .error-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.85);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 10;
    }

    .error-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
        padding: 24px;
        background: #1a1a24;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.1);
    }

    .error-icon {
        font-size: 48px;
    }

    .error-message {
        color: #ef4444;
        font-size: 16px;
        text-align: center;
    }

    .btn-retry {
        background: #6366f1;
        color: white;
        border: none;
        padding: 10px 24px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
    }

    .btn-retry:hover {
        background: #7c7ff7;
    }
</style>

    <script>
        declare const Hls: typeof import('hls.js');

        let hls: InstanceType<typeof Hls> | null = null;
        let userPreference: boolean | null = null;
        let subtitleTrackElement: HTMLTrackElement | null = null;
        let subtitleLanguageName = '';
        let lastVTTContent = '';

        const video = document.getElementById('video-player') as HTMLVideoElement;
        const waiting = document.getElementById('waiting') as HTMLDivElement;

        async function loadVTT(): Promise<void> {
            try {
                const response = await fetch(`/hls/subs.vtt?_=${Date.now()}`);
                if (!response.ok) return;

                const vttContent = await response.text();

                if (lastVTTContent === vttContent) return;
                lastVTTContent = vttContent;

                console.log('VTT content changed, updating track');

                const vttBlob = new Blob([vttContent], { type: 'text/vtt; charset=utf-8' });
                const vttUrl = URL.createObjectURL(vttBlob);

                if (subtitleTrackElement) {
                    const oldSrc = subtitleTrackElement.src;
                    subtitleTrackElement.src = vttUrl;

                    if (!document.contains(subtitleTrackElement)) {
                        video.appendChild(subtitleTrackElement);
                    }

                    if (oldSrc && oldSrc.startsWith('blob:')) {
                        URL.revokeObjectURL(oldSrc);
                    }
                } else {
                    subtitleTrackElement = document.createElement('track');
                    subtitleTrackElement.kind = 'subtitles';
                    subtitleTrackElement.label = subtitleLanguageName || 'Spanish';
                    subtitleTrackElement.srclang = 'es';
                    subtitleTrackElement.src = vttUrl;
                    subtitleTrackElement.default = true;

                    video.appendChild(subtitleTrackElement);

                    subtitleTrackElement.addEventListener('load', () => {
                        const shouldShow = userPreference !== null ? userPreference : true;

                        if (shouldShow) {
                            for (let i = 0; i < video.textTracks.length; i++) {
                                if (video.textTracks[i].kind === 'subtitles') {
                                    video.textTracks[i].mode = (i === 0) ? 'showing' : 'disabled';
                                }
                            }
                        }
                    });
                }

            } catch(e) {
                console.log('VTT load error:', e);
            }
        }

        setInterval(loadVTT, 5000);
        loadVTT();

        function initPlayer(): void {
            if (Hls.isSupported()) {
                hls = new Hls({
                    enableWorker: false,
                    lowLatencyMode: false,
                    backBufferLength: 90,
                    subtitlesEnabled: true,
                    manifestLoadingTimeOut: 20000,
                    manifestLoadingMaxRetry: 5,
                    manifestLoadingRetryDelay: 5000,
                    levelLoadingTimeOut: 20000,
                    levelLoadingMaxRetry: 5,
                    levelLoadingRetryDelay: 5000,
                });

                hls.loadSource('/hls/master.m3u8');
                hls.attachMedia(video);

                hls.on(Hls.Events.MANIFEST_PARSED, () => {
                    waiting.style.display = 'none';
                    video.play().catch(() => {});
                });

                const errorOverlay = document.getElementById('error-overlay') as HTMLDivElement;
                const errorMessage = document.getElementById('error-message') as HTMLSpanElement;
                const btnRetry = document.getElementById('btn-retry') as HTMLButtonElement;
                let errorCount = 0;

                function showError(message: string): void {
                    if (errorOverlay && errorMessage) {
                        errorMessage.textContent = message;
                        errorOverlay.style.display = 'flex';
                        waiting.style.display = 'none';
                    }
                }

                function hideError(): void {
                    if (errorOverlay) {
                        errorOverlay.style.display = 'none';
                    }
                }

                btnRetry?.addEventListener('click', () => {
                    hideError();
                    errorCount = 0;
                    hls?.startLoad();
                    video.play().catch(() => {});
                });

                hls.on(Hls.Events.ERROR, (_e, data) => {
                    console.log('HLS Error:', data.type, data.details);
                    
                    if (data.fatal) {
                        errorCount++;
                        
                        switch (data.type) {
                            case Hls.ErrorTypes.NETWORK_ERROR:
                                if (errorCount < 3) {
                                    hls?.startLoad();
                                } else {
                                    showError('No se puede conectar al stream. Verifique que el servidor esté en ejecución.');
                                }
                                break;
                            case Hls.ErrorTypes.MEDIA_ERROR:
                                hls?.recoverMediaError();
                                break;
                            case Hls.ErrorTypes.MANIFEST_LOAD_ERROR:
                                showError('No se pudo cargar el manifiesto del stream.');
                                break;
                            case Hls.ErrorTypes.MANIFEST_PARSE_ERROR:
                                showError('Error al解析 el stream.');
                                break;
                            default:
                                showError(`Error: ${data.details || data.type}`);
                        }
                    } else {
                        // Non-fatal errors - reset count on success
                        if (!data.fatal) {
                            errorCount = 0;
                        }
                    }
                });

                // Update subtitle language info when tracks are added
                hls.on(Hls.Events.SUBTITLE_TRACKS_UPDATED, (event, data) => {
                    console.log('Subtitle tracks updated:', data);
                    if (hls.subtitleTracks.length > 0) {
                        const firstTrack = hls.subtitleTracks[0];
                        if (firstTrack.name) {
                            subtitleLanguageName = firstTrack.name;
                            console.log('Subtitle language from tracks:', subtitleLanguageName);
                        }
                        // Update our manual track label
                        if (subtitleTrackElement) {
                            subtitleTrackElement.label = subtitleLanguageName;
                            console.log('Updated manual track label to:', subtitleLanguageName);
                        }
                    }
                });

                // Additional subtitle event listeners for robustness
                hls.on(Hls.Events.SUBTITLE_TRACK_SWITCH, (event, data) => {
                    console.log('Subtitle track switched:', data);
                });

                hls.on(Hls.Events.SUBTITLE_FRAG_PROCESSED, (event, data) => {
                    console.log('Subtitle fragment processed:', data);
                });

                // Keep one debug listener for SUBTITLE_TRACKS_UPDATED
                hls.on(Hls.Events.SUBTITLE_TRACKS_UPDATED, (event, data) => {
                    console.log('Subtitle tracks updated:', data);
                });

            } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
                video.src = '/hls/master.m3u8';
            }
        }

        function setupSubtitleChangeListener(): void {
            const setupTrackListeners = (): void => {
                for (let i = 0; i < video.textTracks.length; i++) {
                    const track = video.textTracks[i];
                    if (track.kind === 'subtitles') {
                        track.removeEventListener('modechange', handleModeChange);
                        track.addEventListener('modechange', handleModeChange);
                    }
                }
            };

            const handleModeChange = (event: Event): void => {
                const track = event.target as TextTrack;
                if (track.kind === 'subtitles') {
                    userPreference = track.mode === 'showing';
                }
            };

            if (video.textTracks.length > 0) {
                setupTrackListeners();
            } else {
                video.addEventListener('loadedmetadata', setupTrackListeners);
            }

            setInterval(setupTrackListeners, 10000);
        }

        document.addEventListener('DOMContentLoaded', () => {
            loadVTT();
            initPlayer();
            setupSubtitleChangeListener();

            setInterval(() => {
                if (!hls || hls.state === 'ERROR') {
                    initPlayer();
                }
            }, 10000);
        });
    </script>
