---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import StatusCard from '../components/StatusCard.astro';
import MetricsCard from '../components/MetricsCard.astro';
import ProcessGrid from '../components/ProcessGrid.astro';
import LogPanel from '../components/LogPanel.astro';
import Toast from '../components/Toast.astro';
---

<BaseLayout title="SRT2Web Dashboard">
  <div class="dashboard">
    <Header version="0.6.7" />
    <StatusCard />
    <MetricsCard />
    <ProcessGrid />
    <LogPanel />
  </div>
  <Toast />
  <script>
    import '../lib/dashboard.ts';
    import '../lib/modules/outputs.ts';
  </script>
  <script>
    (function() {
      function loadConfig() {
        fetch('/api/config').then(function(res) { return res.json(); }).then(function(cfg) {
          if (cfg.input && cfg.input.type) {
            var inputType = document.getElementById('input-type');
            if (inputType) inputType.value = cfg.input.type;
          }
          
          if (cfg.input && cfg.input.srt) {
            var srtPort = document.getElementById('input-srt-port');
            if (srtPort) srtPort.value = String(cfg.input.srt.listen_port || 9000);
            var srtMode = document.getElementById('input-srt-mode');
            if (srtMode) srtMode.value = cfg.input.srt.mode || 'listener';
            var srtLatency = document.getElementById('input-srt-latency');
            if (srtLatency) srtLatency.value = String(cfg.input.srt.latency_ms || 200);
          }
          
          if (cfg.pipeline && cfg.pipeline.chunk_duration_sec) {
            var chunkDuration = document.getElementById('input-chunk-duration');
            if (chunkDuration) chunkDuration.value = String(cfg.pipeline.chunk_duration_sec);
          }
          
          if (cfg.modules) {
            var m = cfg.modules;
            if (m.transcriber) {
              var we = document.getElementById('whisper-enabled');
              if (we) we.checked = m.transcriber.enabled !== false;
              var wm = document.getElementById('whisper-model');
              if (wm) wm.value = m.transcriber.model || 'tiny';
              var wl = document.getElementById('whisper-lang');
              if (wl) wl.value = m.transcriber.language || 'auto';
              var wd = document.getElementById('whisper-device');
              if (wd) wd.value = m.transcriber.device || 'auto';
            }
            if (m.translator) {
              var te = document.getElementById('translator-enabled');
              if (te) te.checked = m.translator.enabled !== false;
              var ts = document.getElementById('translator-source');
              if (ts) ts.value = m.translator.source_lang || 'auto';
              var tt = document.getElementById('translator-target');
              if (tt) tt.value = m.translator.target_lang || 'es';
            }
            if (m.tts_engine) {
              var ttsEng = document.getElementById('tts-engine');
              if (ttsEng) ttsEng.value = m.tts_engine.engine || 'edge-tts';
              var tv = document.getElementById('tts-voice-edge');
              if (tv) tv.value = m.tts_engine.voice || 'es-ES-AlvaroNeural';
              var ttsEn = document.getElementById('tts-enabled');
              if (ttsEn) ttsEn.checked = m.tts_engine.enabled !== false;
              var edgeGroup = document.getElementById('tts-voice-edge-group');
              var piperGroup = document.getElementById('tts-voice-piper-group');
              if (edgeGroup && piperGroup) {
                if (m.tts_engine.engine === 'piper') {
                  edgeGroup.style.display = 'none';
                  piperGroup.style.display = 'block';
                } else {
                  edgeGroup.style.display = 'block';
                  piperGroup.style.display = 'none';
                }
              }
            }
            if (m.subtitle_generator) {
              var se = document.getElementById('subtitle-enabled');
              if (se) se.checked = m.subtitle_generator.enabled !== false;
              var sf = document.getElementById('subtitle-format');
              if (sf) sf.value = m.subtitle_generator.format || 'vtt';
              var sut = document.getElementById('subtitle-use-trans');
              if (sut) sut.value = m.subtitle_generator.use_translated ? 'yes' : 'no';
            }
            if (m.audio_mixer) {
              var ame = document.getElementById('audio-mixer-enabled');
              if (ame) ame.checked = m.audio_mixer.enabled !== false;
              var aov = document.getElementById('audio-mixer-original-volume');
              if (aov) aov.value = String(m.audio_mixer.original_volume || 0.3);
              var adv = document.getElementById('audio-mixer-dubbed-volume');
              if (adv) adv.value = String(m.audio_mixer.dubbed_volume || 1.0);
              var aovv = document.getElementById('audio-mixer-original-value');
              if (aovv) aovv.textContent = String(m.audio_mixer.original_volume || 0.3);
              var advv = document.getElementById('audio-mixer-dubbed-value');
              if (advv) advv.textContent = String(m.audio_mixer.dubbed_volume || 1.0);
            }
            if (m.video_muxer) {
              var me = document.getElementById('muxer-enabled');
              if (me) me.checked = m.video_muxer.enabled !== false;
              var ve = document.getElementById('video-muxer-engine');
              if (ve) ve.value = m.video_muxer.engine || 'hls';
              var hs = document.getElementById('hls-segment-duration');
              if (hs) hs.value = String(m.video_muxer.hls_segment_duration || 4);
              var hl = document.getElementById('hls-list-size');
              if (hl) hl.value = String(m.video_muxer.hls_list_size || 6);
              var he = document.getElementById('hls-encoder');
              if (he) he.value = m.video_muxer.encoder_mode || 'auto';
            }
          }
          
          console.log('Config loaded from server');
        }).catch(function(e) { console.error('Config load failed:', e); });
      }
      
      function refreshMetrics() {
        fetch('/api/status').then(function(res) { return res.json(); }).then(function(status) {
          var s = status.system || {};
          var cpuEl = document.getElementById('metric-cpu-value');
          var cpuBar = document.getElementById('metric-cpu-bar');
          var memEl = document.getElementById('metric-memory-value');
          var memPercent = document.getElementById('metric-memory-percent');
          var memBar = document.getElementById('metric-memory-bar');
          var gpuEl = document.getElementById('metric-gpu-value');
          var gpuBar = document.getElementById('metric-gpu-bar');
          
          var cpuPct = s.cpu_percent || s.cpu_usage || 0;
          var memPct = s.memory_percent || s.memory_usage || 0;
          var gpuPct = s.gpu_usage || 0;
          
          if (cpuEl) cpuEl.textContent = cpuPct + '%';
          if (cpuBar) {
            cpuBar.style.width = cpuPct + '%';
            cpuBar.className = 'metric-bar';
            if (cpuPct < 50) cpuBar.classList.add('low');
            else if (cpuPct < 80) cpuBar.classList.add('medium');
            else cpuBar.classList.add('high');
          }
          if (memEl) memEl.textContent = (s.memory_mb || 0).toFixed(0) + ' MB';
          if (memPercent) memPercent.textContent = memPct + '%';
          if (memBar) {
            memBar.style.width = memPct + '%';
            memBar.className = 'metric-bar';
            if (memPct < 50) memBar.classList.add('low');
            else if (memPct < 80) memBar.classList.add('medium');
            else memBar.classList.add('high');
          }
          if (gpuEl) gpuEl.textContent = gpuPct + '%';
          if (gpuBar) {
            gpuBar.style.width = gpuPct + '%';
            gpuBar.className = 'metric-bar';
            if (gpuPct < 50) gpuBar.classList.add('low');
            else if (gpuPct < 80) gpuBar.classList.add('medium');
            else gpuBar.classList.add('high');
          }
        }).catch(function(e) { console.error('Metrics refresh failed:', e); });
      }
      
      function refreshStatus() {
        fetch('/api/status').then(function(res) { return res.json(); }).then(function(status) {
          var state = status.state || 'idle';
          var dot = document.getElementById('status-dot');
          var text = document.getElementById('status-text');
          var btnStart = document.getElementById('btn-start');
          var btnStop = document.getElementById('btn-stop');
          var isRunning = state === 'running';
          
          if (dot) {
            dot.classList.remove('running', 'error');
            if (isRunning) dot.classList.add('running');
            if (state === 'error') dot.classList.add('error');
          }
          if (text) text.textContent = isRunning ? 'ACTIVO' : (state === 'stopping' ? 'DETENIENDO' : 'APAGADO');
          if (btnStart) {
            btnStart.disabled = isRunning;
            btnStart.style.opacity = isRunning ? '0.5' : '1';
          }
          if (btnStop) {
            btnStop.disabled = !isRunning;
            btnStop.style.opacity = isRunning ? '1' : '0.5';
          }
        }).catch(function(e) { console.error('Status refresh failed:', e); });
      }
      
      function refreshUrls() {
        fetch('/api/status').then(function(res) { return res.json(); }).then(function(status) {
          var net = status.network || {};
          var emision = document.getElementById('url-emision');
          var stream = document.getElementById('url-stream');
          var player = document.getElementById('url-player');
          var mode = window.currentMode || 'local';
          var port = net.port || 9999;
          var srtPort = net.srt_port || 9000;
          
          var srtUrl = mode === 'local' ? 'srt://127.0.0.1:' + srtPort + '?mode=listener' : (net.srt_url_listener || 'srt://127.0.0.1:' + srtPort + '?mode=listener');
          var streamUrl = mode === 'local' ? 'http://127.0.0.1:' + port + '/hls/stream.m3u8' : (net.stream_url || 'http://127.0.0.1:' + port + '/hls/stream.m3u8');
          var playerUrl = mode === 'local' ? 'http://127.0.0.1:' + port + '/player' : (net.player_url || 'http://127.0.0.1:' + port + '/player');
          
          if (emision) emision.textContent = srtUrl;
          if (stream) stream.textContent = streamUrl;
          if (player) {
            player.textContent = playerUrl;
            player.href = playerUrl;
          }
        }).catch(function(e) { console.error('URLs refresh failed:', e); });
      }
      
      window.handleTtsEngineChange = function(engine) {
        var edgeGroup = document.getElementById('tts-voice-edge-group');
        var piperGroup = document.getElementById('tts-voice-piper-group');
        if (edgeGroup && piperGroup) {
          if (engine === 'piper') {
            edgeGroup.style.display = 'none';
            piperGroup.style.display = 'block';
          } else {
            edgeGroup.style.display = 'block';
            piperGroup.style.display = 'none';
          }
        }
      };
      
      window.saveConfig = function() {
        var getVal = function(id, def) {
          var el = document.getElementById(id);
          return el ? el.value : def;
        };
        var getCheck = function(id, def) {
          var el = document.getElementById(id);
          return el ? el.checked : def;
        };
        
        var config = {
          input: {
            type: getVal('input-type', 'srt'),
            srt: {
              listen_port: parseInt(getVal('input-srt-port', '9000')),
              mode: getVal('input-srt-mode', 'listener'),
              latency_ms: parseInt(getVal('input-srt-latency', '200'))
            }
          },
          pipeline: {
            chunk_duration_sec: parseInt(getVal('input-chunk-duration', '5'))
          },
          modules: {
            transcriber: {
              enabled: getCheck('whisper-enabled', true),
              model: getVal('whisper-model', 'tiny'),
              language: getVal('whisper-lang', 'auto'),
              device: getVal('whisper-device', 'auto')
            },
            translator: {
              enabled: getCheck('translator-enabled', true),
              source_lang: getVal('translator-source', 'auto'),
              target_lang: getVal('translator-target', 'es')
            },
            tts_engine: {
              enabled: getCheck('tts-enabled', true),
              engine: getVal('tts-engine', 'edge-tts'),
              voice: getVal('tts-voice-edge', 'es-ES-AlvaroNeural'),
              speed: parseFloat(getVal('tts-speed', '1.0'))
            },
            subtitle_generator: {
              enabled: getCheck('subtitle-enabled', false),
              format: getVal('subtitle-format', 'vtt'),
              use_translated: getVal('subtitle-use-trans', 'yes') === 'yes'
            },
            audio_mixer: {
              enabled: getCheck('audio-mixer-enabled', true),
              original_volume: parseFloat(getVal('audio-mixer-original-volume', '0.3')),
              dubbed_volume: parseFloat(getVal('audio-mixer-dubbed-volume', '1.0'))
            },
            video_muxer: {
              enabled: getCheck('muxer-enabled', true),
              engine: getVal('video-muxer-engine', 'hls'),
              hls_segment_duration: parseInt(getVal('hls-segment-duration', '4')),
              hls_list_size: parseInt(getVal('hls-list-size', '6')),
              encoder_mode: getVal('hls-encoder', 'auto')
            }
          }
        };
        
        fetch('/api/config', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(config)
        }).then(function(res) { return res.json(); }).then(function(data) {
          console.log('Config saved:', data);
          alert('Configuración guardada');
          loadConfig();
        }).catch(function(e) { 
          console.error('Save failed:', e);
          alert('Error al guardar config');
        });
      };
      
      function initModeButtons() {
        document.getElementById('btn-mode-local').addEventListener('click', function() {
          window.currentMode = 'local';
          localStorage.setItem('srt2web_mode', 'local');
          this.classList.add('active');
          document.getElementById('btn-mode-remote').classList.remove('active');
          refreshUrls();
        });
        document.getElementById('btn-mode-remote').addEventListener('click', function() {
          window.currentMode = 'remote';
          localStorage.setItem('srt2web_mode', 'remote');
          this.classList.add('active');
          document.getElementById('btn-mode-local').classList.remove('active');
          refreshUrls();
        });
        
        var savedMode = localStorage.getItem('srt2web_mode');
        if (savedMode === 'remote') {
          document.getElementById('btn-mode-remote').classList.add('active');
          document.getElementById('btn-mode-local').classList.remove('active');
          window.currentMode = 'remote';
        } else {
          document.getElementById('btn-mode-local').classList.add('active');
          window.currentMode = 'local';
        }

        var ttsEngineSel = document.getElementById('tts-engine');
        if (ttsEngineSel) {
          ttsEngineSel.addEventListener('change', function() {
            var eng = this.value;
            var edgeGroup = document.getElementById('tts-voice-edge-group');
            var piperGroup = document.getElementById('tts-voice-piper-group');
            if (edgeGroup && piperGroup) {
              if (eng === 'piper') {
                edgeGroup.style.display = 'none';
                piperGroup.style.display = 'block';
              } else {
                edgeGroup.style.display = 'block';
                piperGroup.style.display = 'none';
              }
            }
          });
        }
      }
      
      function updateClock() {
        var now = new Date();
        var h = String(now.getHours()).padStart(2, '0');
        var m = String(now.getMinutes()).padStart(2, '0');
        var s = String(now.getSeconds()).padStart(2, '0');
        var clock = document.getElementById('live-clock');
        if (clock) clock.textContent = h + ':' + m + ':' + s;
      }
      
      setTimeout(function() {
        initModeButtons();
        connectLogsWebSocket();
        loadConfig();
        refreshMetrics();
        refreshStatus();
        refreshUrls();
        refreshModuleStatus();
        updateClock();
      }, 500);
      
      var logsWs = null;
      function connectLogsWebSocket() {
        var protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
        var host = window.location.host;
        var wsUrl = protocol + '//' + host + '/ws/logs';
        var token = localStorage.getItem('srt2web_auth_token');
        if (token) wsUrl += '?token=' + encodeURIComponent(token);
        console.log('Connecting to logs WebSocket:', wsUrl);
        logsWs = new WebSocket(wsUrl);
        logsWs.onmessage = function(evt) {
          try {
            var data = JSON.parse(evt.data);
            if (data.message && data.level) {
              window.addLogEntry(data.level, data.message, data.timestamp || '');
            }
          } catch(e) {}
        };
        logsWs.onerror = function(e) { console.error('Logs WS error:', e); };
        logsWs.onclose = function() {
          console.log('Logs WS closed, reconnecting...');
          setTimeout(connectLogsWebSocket, 3000);
        };
      }
      
      setInterval(function() {
        refreshMetrics();
        refreshStatus();
        refreshUrls();
        refreshModuleStatus();
      }, 2000);
      
      function refreshModuleStatus() {
        fetch('/api/status').then(function(res) { return res.json(); }).then(function(status) {
          if (!status.modules) return;
          var mods = status.modules;
          var moduleMap = {
            'audio_extractor': { be: 'audio_extractor', ind: 'indicator-input', time: 'module-time-input', chunks: 'module-chunks-input' },
            'transcriber': { be: 'transcriber', ind: 'indicator-whisper', time: 'module-time-transcriber', chunks: 'module-chunks-transcriber' },
            'translator': { be: 'translator', ind: 'indicator-translate', time: 'module-time-translator', chunks: 'module-chunks-translator' },
            'tts_engine': { be: 'tts_engine', ind: 'indicator-tts', time: 'module-time-tts_engine', chunks: 'module-chunks-tts_engine' },
            'subtitle_generator': { be: 'subtitle_generator', ind: 'indicator-subtitle', time: 'module-time-subtitle_generator', chunks: 'module-chunks-subtitle_generator' },
            'audio_mixer': { be: 'audio_mixer', ind: 'indicator-audio-mixer', time: 'module-time-audio_mixer', chunks: 'module-chunks-audio_mixer' },
            'video_muxer': { be: 'output', ind: 'indicator-video-muxer', time: 'module-time-video_muxer', chunks: 'module-chunks-video_muxer' },
            'output': { be: 'output', ind: 'indicator-output', time: 'module-time-output', chunks: 'module-chunks-output' }
          };
          Object.keys(moduleMap).forEach(function(key) {
            var info = moduleMap[key];
            var modStatus = null;
            for (var i = 0; i < mods.length; i++) {
              if (mods[i].name === info.be) {
                modStatus = mods[i];
                break;
              }
            }
            if (!modStatus) return;
            var ind = document.getElementById(info.ind);
            if (ind) {
              ind.classList.remove('active', 'error');
              if (modStatus.state === 'running') ind.classList.add('active');
              else if (modStatus.state === 'error') ind.classList.add('error');
            }
            var timeEl = document.getElementById(info.time);
            if (timeEl && modStatus.last_process_time_ms !== undefined) {
              timeEl.textContent = modStatus.last_process_time_ms < 1000 ? Math.round(modStatus.last_process_time_ms) + 'ms' : (modStatus.last_process_time_ms/1000).toFixed(1) + 's';
            }
            var chunksEl = document.getElementById(info.chunks);
            if (chunksEl && modStatus.processed_chunks !== undefined) {
              chunksEl.textContent = String(modStatus.processed_chunks);
            }
            var deviceEl = document.getElementById('module-device-' + key);
            if (deviceEl && modStatus.extra && modStatus.extra.device) {
              deviceEl.textContent = modStatus.extra.device.toUpperCase();
            }
            var encoderEl = document.getElementById('module-encoder-' + key);
            if (encoderEl && modStatus.extra && modStatus.extra.encoder_mode) {
              encoderEl.textContent = modStatus.extra.encoder_mode.toUpperCase();
            }
          });
        }).catch(function() {});
      }
      
      setInterval(updateClock, 1000);
    })();
  </script>
</BaseLayout>

<style>
  .dashboard {
    max-width: 1200px;
    margin: 0 auto;
    padding: 16px;
    min-height: calc(100vh - 32px);
  }
</style>