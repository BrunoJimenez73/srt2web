---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatusCard from '../components/StatusCard.astro';
import ProcessCard from '../components/ProcessCard.astro';
---

<BaseLayout title="SRT2Web — Dashboard v0.4">
    <div class="dashboard">
        <!-- Header -->
        <header class="header">
            <div class="logo">
                <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="2" y="8" width="28" height="16" rx="2" fill="#6366f1"/>
                    <path d="M8 12h4v8H8z" fill="white"/>
                    <path d="M14 12h4v8h-4z" fill="white" opacity="0.7"/>
                    <path d="M20 12h4v8h-4z" fill="white" opacity="0.4"/>
                    <circle cx="26" cy="24" r="4" fill="#10b981"/>
                    <path d="M24.5 24l1 1 2-2" stroke="white" stroke-width="1.5"/>
                </svg>
                <span class="logo-text">SRT2Web</span>
                <span class="version-badge">v0.4</span>
            </div>
            <div class="header-info">
                <span id="version-info">Pipeline Modular</span>
            </div>
        </header>

        <!-- Status -->
        <StatusCard id="status" />

        <!-- Process Grid -->
        <section class="process-grid">
            <!-- INPUT -->
            <ProcessCard id="input" icon="📥" title="INPUT">
                <div class="form-group">
                    <label class="form-label">Tipo</label>
                    <select class="form-select" id="input-type">
                        <option value="srt">SRT</option>
                        <option value="file">Archivo</option>
                    </select>
                </div>
                <div class="form-group" id="input-port-group">
                    <label class="form-label">Puerto</label>
                    <input type="number" class="form-input" id="input-port" value="9000" />
                </div>
                <div class="form-group" id="input-latency-group">
                    <label class="form-label">Latencia (ms)</label>
                    <input type="number" class="form-input" id="input-latency" value="1000" />
                </div>
            </ProcessCard>

            <!-- TRADUCIR -->
            <ProcessCard id="translate" icon="🌐" title="TRADUCIR" hasToggle={true}>
                <div class="form-group">
                    <label class="form-label">Origen</label>
                    <select class="form-select" id="translate-source">
                        <option value="auto">Auto (Detectar)</option>
                        <option value="es">Español</option>
                        <option value="en" selected>Inglés</option>
                        <option value="fr">Francés</option>
                        <option value="de">Alemán</option>
                        <option value="it">Italiano</option>
                        <option value="pt">Portugués</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Destino</label>
                    <select class="form-select" id="translate-target">
                        <option value="es" selected>Español</option>
                        <option value="en">Inglés</option>
                        <option value="fr">Francés</option>
                        <option value="de">Alemán</option>
                        <option value="it">Italiano</option>
                        <option value="pt">Portugués</option>
                    </select>
                </div>
            </ProcessCard>

            <!-- DOBLAR -->
            <ProcessCard id="dub" icon="🗣" title="DOBLAR" hasToggle={true}>
                <div class="form-group">
                    <label class="form-label">Voz</label>
                    <select class="form-select" id="dub-voice">
                        <option value="es-ES-AlvaroNeural">ES - Álvaro</option>
                        <option value="es-ES-ElviraNeural">ES - Elvira</option>
                        <option value="en-US-AriaNeural">EN - Aria</option>
                        <option value="en-US-GuyNeural">EN - Guy</option>
                        <option value="fr-FR-DeniseNeural">FR - Denise</option>
                        <option value="it-IT-ElsaNeural">IT - Elsa</option>
                        <option value="de-DE-KatjaNeural">DE - Katja</option>
                        <option value="pt-BR-FranciscaNeural">PT - Francisca</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Velocidad</label>
                    <input type="number" class="form-input" id="dub-speed" value="1.0" step="0.1" min="0.5" max="2.0" />
                </div>
            </ProcessCard>

            <!-- SUBTITULAR -->
            <ProcessCard id="subtitle" icon="📝" title="SUBTITULAR" hasToggle={true}>
                <div class="form-group">
                    <label class="form-label">Formato</label>
                    <select class="form-select" id="subtitle-format">
                        <option value="srt">SRT</option>
                        <option value="webvtt" selected>WebVTT</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Usar trad.</label>
                    <select class="form-select" id="subtitle-use-translated">
                        <option value="true" selected>Sí</option>
                        <option value="false">No</option>
                    </select>
                </div>
            </ProcessCard>

            <!-- OUTPUT -->
            <ProcessCard id="output" icon="📤" title="OUTPUT">
                <div class="form-group">
                    <label class="form-label">Tipo</label>
                    <select class="form-select" id="output-type">
                        <option value="web">Web (HLS)</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Segmento (s)</label>
                    <input type="number" class="form-input" id="output-segment" value="15" />
                </div>
            </ProcessCard>
        </section>

        <!-- Connection Panel -->
        <section class="connection-section" id="connection-section">
            <div class="connection-card">
                <div class="connection-mode-header">
                    <span class="connection-mode-title">📡 Conexión SRT</span>
                    <div class="mode-selector">
                        <button class="mode-btn active" data-mode="local" id="btn-mode-local">🏠 LOCAL</button>
                        <button class="mode-btn" data-mode="remote" id="btn-mode-remote">🌐 REMOTE</button>
                    </div>
                </div>
                
                <!-- Remote Config (shown only in remote mode) -->
                <div class="remote-config" id="remote-config" style="display: none;">
                    <div class="form-group">
                        <label class="form-label">Emisor SRT Address</label>
                        <input type="text" class="form-input" id="emitter-address" placeholder="203.0.113.xx" />
                    </div>
                </div>
                
                <!-- IP Info -->
                <div class="ip-info">
                    <div class="ip-row">
                        <span class="ip-label">Local:</span>
                        <code class="ip-value" id="local-ip">Detectando...</code>
                    </div>
                    <div class="ip-row">
                        <span class="ip-label">Public:</span>
                        <code class="ip-value" id="public-ip">Detectando...</code>
                        <span class="ip-warning" id="public-ip-warning" style="display: none;">⚠️</span>
                    </div>
                </div>
                
                <!-- Connection URLs -->
                <div class="connection-urls">
                    <div class="url-row">
                        <span class="url-label">SRT:</span>
                        <code class="url-value" id="url-srt">srt://...</code>
                        <button class="btn-copy-small" id="btn-copy-srt">📋</button>
                    </div>
                    <div class="url-row">
                        <span class="url-label">Stream:</span>
                        <code class="url-value" id="url-stream">http://...</code>
                        <button class="btn-copy-small" id="btn-copy-stream">📋</button>
                    </div>
                    <div class="url-row">
                        <span class="url-label">Player:</span>
                        <code class="url-value" id="url-player">http://...</code>
                        <button class="btn-copy-small" id="btn-copy-player">📋</button>
                    </div>
                </div>
                
                <!-- Warning for no public IP -->
                <div class="connection-warning" id="connection-warning" style="display: none;">
                    ⚠️ No se detectó IP pública. Usando IP local. El emisor debe estar en la misma red.
                </div>
            </div>
        </section>

        <!-- Advanced Section -->
        <section class="advanced-section" id="advanced-section">
            <div class="advanced-header" id="advanced-header">
                <span class="advanced-title">⚙️ CONFIGURACIÓN AVANZADA</span>
                <span class="advanced-toggle-icon" id="advanced-icon">▼</span>
            </div>
            <div class="advanced-body">
                <div class="modules-grid">
                    <!-- Whisper -->
                    <div class="module-card" id="mod-transcriber">
                        <div class="module-header">
                            <span class="module-name">
                                <span class="status-dot" id="status-transcriber"></span>
                                🎙 Whisper
                            </span>
                            <label class="toggle-switch">
                                <input type="checkbox" id="adv-whisper-enabled" checked />
                                <span class="toggle-slider"></span>
                            </label>
                        </div>
                        <div class="module-settings">
                            <div class="form-group">
                                <label class="form-label">Modelo</label>
                                <select class="form-select" id="adv-model">
                                    <option value="tiny">tiny</option>
                                    <option value="small">small</option>
                                    <option value="medium">medium</option>
                                    <option value="large-v2">large-v2</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Idioma</label>
                                <select class="form-select" id="adv-lang">
                                    <option value="auto">Auto</option>
                                    <option value="es">Español</option>
                                    <option value="en">Inglés</option>
                                    <option value="fr">Francés</option>
                                    <option value="de">Alemán</option>
                                    <option value="it">Italiano</option>
                                    <option value="pt">Portugués</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Device</label>
                                <select class="form-select" id="adv-device">
                                    <option value="auto">Auto</option>
                                    <option value="cuda">GPU</option>
                                    <option value="cpu">CPU</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- HLS Output -->
                    <div class="module-card" id="mod-video_muxer">
                        <div class="module-header">
                            <span class="module-name">
                                <span class="status-dot" id="status-video_muxer"></span>
                                📦 HLS Output
                            </span>
                            <label class="toggle-switch">
                                <input type="checkbox" id="adv-muxer-enabled" checked />
                                <span class="toggle-slider"></span>
                            </label>
                        </div>
                        <div class="module-settings">
                            <div class="form-group">
                                <label class="form-label">Segmento (s)</label>
                                <input type="number" class="form-input" id="adv-seg" value="15" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Lista</label>
                                <input type="number" class="form-input" id="adv-list" value="6" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Offset audio (ms)</label>
                                <input type="number" class="form-input" id="adv-offset" value="0" />
                            </div>
                        </div>
                    </div>
                </div>
                <button class="btn-start" style="margin-top:12px;width:100%;" id="btn-save-config">
                    💾 Guardar Configuración
                </button>
            </div>
        </section>

        <!-- Logs -->
        <section class="logs-section">
            <div class="logs-header">
                <span>📜 Logs</span>
                <button id="btn-clear-logs">🗑 Limpiar</button>
            </div>
            <div class="logs-container" id="logs-container"></div>
        </section>
    </div>

    <!-- Toast -->
    <div class="toast-container" id="toast-container"></div>
</BaseLayout>

<style>
    .dashboard {
        max-width: 1200px;
        margin: 0 auto;
        padding: 16px;
        min-height: calc(100vh - 32px);
    }

    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--border-dim);
    }

    .logo {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .logo svg { width: 32px; height: 32px; }

    .logo-text {
        font-size: 18px;
        font-weight: 700;
        background: linear-gradient(135deg, #6366f1, #a855f7);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .version-badge {
        background: var(--bg-card);
        padding: 2px 8px;
        border-radius: 10px;
        font-size: 11px;
        color: var(--text-sec);
        border: 1px solid var(--border-dim);
    }

    .header-info {
        font-size: 12px;
        color: var(--text-sec);
    }

    .process-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 10px;
        margin-bottom: 16px;
    }

    @media (max-width: 1000px) {
        .process-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @media (max-width: 600px) {
        .process-grid {
            grid-template-columns: 1fr;
        }
    }

    .urls-section {
        background: var(--bg-card);
        border: 1px solid var(--border-dim);
        border-radius: var(--radius-md);
        padding: 12px;
        margin-bottom: 16px;
    }

    .urls-section h3 {
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .urls-grid {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .url-card {
        display: flex;
        align-items: center;
        gap: 8px;
        background: var(--bg-surface);
        padding: 8px;
        border-radius: var(--radius-sm);
    }

    .url-label {
        font-size: 10px;
        color: var(--text-sec);
        min-width: 80px;
    }

    .url-value {
        flex: 1;
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        color: var(--accent);
        text-decoration: none;
    }
    
    .url-value:hover {
        text-decoration: underline;
        cursor: pointer;
    }

    .copy-btn {
        background: none;
        border: none;
        cursor: pointer;
        padding: 4px;
        font-size: 14px;
    }

    /* Connection Section */
    .connection-section {
        margin-bottom: 16px;
    }

    .connection-card {
        background: var(--bg-card);
        border: 1px solid var(--border-dim);
        border-radius: var(--radius-md);
        padding: 12px;
    }

    .connection-mode-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

    .connection-mode-title {
        font-size: 12px;
        font-weight: 600;
    }

    .mode-selector {
        display: flex;
        gap: 4px;
    }

    .mode-btn {
        background: var(--bg-surface);
        border: 1px solid var(--border-dim);
        border-radius: var(--radius-sm);
        padding: 6px 12px;
        font-size: 10px;
        color: var(--text-sec);
        cursor: pointer;
        transition: all 0.2s;
    }

    .mode-btn:hover {
        border-color: var(--accent);
    }

    .mode-btn.active {
        background: var(--accent);
        border-color: var(--accent);
        color: white;
    }

    .remote-config {
        margin-bottom: 12px;
        padding: 8px;
        background: var(--bg-surface);
        border-radius: var(--radius-sm);
    }

    .ip-info {
        display: flex;
        flex-direction: column;
        gap: 4px;
        margin-bottom: 12px;
    }

    .ip-row {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .ip-label {
        font-size: 10px;
        color: var(--text-sec);
        min-width: 50px;
    }

    .ip-value {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        color: var(--accent);
        background: var(--bg-surface);
        padding: 2px 6px;
        border-radius: 3px;
    }

    .ip-warning {
        font-size: 12px;
    }

    .connection-urls {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .url-row {
        display: flex;
        align-items: center;
        gap: 8px;
        background: var(--bg-surface);
        padding: 6px 8px;
        border-radius: var(--radius-sm);
    }

    .url-row .url-label {
        font-size: 10px;
        color: var(--text-sec);
        min-width: 45px;
    }

    .url-row .url-value {
        flex: 1;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        color: var(--text-prime);
    }

    .btn-copy-small {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 12px;
        padding: 2px 4px;
    }

    .btn-copy-small:hover {
        opacity: 0.7;
    }

    .connection-warning {
        margin-top: 10px;
        padding: 8px;
        background: rgba(245, 158, 11, 0.1);
        border: 1px solid var(--warning);
        border-radius: var(--radius-sm);
        font-size: 10px;
        color: var(--warning);
    }

    .advanced-section {
        margin-top: 16px;
    }

    .advanced-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 12px;
        background: var(--bg-card);
        border: 1px solid var(--border-dim);
        border-radius: var(--radius-md) var(--radius-md) 0 0;
        cursor: pointer;
    }

    .advanced-header:hover {
        background: var(--bg-card-hover);
    }

    .advanced-title {
        font-size: 12px;
        font-weight: 600;
    }

    .advanced-toggle-icon {
        transition: transform 0.3s;
    }

    .advanced-body {
        background: var(--bg-card);
        border: 1px solid var(--border-dim);
        border-top: none;
        border-radius: 0 0 var(--radius-md) var(--radius-md);
        padding: 12px;
        display: none;
    }

    .advanced-section.expanded .advanced-body {
        display: block;
    }

    .advanced-section.expanded .advanced-toggle-icon {
        transform: rotate(180deg);
    }

    .modules-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
    }

    @media (max-width: 600px) {
        .modules-grid {
            grid-template-columns: 1fr;
        }
    }

    .module-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-dim);
        border-radius: var(--radius-sm);
        padding: 10px;
    }

    .module-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }

    .module-name {
        font-size: 11px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--text-dim);
    }

    .status-dot.running {
        background: #00ff00;
        box-shadow: 0 0 6px #00ff00;
    }

    .module-settings {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .toggle-switch {
        position: relative;
        display: inline-block;
        width: 36px;
        height: 20px;
    }

    .toggle-switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .toggle-slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: var(--text-dim);
        transition: 0.3s;
        border-radius: 20px;
    }

    .toggle-slider:before {
        position: absolute;
        content: "";
        height: 14px;
        width: 14px;
        left: 3px;
        bottom: 3px;
        background-color: white;
        transition: 0.3s;
        border-radius: 50%;
    }

    input:checked + .toggle-slider {
        background-color: var(--success);
    }

    input:checked + .toggle-slider:before {
        transform: translateX(16px);
    }

    .form-group {
        margin-bottom: 4px;
    }

    .form-label {
        display: block;
        font-size: 9px;
        color: var(--text-sec);
        margin-bottom: 2px;
    }

    .form-input, .form-select {
        width: 100%;
        padding: 6px 8px;
        background: var(--bg-surface);
        border: 1px solid var(--border-dim);
        border-radius: var(--radius-sm);
        color: var(--text-prime);
        font-size: 11px;
    }

    .logs-section {
        background: var(--bg-card);
        border: 1px solid var(--border-dim);
        border-radius: var(--radius-md);
        margin-top: 16px;
    }

    .logs-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 12px;
        border-bottom: 1px solid var(--border-dim);
    }

    .logs-header span {
        font-size: 12px;
        font-weight: 600;
    }

    .logs-header button {
        background: none;
        border: none;
        color: var(--text-sec);
        cursor: pointer;
        font-size: 11px;
    }

    .logs-container {
        height: 150px;
        overflow-y: auto;
        padding: 8px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        color: var(--text-sec);
    }

    .log-entry {
        padding: 2px 0;
    }

    .log-entry.info { color: var(--text-prime); }
    .log-entry.warn { color: var(--warning); }
    .log-entry.error { color: var(--error); }

    .btn-start {
        background: var(--success);
        color: white;
        border: none;
        padding: 10px 16px;
        border-radius: var(--radius-sm);
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-start:hover {
        background: #0ea571;
    }

    .toast-container {
        position: fixed;
        bottom: 20px;
        right: 20px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .toast {
        padding: 10px 16px;
        border-radius: var(--radius-sm);
        font-size: 12px;
        animation: slideIn 0.3s ease;
    }

    .toast.success { background: var(--success); color: white; }
    .toast.error { background: var(--error); color: white; }
    .toast.warning { background: var(--warning); color: black; }
    .toast.info { background: var(--accent); color: white; }

    @keyframes slideIn {
        from { transform: translateX(100%); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
    }
</style>

<script>
    // State
    let config = {};
    let ws = null;
    let wsReconnectCount = 0;
    let statusPollInterval = null;
    let networkInfo = null;
    let connectionMode = 'local';

    // API calls
    async function apiCall(method, path, body = null) {
        const options = { method, headers: { 'Content-Type': 'application/json' } };
        if (body) options.body = JSON.stringify(body);
        const res = await fetch(path, options);
        if (!res.ok) throw new Error(await res.text());
        return res.json();
    }

    // Network info
    async function loadNetworkInfo() {
        try {
            const response = await apiCall('GET', '/api/network/info');
            networkInfo = response;
            updateNetworkDisplay();
            updateConnectionUrls();
        } catch (e) {
            console.warn('Could not load network info:', e);
            networkInfo = {
                local_ip: '127.0.0.1',
                public_ip: null,
                srt_port: 9000,
                server_port: 9999
            };
            updateNetworkDisplay();
            updateConnectionUrls();
        }
    }

    function updateNetworkDisplay() {
        if (!networkInfo) return;
        
        document.getElementById('local-ip').textContent = networkInfo.local_ip || 'N/A';
        
        const publicIpEl = document.getElementById('public-ip');
        const warningEl = document.getElementById('public-ip-warning');
        const warningBox = document.getElementById('connection-warning');
        
        if (networkInfo.public_ip) {
            publicIpEl.textContent = networkInfo.public_ip;
            warningEl.style.display = 'none';
            warningBox.style.display = 'none';
        } else {
            publicIpEl.textContent = 'No detectada';
            warningEl.style.display = 'inline';
            warningBox.style.display = 'block';
        }
    }

    function setConnectionMode(mode) {
        connectionMode = mode;
        
        document.getElementById('btn-mode-local').classList.toggle('active', mode === 'local');
        document.getElementById('btn-mode-remote').classList.toggle('active', mode === 'remote');
        
        const remoteConfig = document.getElementById('remote-config');
        if (mode === 'remote') {
            remoteConfig.style.display = 'block';
        } else {
            remoteConfig.style.display = 'none';
        }
        
        updateConnectionUrls();
    }

    function updateConnectionUrls() {
        if (!networkInfo) return;
        
        const srtPort = document.getElementById('input-port')?.value || networkInfo.srt_port || 9000;
        const latency = document.getElementById('input-latency')?.value || 1000;
        const latencyUs = latency * 1000;
        
        if (connectionMode === 'local') {
            const ip = networkInfo.public_ip || networkInfo.local_ip;
            document.getElementById('url-srt').textContent = 
                `srt://${ip}:${srtPort}?mode=listener&latency=${latencyUs}`;
        } else {
            const emitterIp = document.getElementById('emitter-address')?.value;
            if (emitterIp && emitterIp.trim()) {
                document.getElementById('url-srt').textContent = 
                    `srt://${emitterIp}:${srtPort}?mode=caller&latency=${latencyUs}`;
            } else {
                document.getElementById('url-srt').textContent = 
                    `srt://EMITTER_IP:${srtPort}?mode=caller&latency=${latencyUs}`;
            }
        }
        
        const ip = networkInfo.public_ip || networkInfo.local_ip;
        const serverPort = networkInfo.server_port || 9999;
        document.getElementById('url-stream').textContent = 
            `http://${ip}:${serverPort}/hls/stream.m3u8`;
        document.getElementById('url-player').textContent = 
            `http://${ip}:${serverPort}/player`;
    }

    // WebSocket connection
    function connectWebSocket() {
        try {
            ws = new WebSocket(`ws://${window.location.host}/ws/logs`);
            
            ws.onopen = () => {
                wsReconnectCount = 0;
                addLog('info', 'WebSocket conectado');
            };
            
            ws.onmessage = (event) => {
                try {
                    const data = JSON.parse(event.data);
                    if (data.type === 'log') {
                        addLog(data.level, data.message);
                    } else if (data.type === 'status') {
                        updateModuleStatus(data);
                    }
                } catch (e) {}
            };
            
            ws.onclose = () => {
                if (wsReconnectCount <= 3) {
                    addLog('warn', 'WebSocket desconectado, reconectando...');
                }
                setTimeout(connectWebSocket, 2000);
            };
            
            ws.onerror = () => {
                addLog('error', 'Error WebSocket');
            };
        } catch (e) {
            setTimeout(connectWebSocket, 3000);
        }
    }

    function updateModuleStatus(data) {
        const modules = data.modules || [];
        const pipelineState = data.state || 'idle';
        
        const moduleToCard = {
            'tts_engine': 'card-dub',
            'audio_mixer': 'card-dub',
            'translator': 'card-translate',
            'subtitle_generator': 'card-subtitle',
            'transcriber': 'card-input',
            'audio_extractor': 'card-input'
        };
        
        const moduleToIndicator = {
            'tts_engine': 'indicator-dub',
            'audio_mixer': 'indicator-dub',
            'translator': 'indicator-translate',
            'subtitle_generator': 'indicator-subtitle',
            'transcriber': null,
            'audio_extractor': null
        };
        
        modules.forEach(mod => {
            const statusDot = document.getElementById(`status-${mod.name}`);
            if (statusDot) {
                statusDot.classList.remove('running', 'error', 'disabled');
                if (!mod.enabled || mod.state === 'disabled') {
                    statusDot.classList.add('disabled');
                } else if (mod.state === 'error') {
                    statusDot.classList.add('error');
                } else if (mod.state === 'running' || mod.state === 'starting') {
                    statusDot.classList.add('running');
                }
            }
            
            const cardId = moduleToCard[mod.name];
            const indicatorId = moduleToIndicator[mod.name];
            const card = cardId ? document.getElementById(cardId) : null;
            const indicator = indicatorId ? document.getElementById(indicatorId) : null;
            
            if (card) {
                card.classList.remove('active');
                if (mod.state === 'running' || mod.state === 'starting') {
                    card.classList.add('active');
                }
            }
            
            if (indicator) {
                indicator.classList.remove('active');
                if (mod.state === 'running' || mod.state === 'starting') {
                    indicator.classList.add('active');
                }
            }
        });
        
        const outputCard = document.getElementById('card-output');
        const outputIndicator = document.getElementById('indicator-output');
        const outputDot = document.getElementById('status-video_muxer');
        
        if (pipelineState === 'running' || pipelineState === 'starting') {
            if (outputCard) outputCard.classList.add('active');
            if (outputIndicator) outputIndicator.classList.add('active');
            if (outputDot) {
                outputDot.classList.remove('disabled', 'error');
                outputDot.classList.add('running');
            }
        } else {
            if (outputCard) outputCard.classList.remove('active');
            if (outputIndicator) outputIndicator.classList.remove('active');
            if (outputDot) {
                outputDot.classList.remove('running');
                outputDot.classList.add('disabled');
            }
        }
        
        const inputCard = document.getElementById('card-input');
        const inputIndicator = document.getElementById('indicator-input');
        if ((pipelineState === 'running' || pipelineState === 'starting') && data.input_receiving) {
            if (inputCard) inputCard.classList.add('active');
            if (inputIndicator) inputIndicator.classList.add('active');
        } else {
            if (inputCard) inputCard.classList.remove('active');
            if (inputIndicator) inputIndicator.classList.remove('active');
        }
    }

    async function loadStatus() {
        try {
            const status = await apiCall('GET', '/api/status');
            updatePipelineUI(status.state);
            updateModuleStatus(status);
            
            const inputCard = document.getElementById('card-input');
            const inputIndicator = document.getElementById('indicator-input');
            if (status.state === 'running' && status.input_receiving) {
                if (inputCard) inputCard.classList.add('active');
                if (inputIndicator) inputIndicator.classList.add('active');
            } else {
                if (inputCard) inputCard.classList.remove('active');
                if (inputIndicator) inputIndicator.classList.remove('active');
            }
            
            if (status.network && status.network.local_ip) {
                updateUrls(status.network.local_ip);
            }
        } catch (e) {}
    }

    function applyConfigToUI() {
        if (config.input) {
            document.getElementById('input-type').value = config.input.type || 'srt';
            if (config.input.srt) {
                document.getElementById('input-port').value = config.input.srt.listen_port || 9000;
                document.getElementById('input-latency').value = config.input.srt.latency_ms || 1000;
            }
        }
        
        if (config.output) {
            document.getElementById('output-type').value = config.output.type || 'web';
            if (config.output.web) {
                document.getElementById('output-segment').value = config.output.web.segment_duration || 15;
            }
        }
        
        const modules = config.modules || {};
        
        if (modules.translator) {
            const translateEnabled = document.getElementById('translate-enabled');
            if (translateEnabled) translateEnabled.checked = modules.translator.enabled;
            document.getElementById('translate-source').value = modules.translator.source_lang || 'en';
            document.getElementById('translate-target').value = modules.translator.target_lang || 'es';
        }
        
        if (modules.subtitle_generator) {
            const subtitleEnabled = document.getElementById('subtitle-enabled');
            if (subtitleEnabled) subtitleEnabled.checked = modules.subtitle_generator.enabled;
            document.getElementById('subtitle-format').value = modules.subtitle_generator.format || 'srt';
            document.getElementById('subtitle-use-translated').value = String(modules.subtitle_generator.use_translated || true);
        }
        
        const dubEnabled = modules.tts_engine?.enabled || modules.audio_mixer?.enabled;
        document.getElementById('dub-enabled').checked = dubEnabled;
        if (modules.tts_engine) {
            document.getElementById('dub-voice').value = modules.tts_engine.voice || 'es-ES-AlvaroNeural';
            document.getElementById('dub-speed').value = modules.tts_engine.speed || 1.0;
        }
        
        if (modules.transcriber) {
            document.getElementById('adv-whisper-enabled').checked = modules.transcriber.enabled;
            document.getElementById('adv-model').value = modules.transcriber.model || 'tiny';
            document.getElementById('adv-lang').value = modules.transcriber.language || 'auto';
            document.getElementById('adv-device').value = modules.transcriber.device || 'auto';
        }
        
        if (modules.video_muxer) {
            document.getElementById('adv-seg').value = modules.video_muxer.hls_segment_duration || 15;
            document.getElementById('adv-list').value = modules.video_muxer.hls_list_size || 6;
        }
        
        toggleTranslate();
        toggleDub();
        toggleSubtitle();
        updateInputFields();
    }

    async function startPipeline() {
        const btn = document.getElementById('btn-start');
        btn.disabled = true;
        try {
            await saveConfig(true);
            await apiCall('POST', '/api/start');
            addLog('info', 'Pipeline iniciado');
            showToast('Pipeline iniciado', 'success');
            updatePipelineUI('running');
        } catch (e) {
            addLog('error', 'Error: ' + e.message);
            showToast('Error: ' + e.message, 'error');
            btn.disabled = false;
        }
    }

    async function stopPipeline() {
        try {
            await apiCall('POST', '/api/stop');
            addLog('info', 'Pipeline detenido');
            showToast('Pipeline detenido', 'info');
            updatePipelineUI('idle');
        } catch (e) {
            addLog('error', 'Error: ' + e.message);
            showToast('Error: ' + e.message, 'error');
        }
    }

    function updatePipelineUI(state) {
        const dot = document.getElementById('status-dot');
        const text = document.getElementById('status-text');
        const btnStart = document.getElementById('btn-start');
        const btnStop = document.getElementById('btn-stop');
        
        dot.classList.toggle('running', state === 'running');
        text.textContent = state === 'running' ? 'ACTIVO' : 'APAGADO';
        
        btnStart.disabled = state === 'running';
        btnStop.disabled = state !== 'running';
    }

    async function saveConfig(silent = false) {
        const modules = {
            transcriber: {
                enabled: document.getElementById('adv-whisper-enabled').checked
            },
            translator: {
                enabled: document.getElementById('translate-enabled').checked
            },
            subtitle_generator: {
                enabled: document.getElementById('subtitle-enabled').checked
            },
            tts_engine: {
                enabled: document.getElementById('dub-enabled').checked
            },
            audio_mixer: {
                enabled: document.getElementById('dub-enabled').checked
            }
        };
        
        const update = {
            input: {
                type: document.getElementById('input-type').value,
                srt: {
                    listen_port: parseInt(document.getElementById('input-port').value),
                    latency_ms: parseInt(document.getElementById('input-latency').value),
                    mode: 'listener'
                }
            },
            output: {
                type: document.getElementById('output-type').value,
                web: {
                    segment_duration: parseInt(document.getElementById('output-segment').value),
                    list_size: 6
                }
            },
            modules: {
                transcriber: {
                    enabled: document.getElementById('adv-whisper-enabled').checked,
                    model: document.getElementById('adv-model').value,
                    language: document.getElementById('adv-lang').value,
                    device: document.getElementById('adv-device').value
                },
                translator: {
                    enabled: document.getElementById('translate-enabled').checked,
                    source_lang: document.getElementById('translate-source').value,
                    target_lang: document.getElementById('translate-target').value
                },
                subtitle_generator: {
                    enabled: document.getElementById('subtitle-enabled').checked,
                    format: document.getElementById('subtitle-format').value,
                    use_translated: document.getElementById('subtitle-use-translated').value === 'true'
                },
                tts_engine: {
                    enabled: document.getElementById('dub-enabled').checked,
                    voice: document.getElementById('dub-voice').value,
                    speed: parseFloat(document.getElementById('dub-speed').value)
                },
                audio_mixer: {
                    enabled: document.getElementById('dub-enabled').checked,
                    original_volume: 0.4,
                    dubbed_volume: 1.8
                },
                video_muxer: {
                    enabled: true,
                    hls_segment_duration: parseInt(document.getElementById('adv-seg').value),
                    hls_list_size: parseInt(document.getElementById('adv-list').value)
                }
            }
        };

        try {
            const result = await apiCall('PUT', '/api/config', { config: update });
            config = result.config;
            updateUrls();
            if (!silent) {
                addLog('info', 'Configuración guardada');
                showToast('Configuración guardada', 'success');
            }
        } catch (e) {
            addLog('error', 'Error guardando: ' + e.message);
            showToast('Error: ' + e.message, 'error');
            throw e;
        }
    }

    function toggleTranslate() {
        const enabled = document.getElementById('translate-enabled').checked;
        const card = document.getElementById('card-translate');
        const settings = document.getElementById('translate-settings');
        if (card) card.classList.toggle('disabled', !enabled);
        if (settings) settings.style.opacity = enabled ? '1' : '0.5';
        
        if (!enabled) {
            const subtitleEnabled = document.getElementById('subtitle-enabled');
            const dubEnabled = document.getElementById('dub-enabled');
            if (subtitleEnabled && subtitleEnabled.checked) {
                subtitleEnabled.checked = false;
                toggleSubtitle();
                showToast('Subtítulos desactivado (requiere traducción)', 'warning');
            }
            if (dubEnabled && dubEnabled.checked) {
                dubEnabled.checked = false;
                toggleDub();
                showToast('Doblaje desactivado (requiere traducción)', 'warning');
            }
        }
    }

    function toggleDub() {
        const enabled = document.getElementById('dub-enabled').checked;
        const card = document.getElementById('card-dub');
        const settings = document.getElementById('dub-settings');
        if (card) card.classList.toggle('disabled', !enabled);
        if (settings) settings.style.opacity = enabled ? '1' : '0.5';
        
        if (enabled && !document.getElementById('translate-enabled').checked) {
            document.getElementById('translate-enabled').checked = true;
            toggleTranslate();
            showToast('Traducción activado automáticamente para doblaje', 'info');
        }
    }

    function toggleSubtitle() {
        const enabled = document.getElementById('subtitle-enabled').checked;
        const card = document.getElementById('card-subtitle');
        const settings = document.getElementById('subtitle-settings');
        if (card) card.classList.toggle('disabled', !enabled);
        if (settings) settings.style.opacity = enabled ? '1' : '0.5';
        
        if (enabled && !document.getElementById('translate-enabled').checked) {
            document.getElementById('translate-enabled').checked = true;
            toggleTranslate();
            showToast('Traducción activado automáticamente para subtítulos', 'info');
        }
    }

    function updateInputFields() {
        const type = document.getElementById('input-type').value;
        const portGroup = document.getElementById('input-port-group');
        const latencyGroup = document.getElementById('input-latency-group');
        if (portGroup) portGroup.style.display = type === 'srt' ? 'block' : 'none';
        if (latencyGroup) latencyGroup.style.display = type === 'srt' ? 'block' : 'none';
    }

    function addLog(level, message) {
        const container = document.getElementById('logs-container');
        const time = new Date().toLocaleTimeString();
        const entry = document.createElement('div');
        entry.className = `log-entry ${level}`;
        entry.textContent = `[${time}] ${message}`;
        container.appendChild(entry);
        container.scrollTop = container.scrollHeight;
        
        while (container.children.length > 100) {
            container.removeChild(container.firstChild);
        }
    }

    function clearLogs() {
        document.getElementById('logs-container').innerHTML = '';
    }

    function showToast(message, type = 'info') {
        const container = document.getElementById('toast-container');
        const toast = document.createElement('div');
        toast.className = `toast ${type}`;
        toast.textContent = message;
        container.appendChild(toast);
        setTimeout(() => toast.remove(), 3000);
    }

    async function copyUrl(type) {
        let url;
        switch (type) {
            case 'srt':
                url = document.getElementById('url-srt').textContent;
                break;
            case 'stream':
                url = document.getElementById('url-stream').textContent;
                break;
            case 'player':
                url = document.getElementById('url-player').textContent;
                break;
            default:
                return;
        }
        
        try {
            await navigator.clipboard.writeText(url);
            showToast(`${type.toUpperCase()} URL copiada`, 'success');
        } catch (e) {
            const textarea = document.createElement('textarea');
            textarea.value = url;
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);
            showToast(`${type.toUpperCase()} URL copiada`, 'success');
        }
    }

    // Init
    window.addEventListener('DOMContentLoaded', async () => {
        addLog('info', 'Inicializando...');
        
        try {
            config = await apiCall('GET', '/api/config');
            applyConfigToUI();
            
            const status = await apiCall('GET', '/api/status');
            updatePipelineUI(status.state);
            
            await loadNetworkInfo();
            
            connectWebSocket();
            statusPollInterval = setInterval(loadStatus, 3000);
            
            addLog('info', 'Conectado');
        } catch (e) {
            addLog('error', 'Error inicializando: ' + e.message);
        }
        
        document.getElementById('btn-start').addEventListener('click', startPipeline);
        document.getElementById('btn-stop').addEventListener('click', stopPipeline);
        document.getElementById('input-port').addEventListener('input', updateConnectionUrls);
        document.getElementById('input-latency').addEventListener('input', updateConnectionUrls);
        document.getElementById('input-type').addEventListener('change', updateInputFields);
        
        document.getElementById('translate-enabled').addEventListener('change', toggleTranslate);
        document.getElementById('dub-enabled').addEventListener('change', toggleDub);
        document.getElementById('subtitle-enabled').addEventListener('change', toggleSubtitle);
        
        document.getElementById('advanced-header').addEventListener('click', () => {
            document.getElementById('advanced-section').classList.toggle('expanded');
        });
        
        document.getElementById('btn-save-config').addEventListener('click', () => saveConfig(false));
        document.getElementById('btn-clear-logs').addEventListener('click', clearLogs);
        
        document.getElementById('btn-copy-srt').addEventListener('click', () => copyUrl('srt'));
        document.getElementById('btn-copy-stream').addEventListener('click', () => copyUrl('stream'));
        document.getElementById('btn-copy-player').addEventListener('click', () => copyUrl('player'));
        
        document.getElementById('btn-mode-local').addEventListener('click', () => setConnectionMode('local'));
        document.getElementById('btn-mode-remote').addEventListener('click', () => setConnectionMode('remote'));
        document.getElementById('emitter-address').addEventListener('input', updateConnectionUrls);
    });
</script>