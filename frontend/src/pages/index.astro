      if (!isNaN(value)) updateConfigField('modules.tts_engine.speed', value);
    });

    document.getElementById('subtitle-format')?.addEventListener('change', (e) => {
      updateConfigField('modules.subtitle_generator.format', (e.target as HTMLSelectElement).value);
    });
    document.getElementById('subtitle-use-translated')?.addEventListener('change', (e) => {
      updateConfigField('modules.subtitle_generator.use_translated', (e.target as HTMLSelectElement).value === 'true');
    });

    document.getElementById('audio-mixer-original-volume')?.addEventListener('input', (e) => {
      const value = parseFloat((e.target as HTMLInputElement).value);
      const display = document.getElementById('audio-mixer-original-value');
      if (display) display.textContent = String(value);
      if (!isNaN(value)) updateConfigField('modules.audio_mixer.original_volume', value);
    });
    document.getElementById('audio-mixer-dubbed-volume')?.addEventListener('input', (e) => {
      const value = parseFloat((e.target as HTMLInputElement).value);
      const display = document.getElementById('audio-mixer-dubbed-value');
      if (display) display.textContent = String(value);
      if (!isNaN(value)) updateConfigField('modules.audio_mixer.tts_volume', value);
    });

    document.getElementById('hls-encoder')?.addEventListener('change', (e) => {
      updateConfigField('modules.video_muxer.encoder_mode', (e.target as HTMLSelectElement).value);
    });
    document.getElementById('hls-crf')?.addEventListener('change', (e) => {
      const value = parseInt((e.target as HTMLInputElement).value);
      if (!isNaN(value)) updateConfigField('modules.video_muxer.video_crf', value);
    });

    // Output format listener
    document.getElementById('output-format')?.addEventListener('change', (e) => {
      const value = (e.target as HTMLSelectElement).value;
      handleOutputFormatChange(value);
      updateConfigField('output.type', value);
    });

    // SRT output listeners
    document.getElementById('output-srt-url')?.addEventListener('change', (e) => {
      updateConfigField('output.srt.url', (e.target as HTMLInputElement).value);
    });
    document.getElementById('output-srt-mode')?.addEventListener('change', (e) => {
      updateConfigField('output.srt.mode', (e.target as HTMLSelectElement).value);
    });
    document.getElementById('output-srt-latency')?.addEventListener('change', (e) => {
      const value = parseInt((e.target as HTMLInputElement).value);
      if (!isNaN(value)) updateConfigField('output.srt.latency_ms', value);
    });
    document.getElementById('output-srt-video-bitrate')?.addEventListener('change', (e) => {
      updateConfigField('output.srt.video_bitrate', (e.target as HTMLSelectElement).value);
    });
    document.getElementById('output-srt-audio-bitrate')?.addEventListener('change', (e) => {
      updateConfigField('output.srt.audio_bitrate', (e.target as HTMLSelectElement).value);
    });

    // RTMP output listeners
    document.getElementById('output-rtmp-url')?.addEventListener('change', (e) => {
      updateConfigField('output.rtmp.url', (e.target as HTMLInputElement).value);
    });
    document.getElementById('output-rtmp-video-bitrate')?.addEventListener('change', (e) => {
      updateConfigField('output.rtmp.video_bitrate', (e.target as HTMLSelectElement).value);
    });
    document.getElementById('output-rtmp-audio-bitrate')?.addEventListener('change', (e) => {
      updateConfigField('output.rtmp.audio_bitrate', (e.target as HTMLSelectElement).value);
    });
    document.getElementById('output-rtmp-encoder')?.addEventListener('change', (e) => {
      updateConfigField('output.rtmp.encoder_mode', (e.target as HTMLSelectElement).value);
    });

    // File output listeners
    document.getElementById('output-file-path')?.addEventListener('change', (e) => {
      updateConfigField('output.file.path', (e.target as HTMLInputElement).value);
    });
    document.getElementById('output-file-video')?.addEventListener('change', (e) => {
      updateConfigField('output.file.save_video', (e.target as HTMLSelectElement).value === 'true');
    });
    document.getElementById('output-file-audio')?.addEventListener('change', (e) => {
      updateConfigField('output.file.save_audio', (e.target as HTMLSelectElement).value === 'true');
    });
    document.getElementById('output-file-subs')?.addEventListener('change', (e) => {
      updateConfigField('output.file.save_subtitles', (e.target as HTMLSelectElement).value === 'true');
    });
  }

  async function initDashboard(): Promise<void> {
    addLog('info', 'Inicializando...');

    try {
      config = await getConfig();
      applyConfigToUI(config);

      status = await apiCall<Status>('GET', '/status');
      updatePipelineUI(status.state);
      updateModuleStatus(status);

      if (status.network?.local_ip) {
        updateUrls(status.network.local_ip);
      }

      wsClient = new WSClient({
        onLog: (msg: LogMessage) => addLog(msg.level, msg.message),
        onConnectionChange: (connected: boolean) => {
          if (!connected) addLog('error', 'WebSocket desconectado');
        },
        onStatus: (newStatus: Status) => {
          status = newStatus;
          updatePipelineUI(newStatus.state);
          updateModuleStatus(newStatus);
        }
      });
      wsClient.connect();

      statusPollInterval = setInterval(async () => {
        try {
          status = await apiCall<Status>('GET', '/status');
          updatePipelineUI(status.state);
          updateModuleStatus(status);
        } catch {
          // Silently fail on poll errors
        }
      }, 2000);

      addLog('success', 'Dashboard inicializado');
    } catch (e) {
      addLog('error', `Error de inicialización: ${(e as Error).message}`);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    setupEventListeners();
    initDashboard();

    setInterval(() => {
      const clock = document.getElementById('live-clock');
      if (clock) {
        clock.textContent = new Date().toLocaleTimeString('en-US', { hour12: false });
      }
    }, 1000);
  });

  window.toggleModule = toggleModule;
</script>
