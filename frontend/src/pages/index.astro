---
import { readFileSync, existsSync } from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import StatusCard from '../components/StatusCard.astro';
import MetricsCard from '../components/MetricsCard.astro';
import ProcessGrid from '../components/ProcessGrid.astro';
import LogPanel from '../components/LogPanel.astro';
import Toast from '../components/Toast.astro';

// Walk up from cwd to find pyproject.toml (works in both dev and build)
let projectRoot = process.cwd();
while (!existsSync(path.join(projectRoot, 'pyproject.toml'))) {
  const parent = path.dirname(projectRoot);
  if (parent === projectRoot) { projectRoot = ''; break; }
  projectRoot = parent;
}
const versionMatch = projectRoot
  ? readFileSync(path.join(projectRoot, 'pyproject.toml'), 'utf-8').match(/^version\s*=\s*"([^"]+)"/m)
  : null;
const appVersion = versionMatch?.[1] ?? '0.0.0';
---

<BaseLayout title="SRT2Web Dashboard">
  <div class="dashboard">
    <Header version={appVersion} />
    <StatusCard />
    <MetricsCard />
    <ProcessGrid />
    <LogPanel />
  </div>
  <Toast />
  <script>
    import '../lib/dashboard.ts';
    import '../lib/modules/outputs.ts';
  </script>
</BaseLayout>

<style>
  .dashboard {
    max-width: 1200px;
    margin: 0 auto;
    padding: 16px;
    min-height: calc(100vh - 32px);
  }
</style>
