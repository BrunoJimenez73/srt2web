---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import StatusCard from '../components/StatusCard.astro';
import MetricsCard from '../components/MetricsCard.astro';
import ProcessGrid from '../components/ProcessGrid.astro';
import LogPanel from '../components/LogPanel.astro';
import Toast from '../components/Toast.astro';
---

<BaseLayout title="SRT2Web Dashboard">
  <div class="dashboard">
    <Header version="0.6.1" />
    <StatusCard />
    <MetricsCard />
    <ProcessGrid />
    <LogPanel />
  </div>
  <Toast />
</BaseLayout>

<style>
  .dashboard {
    max-width: 1200px;
    margin: 0 auto;
    padding: 16px;
    min-height: calc(100vh - 32px);
  }

  /* Status dot styles */
  #status-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--text-dim);
  }

  #status-dot.running {
    background: #00ff00;
    box-shadow: 0 0 8px #00ff00, 0 0 15px #00ff00, 0 0 25px #00ff00, 0 0 40px #00ff00;
    animation: phosphor-pulse 1.5s ease-in-out infinite;
  }

  #status-dot.error {
    background: #ff3333;
    box-shadow: 0 0 8px #ff3333, 0 0 15px #ff3333;
    animation: error-pulse 1s ease-in-out infinite;
  }

  #status-dot.disabled {
    background: var(--text-dim);
    box-shadow: none;
    opacity: 0.5;
  }

  /* Process indicator styles (small dots in process grid) */
  .process-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--text-dim);
    margin-right: 8px;
    transition: all 0.3s ease;
  }

  .process-indicator.active {
    background: #00ff00;
    box-shadow: 0 0 6px #00ff00, 0 0 12px #00ff00, 0 0 18px #00ff00;
    animation: indicator-pulse 1.5s ease-in-out infinite;
  }

  /* Keyframe animations */
  @keyframes phosphor-pulse {
    0% { 
      opacity: 0.7;
      box-shadow: 0 0 5px #00ff00, 0 0 10px #00ff00, 0 0 20px #00ff00;
    }
    50% { 
      opacity: 1;
      box-shadow: 0 0 8px #00ff00, 0 0 15px #00ff00, 0 0 30px #00ff00, 0 0 40px #00ff00;
    }
    100% { 
      opacity: 0.7;
      box-shadow: 0 0 5px #00ff00, 0 0 10px #00ff00, 0 0 20px #00ff00;
    }
  }

  @keyframes error-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.6; }
  }

  @keyframes indicator-pulse {
    0%, 100% { 
      opacity: 0.8;
      box-shadow: 0 0 4px #00ff00, 0 0 8px #00ff00;
    }
    50% { 
      opacity: 1;
      box-shadow: 0 0 8px #00ff00, 0 0 16px #00ff00, 0 0 24px #00ff00;
    }
  }
</style>

<script>
  import { apiCall, getConfig, startPipeline, stopPipeline, WSClient } from '../lib/api';
  import { getSRTUrl, getStreamUrl, getPlayerUrl, isLocalhost, copyToClipboard, showToast } from '../lib/utils';
  import type { Config, Status, LogMessage, ModuleName } from '../lib/types';

   const moduleToCard: Record<string, string> = {
     srt_ingest: 'card-input',
     audio_extractor: 'card-input',
     transcriber: 'card-whisper',
     translator: 'card-translate',
     tts_engine: 'card-tts',
     subtitle_generator: 'card-subtitle',
     audio_mixer: 'card-audio-mixer',
      video_muxer: 'card-video-muxer'
   };

   const moduleToIndicator: Record<string, string> = {
     srt_ingest: 'indicator-input',
     audio_extractor: 'indicator-input',
     transcriber: 'indicator-whisper',
     translator: 'indicator-translate',
     tts_engine: 'indicator-tts',
     subtitle_generator: 'indicator-subtitle',
     audio_mixer: 'indicator-audio-mixer',
      video_muxer: 'indicator-video-muxer'
   };

  let config: Config | null = null;
  let status: Status | null = null;
  let wsClient: WSClient | null = null;
  let localMode: 'local' | 'remote' = 'local';
  let statusPollInterval: ReturnType<typeof setInterval> | null = null;

  function addLog(level: LogMessage['level'], message: string): void {
    const fn = (window as unknown as { addLog: (l: string, m: string) => void }).addLog;
    if (fn) fn(level, message);
  }

  function updatePipelineUI(state: Status['state']): void {
    const dot = document.getElementById('status-dot');
    const text = document.getElementById('status-text');
    const startBtn = document.getElementById('btn-start') as HTMLButtonElement;
    const stopBtn = document.getElementById('btn-stop') as HTMLButtonElement;

    if (dot) dot.classList.toggle('running', state === 'running');
    if (text) text.textContent = state === 'running' ? 'ACTIVO' : 'APAGADO';
    if (startBtn) startBtn.disabled = state === 'running';
    if (stopBtn) stopBtn.disabled = state !== 'running';

    // Card active state removed - only indicators show status
    // ['card-input', 'card-whisper', 'card-translate', 'card-tts', 'card-subtitle', 'card-video-muxer', 'card-output'].forEach(id => {
    //   const el = document.getElementById(id);
    //   if (el) el.classList.toggle('active', state === 'running');
    // });
    
    // Update live clock
    const clock = document.getElementById('live-clock');
    if (clock) {
      clock.textContent = new Date().toLocaleTimeString('en-US', { hour12: false });
    }
  }

    function updateModuleStatus(status: Status): void {
      if (!status.modules) return;
      
      const isRunning = status.state === 'running';

      // Set indicators based on module status
      // status.modules is an array of module objects
      status.modules.forEach((module) => {
        const indicatorId = moduleToIndicator[module.name];
        if (indicatorId) {
          const indicator = document.getElementById(indicatorId);
          if (indicator) {
            // Indicator is active if module is enabled AND pipeline is running
            indicator.classList.toggle('active', isRunning && module.enabled);
          }
        }
      });

      // Special handling for input indicator (combines srt_ingest and audio_extractor)
      const inputIndicator = document.getElementById('indicator-input');
      if (inputIndicator) {
        // Find srt_ingest and audio_extractor modules in the array
        const srtIngestModule = status.modules.find(m => m.name === 'srt_ingest');
        const audioExtractorModule = status.modules.find(m => m.name === 'audio_extractor');
        const srtIngestActive = srtIngestModule?.enabled && isRunning;
        const audioExtractorActive = audioExtractorModule?.enabled && isRunning;
        // Input is active if either input module is active
        inputIndicator.classList.toggle('active', srtIngestActive || audioExtractorActive);
      }

      // Special handling for output indicator (represents video muxer output)
      const outputIndicator = document.getElementById('indicator-output');
      if (outputIndicator) {
        // Find video_muxer module in the array
        const videoMuxerModule = status.modules.find(m => m.name === 'video_muxer');
        const videoMuxerActive = videoMuxerModule?.enabled && isRunning;
        outputIndicator.classList.toggle('active', videoMuxerActive);
      }

      const statChunks = document.getElementById('stat-chunks');
      const statState = document.getElementById('stat-state');
      if (statChunks) statChunks.textContent = String(status.chunks_processed ?? 0);
      if (statState) statState.textContent = status.state;
      
      // Update system metrics
      updateSystemMetrics(status);
      
      // Update performance metrics for modules
      updateModulePerformanceMetrics(status.modules);
    }

    // Update system metrics display (CPU, Memory, Chunks, Throughput)
    let lastChunksProcessed = 0;
    let throughputHistory: number[] = [];
    
    function updateSystemMetrics(status: Status): void {
      const system = status.system;
      
      // CPU metric
      const cpuBar = document.getElementById('metric-cpu-bar');
      const cpuValue = document.getElementById('metric-cpu-value');
      const cpuItem = document.getElementById('metric-cpu');
      if (cpuBar && cpuValue && cpuItem && system?.available) {
        const cpu = system.cpu_percent;
        cpuBar.style.width = `${Math.min(cpu, 100)}%`;
        cpuValue.textContent = `${cpu.toFixed(1)}%`;
        
        // Color coding based on CPU usage
        cpuBar.className = 'metric-bar';
        if (cpu < 50) cpuBar.classList.add('low');
        else if (cpu < 80) cpuBar.classList.add('medium');
        else cpuBar.classList.add('high');
        
        cpuItem.className = cpu > 90 ? 'metric-item critical' : cpu > 70 ? 'metric-item warning' : '';
      }
      
      // Memory metric
      const memBar = document.getElementById('metric-memory-bar');
      const memValue = document.getElementById('metric-memory-value');
      const memPercent = document.getElementById('metric-memory-percent');
      const memItem = document.getElementById('metric-memory');
      if (memBar && memValue && memPercent && memItem && system?.available) {
        const memMb = system.memory_mb;
        const memPct = system.memory_percent;
        memBar.style.width = `${Math.min(memPct, 100)}%`;
        memValue.textContent = `${memMb.toFixed(0)} MB`;
        memPercent.textContent = `${memPct.toFixed(1)}%`;
        
        // Color coding based on memory usage
        memBar.className = 'metric-bar';
        if (memPct < 50) memBar.classList.add('low');
        else if (memPct < 80) memBar.classList.add('medium');
        else memBar.classList.add('high');
        
        memItem.className = memPct > 90 ? 'metric-item critical' : memPct > 70 ? 'metric-item warning' : '';
      }
      
      // GPU metric
      const gpuBar = document.getElementById('metric-gpu-bar');
      const gpuValue = document.getElementById('metric-gpu-value');
      const gpuMemory = document.getElementById('metric-gpu-memory');
      const gpuItem = document.getElementById('metric-gpu');
      if (gpuBar && gpuValue && gpuMemory && gpuItem) {
        if (system?.gpu_available) {
          const gpuPct = system.gpu_percent;
          const gpuMemMb = system.gpu_memory_mb;
          gpuBar.style.width = `${Math.min(gpuPct, 100)}%`;
          gpuValue.textContent = `${gpuPct.toFixed(1)}%`;
          gpuMemory.textContent = `${gpuMemMb.toFixed(0)} MB`;
          
          // Color coding based on GPU usage
          gpuBar.className = 'metric-bar';
          if (gpuPct < 50) gpuBar.classList.add('low');
          else if (gpuPct < 80) gpuBar.classList.add('medium');
          else gpuBar.classList.add('high');
          
          gpuItem.className = gpuPct > 90 ? 'metric-item critical' : gpuPct > 70 ? 'metric-item warning' : '';
        } else {
          gpuBar.style.width = '0%';
          gpuValue.textContent = 'N/A';
          gpuMemory.textContent = 'N/A';
          gpuItem.className = 'metric-item';
        }
      }
      
      // Throughput calculation
      const throughputBar = document.getElementById('metric-throughput-bar');
      const throughputValue = document.getElementById('metric-throughput-value');
      if (throughputBar && throughputValue) {
        const currentChunks = status.chunks_processed ?? 0;
        const chunkDiff = currentChunks - lastChunksProcessed;
        lastChunksProcessed = currentChunks;
        
        // Keep rolling average of last 5 measurements
        throughputHistory.push(chunkDiff);
        if (throughputHistory.length > 5) throughputHistory.shift();
        
        const avgThroughput = throughputHistory.reduce((a, b) => a + b, 0) / throughputHistory.length;
        throughputValue.textContent = `${avgThroughput.toFixed(1)}/s`;
        
        // Throughput bar (max 10 chunks/s)
        const throughputPct = Math.min((avgThroughput / 10) * 100, 100);
        throughputBar.style.width = `${throughputPct}%`;
      }
    }

    // Update performance metrics display for modules
    function updateModulePerformanceMetrics(modules: any[]): void {
      // Update aggregated INPUT metrics
      const inputTimeEl = document.getElementById('module-time-input');
      const inputChunksEl = document.getElementById('module-chunks-input');
      
      // Find input modules
      const srtIngest = modules.find(m => m.name === 'srt_ingest');
      const audioExtractor = modules.find(m => m.name === 'audio_extractor');
      
      if (inputTimeEl) {
        // Use the last process time from either input module
        const lastTime = Math.max(
          srtIngest?.last_process_time_ms || 0,
          audioExtractor?.last_process_time_ms || 0
        );
        
        if (!srtIngest?.enabled && !audioExtractor?.enabled) {
          inputTimeEl.textContent = 'DISABLED';
          inputTimeEl.style.color = 'var(--text-dim)';
        } else if (srtIngest?.state === 'running' || audioExtractor?.state === 'running') {
          inputTimeEl.textContent = lastTime > 0 ? `${lastTime.toFixed(1)}ms` : 'RUNNING';
          inputTimeEl.style.color = 'var(--success)';
        } else if (srtIngest?.state === 'error' || audioExtractor?.state === 'error') {
          inputTimeEl.textContent = 'ERROR';
          inputTimeEl.style.color = 'var(--error)';
        } else {
          inputTimeEl.textContent = 'IDLE';
          inputTimeEl.style.color = 'var(--text-sec)';
        }
      }
      
      if (inputChunksEl) {
        // Show chunks processed by audio_extractor (more meaningful than srt_ingest)
        const chunks = audioExtractor?.processed_chunks || srtIngest?.processed_chunks || 0;
        inputChunksEl.textContent = String(chunks);
      }
      
      // Update aggregated OUTPUT metrics (video_muxer)
      const outputTimeEl = document.getElementById('module-time-output');
      const outputChunksEl = document.getElementById('module-chunks-output');
      const videoMuxer = modules.find(m => m.name === 'video_muxer');
      
      if (outputTimeEl && videoMuxer) {
        if (!videoMuxer.enabled) {
          outputTimeEl.textContent = 'DISABLED';
          outputTimeEl.style.color = 'var(--text-dim)';
        } else if (videoMuxer.state === 'running') {
          outputTimeEl.textContent = videoMuxer.last_process_time_ms > 0 ? `${videoMuxer.last_process_time_ms.toFixed(1)}ms` : 'RUNNING';
          outputTimeEl.style.color = 'var(--success)';
        } else if (videoMuxer.state === 'error') {
          outputTimeEl.textContent = 'ERROR';
          outputTimeEl.style.color = 'var(--error)';
        } else {
          outputTimeEl.textContent = 'IDLE';
          outputTimeEl.style.color = 'var(--text-sec)';
        }
      }
      
      if (outputChunksEl && videoMuxer) {
        outputChunksEl.textContent = String(videoMuxer.processed_chunks || 0);
      }
      
      // Update output format display
      const outputFormatEl = document.getElementById('module-format-output');
      if (outputFormatEl && config?.output?.type) {
        const formatLabels: Record<string, string> = {
          'web': 'HLS',
          'srt': 'SRT',
          'rtmp': 'RTMP',
          'file': 'File'
        };
        outputFormatEl.textContent = formatLabels[config.output.type] || config.output.type;
      }
      
      // Update per-module metrics
      modules.forEach(module => {
        // Update last process time
        const timeEl = document.getElementById(`module-time-${module.name}`);
        if (timeEl) {
          if (!module.enabled) {
            timeEl.textContent = 'DISABLED';
            timeEl.style.color = 'var(--text-dim)';
          } else if (module.state === 'running') {
            // Show last process time if available, otherwise show RUNNING
            const lastProcessTime = module.last_process_time_ms > 0 ? `${module.last_process_time_ms.toFixed(1)}ms` : 'RUNNING';
            timeEl.textContent = lastProcessTime;
            timeEl.style.color = 'var(--success)';
          } else if (module.state === 'error') {
            timeEl.textContent = 'ERROR';
            timeEl.style.color = 'var(--error)';
          } else {
            timeEl.textContent = 'IDLE';
            timeEl.style.color = 'var(--text-sec)';
          }
        }
        
        // Update memory usage if available
        const memoryEl = document.getElementById(`module-memory-${module.name}`);
        if (memoryEl && module.memory_mb !== undefined) {
          memoryEl.textContent = `${module.memory_mb.toFixed(1)} MB`;
        }
        
        // Update processed chunks if available
        const chunksEl = document.getElementById(`module-chunks-${module.name}`);
        if (chunksEl && module.processed_chunks !== undefined) {
          chunksEl.textContent = String(module.processed_chunks);
        }

        // Update GPU badge and device info from extra field
        if (module.extra) {
          // Check if module is actively processing (enabled + running + has processed chunks)
          const isProcessing = module.enabled && module.state === 'running' && module.processed_chunks > 0;

          // GPU badge for transcriber (Whisper)
          if (module.name === 'transcriber') {
            const gpuBadge = document.getElementById('whisper-gpu-badge');
            const deviceEl = document.getElementById('module-device-transcriber');
            if (gpuBadge) {
              gpuBadge.style.display = 'inline';
              gpuBadge.textContent = module.extra.using_gpu ? 'GPU' : 'CPU';
              gpuBadge.classList.toggle('active', isProcessing && module.extra.using_gpu);
            }
            if (deviceEl) {
              deviceEl.textContent = module.extra.device ? module.extra.device.toUpperCase() : '--';
            }
          }

          // GPU badge for tts_engine (Doblar)
          if (module.name === 'tts_engine') {
            const gpuBadge = document.getElementById('tts-gpu-badge');
            const deviceEl = document.getElementById('module-device-tts_engine');
            if (gpuBadge) {
              const isPiper = module.extra.engine === 'piper';
              if (isPiper) {
                gpuBadge.style.display = 'inline';
                gpuBadge.textContent = module.extra.using_gpu ? 'GPU' : 'CPU';
                gpuBadge.classList.toggle('active', isProcessing && module.extra.using_gpu);
              } else {
                gpuBadge.style.display = 'none';
              }
            }
            if (deviceEl) {
              deviceEl.textContent = module.extra.device ? module.extra.device.toUpperCase() : '--';
            }
          }

          // GPU badge and encoder info for video_muxer (HLS Output)
          if (module.name === 'video_muxer') {
            const gpuBadge = document.getElementById('video-muxer-gpu-badge');
            const encoderEl = document.getElementById('module-encoder-video_muxer');
            if (gpuBadge) {
              // Always show badge when module is active, color indicates GPU usage
              if (module.enabled) {
                gpuBadge.style.display = 'inline';
                gpuBadge.classList.toggle('active', isProcessing && module.extra.using_gpu);
                gpuBadge.textContent = module.extra.using_gpu ? 'GPU' : 'CPU';
              } else {
                gpuBadge.style.display = 'none';
              }
            }
            if (encoderEl) {
              // Show actual encoder mode
              const encoderMode = module.extra.encoder_mode || 'cpu';
              const encoderLabels: Record<string, string> = {
                'cpu': 'CPU',
                'gpu_nvenc': 'NVENC',
                'gpu_amf': 'AMF',
                'gpu_qsv': 'QSV',
                'gpu_vaapi': 'VAAPI'
              };
              encoderEl.textContent = encoderLabels[encoderMode] || encoderMode;
            }
          }
        }
      });
    }

    // Toggle individual module state via API
    async function toggleModule(moduleName: string, enabled: boolean): Promise<void> {
      try {
        await apiCall('PUT', `/modules/${moduleName}/toggle`, { enabled });
        // Optionally show a toast or log
        // showToast(`Module ${moduleName} ${enabled ? 'enabled' : 'disabled'}`, 'success');
      } catch (e) {
        const msg = e instanceof Error ? e.message : String(e);
        showToast(`Failed to toggle ${moduleName}: ${msg}`, 'error');
        // Optionally revert the UI change? We'll rely on the API call to update the state and then we'll refresh via status update.
        // But for now, we show an error and the user can try again.
      }
    }

  function updateUrls(ip: string | null): void {
    if (!config || !ip) return;
    
    const port = config.server.port;
    const srtPort = config.input.srt.listen_port;
    const srtMode = config.input.srt.mode;
    const useIp = isLocalhost() ? '127.0.0.1' : ip;

    const urlSrt = document.getElementById('url-srt');
    const urlStream = document.getElementById('url-stream');
    const urlPlayer = document.getElementById('url-player');

    // OBS always connects as caller to a listener server, so invert the mode for the displayed URL
    const obsMode = srtMode === 'listener' ? 'caller' : 'listener';
    if (urlSrt) urlSrt.textContent = getSRTUrl(useIp, srtPort, obsMode);
    if (urlStream) urlStream.textContent = getStreamUrl(useIp, port);
    if (urlPlayer) urlPlayer.href = getPlayerUrl(useIp, port);
    if (urlPlayer) urlPlayer.textContent = getPlayerUrl(useIp, port);
  }

  // Input type handler - shows/hides SRT/RTMP/File settings
  function handleInputTypeChange(type: string): void {
    const srtSettings = document.getElementById('input-srt-settings') as HTMLElement;
    const rtmpSettings = document.getElementById('input-rtmp-settings') as HTMLElement;
    const fileSettings = document.getElementById('input-file-settings') as HTMLElement;
    
    if (srtSettings) srtSettings.style.display = 'none';
    if (rtmpSettings) rtmpSettings.style.display = 'none';
    if (fileSettings) fileSettings.style.display = 'none';
    
    const callerGroup = document.getElementById('input-caller-group') as HTMLElement;
    const srtMode = document.getElementById('input-srt-mode') as HTMLSelectElement;
    
    if (type === 'srt') {
      if (srtSettings) srtSettings.style.display = 'flex';
      if (srtMode) {
        const showCaller = srtMode.value === 'caller' || srtMode.value === 'rendezvous';
        if (callerGroup) callerGroup.style.display = showCaller ? 'flex' : 'none';
      }
    } else if (type === 'rtmp') {
      if (rtmpSettings) rtmpSettings.style.display = 'flex';
    } else if (type === 'file') {
      if (fileSettings) fileSettings.style.display = 'flex';
    }
  }
  window.handleInputTypeChange = handleInputTypeChange;

  // File select handler
  function handleFileSelect(input: HTMLInputElement): void {
    const file = input.files?.[0];
    if (file) {
      const pathInput = document.getElementById('input-file-path') as HTMLInputElement;
      if (pathInput) {
        pathInput.value = file.name;
        pathInput.dataset.filePath = file.name;
      }
    }
  }
  window.handleFileSelect = handleFileSelect;

  // Output format handler - shows/hides Web/SRT/RTMP/File settings
  function handleOutputFormatChange(format: string): void {
    const webSettings = document.getElementById('web-settings') as HTMLElement;
    const srtSettings = document.getElementById('output-srt-settings') as HTMLElement;
    const rtmpSettings = document.getElementById('output-rtmp-settings') as HTMLElement;
    const fileSettings = document.getElementById('output-file-settings') as HTMLElement;
    
    if (webSettings) webSettings.style.display = 'none';
    if (srtSettings) srtSettings.style.display = 'none';
    if (rtmpSettings) rtmpSettings.style.display = 'none';
    if (fileSettings) fileSettings.style.display = 'none';
    
    if (format === 'web') {
      if (webSettings) webSettings.style.display = 'flex';
    } else if (format === 'srt') {
      if (srtSettings) srtSettings.style.display = 'flex';
    } else if (format === 'rtmp') {
      if (rtmpSettings) rtmpSettings.style.display = 'flex';
    } else if (format === 'file') {
      if (fileSettings) fileSettings.style.display = 'flex';
    }
  }
  window.handleOutputFormatChange = handleOutputFormatChange;

  function applyConfigToUI(cfg: Config): void {
    const srtPort = document.getElementById('input-srt-port') as HTMLInputElement;
    const srtMode = document.getElementById('input-srt-mode') as HTMLSelectElement;
    const whisperEnabled = document.getElementById('whisper-enabled') as HTMLInputElement;
    const whisperModel = document.getElementById('whisper-model') as HTMLSelectElement;
    const whisperLang = document.getElementById('whisper-lang') as HTMLSelectElement;
    const whisperDevice = document.getElementById('whisper-device') as HTMLSelectElement;
    const translatorEnabled = document.getElementById('translator-enabled') as HTMLInputElement;
    const translatorSource = document.getElementById('translator-source') as HTMLSelectElement;
    const translatorTarget = document.getElementById('translator-target') as HTMLSelectElement;
    const ttsEnabled = document.getElementById('tts-enabled') as HTMLInputElement;
    const ttsEngine = document.getElementById('tts-engine') as HTMLSelectElement;
    const ttsDevice = document.getElementById('tts-device') as HTMLSelectElement;
    const ttsDeviceGroup = document.getElementById('tts-device-group') as HTMLDivElement;
    const ttsVoiceEdge = document.getElementById('tts-voice-edge') as HTMLSelectElement;
    const ttsVoicePiper = document.getElementById('tts-voice-piper') as HTMLSelectElement;
    const ttsVoiceEdgeGroup = document.getElementById('tts-voice-edge-group') as HTMLDivElement;
    const ttsVoicePiperGroup = document.getElementById('tts-voice-piper-group') as HTMLDivElement;
    const ttsSpeed = document.getElementById('tts-speed') as HTMLInputElement;
    const subtitleEnabled = document.getElementById('subtitle-enabled') as HTMLInputElement;
    const subtitleFormat = document.getElementById('subtitle-format') as HTMLSelectElement;
    const subtitleUseTranslated = document.getElementById('subtitle-use-translated') as HTMLSelectElement;
    const muxerEnabled = document.getElementById('muxer-enabled') as HTMLInputElement;
    const hlsEncoder = document.getElementById('hls-encoder') as HTMLSelectElement;
    const hlsCrf = document.getElementById('hls-crf') as HTMLInputElement;

    if (srtPort) srtPort.value = String(cfg.input.srt.listen_port);
