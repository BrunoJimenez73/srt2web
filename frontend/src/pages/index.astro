  async function handleStart(): Promise<void> {
    const btnStart = document.getElementById('btn-start') as HTMLButtonElement;
    const btnStop = document.getElementById('btn-stop') as HTMLButtonElement;
    
    try {
      btnStart.disabled = true;
      btnStart.classList.add('loading');
      btnStop.disabled = true;
      
      addLog('info', 'Iniciando pipeline...');
      const result = await startPipeline();
      status = result;
      updatePipelineUI(result.state);
      addLog('success', 'Pipeline iniciado');
    } catch (e) {
      addLog('error', `Error: ${(e as Error).message}`);
      btnStart.disabled = false;
    } finally {
      btnStart.classList.remove('loading');
    }
  }

  async function handleStop(): Promise<void> {
    const btnStart = document.getElementById('btn-start') as HTMLButtonElement;
    const btnStop = document.getElementById('btn-stop') as HTMLButtonElement;
    
    // Confirm before stopping
    if (!confirm('¿Está seguro que desea detener el pipeline?')) {
      return;
    }
    
    try {
      btnStop.disabled = true;
      btnStop.classList.add('loading');
      btnStart.disabled = true;
      
      addLog('info', 'Deteniendo pipeline...');
      const result = await stopPipeline();
      status = result;
      updatePipelineUI(result.state);
      addLog('info', 'Pipeline detenido');
    } catch (e) {
      addLog('error', `Error: ${(e as Error).message}`);
      btnStop.disabled = false;
    } finally {
      btnStop.classList.remove('loading');
    }
  }

  async function handleSaveConfig(): Promise<void> {
    const btnSave = document.getElementById('btn-save-config') as HTMLButtonElement;
    
    try {
      if (btnSave) {
        btnSave.disabled = true;
        btnSave.classList.add('loading');
      }
      
      const newConfig = collectConfigFromUI();
      await apiCall('PUT', '/config', { config: newConfig });
      config = await getConfig();
      applyConfigToUI(config);
      showToast('Configuración guardada', 'success');
      addLog('info', 'Configuración guardada');
    } catch (e) {
      const msg = (e as Error).message;
      showToast(`Error: ${msg}`, 'error');
      addLog('error', `Error al guardar: ${msg}`);
    } finally {
      if (btnSave) {
        btnSave.disabled = false;
        btnSave.classList.remove('loading');
      }
    }
  }

  // Individual config update with debouncing
  const configUpdateTimeouts: Record<string, ReturnType<typeof setTimeout>> = {};
  const CONFIG_UPDATE_DEBOUNCE_MS = 1000;

  async function updateConfigField(path: string, value: unknown): Promise<void> {
    // Clear any pending update for this field
    if (configUpdateTimeouts[path]) {
      clearTimeout(configUpdateTimeouts[path]);
    }

    // Debounce the update
    configUpdateTimeouts[path] = setTimeout(async () => {
      try {
        // Build partial config path
        const parts = path.split('.');
        let partialConfig: any = {};
        let current = partialConfig;
        
        for (let i = 0; i < parts.length - 1; i++) {
          current[parts[i]] = {};
          current = current[parts[i]];
        }
        current[parts[parts.length - 1]] = value;

        await apiCall('PUT', '/config', { config: partialConfig });
        
        // Update local config reference
        config = await getConfig();
        
        // Show subtle indicator
        const indicator = document.getElementById(`config-saved-${path.replace(/\./g, '-')}`);
        if (indicator) {
          indicator.textContent = '✓';
          indicator.style.opacity = '1';
          setTimeout(() => {
            indicator.style.opacity = '0';
          }, 1500);
        }
      } catch (e) {
        const msg = e instanceof Error ? e.message : String(e);
        showToast(`Error al actualizar ${path}: ${msg}`, 'error', 3000);
      }
    }, CONFIG_UPDATE_DEBOUNCE_MS);
  }

  async function copyUrl(id: string): Promise<void> {
