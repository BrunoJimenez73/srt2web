---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import StatusCard from '../components/StatusCard.astro';
import MetricsCard from '../components/MetricsCard.astro';
import LogPanel from '../components/LogPanel.astro';
import Toast from '../components/Toast.astro';

import CollapsibleCard from '../components/CollapsibleCard.astro';
import InputCard from '../components/InputCard.astro';
import WhisperCard from '../components/WhisperCard.astro';
import TranslateCard from '../components/TranslateCard.astro';
import TtsCard from '../components/TtsCard.astro';
import SubtitleCard from '../components/SubtitleCard.astro';
import AudioMixerCard from '../components/AudioMixerCard.astro';
import HlsCard from '../components/HlsCard.astro';
import OutputCard from '../components/OutputCard.astro';
import AudioExtractorCard from '../components/AudioExtractorCard.astro';
---

<BaseLayout title="SRT2Web Dashboard (Nuevo)">
  <div class="dashboard">
    <Header version="0.6.7" />
    <StatusCard />
    <MetricsCard />
    <div class="process-grid">
      <CollapsibleCard id="input"><InputCard /></CollapsibleCard>
      <CollapsibleCard id="audio-extractor"><AudioExtractorCard /></CollapsibleCard>
      <CollapsibleCard id="whisper"><WhisperCard /></CollapsibleCard>
      <CollapsibleCard id="translate"><TranslateCard /></CollapsibleCard>
      <CollapsibleCard id="tts"><TtsCard /></CollapsibleCard>
      <CollapsibleCard id="subtitle"><SubtitleCard /></CollapsibleCard>
      <CollapsibleCard id="audio-mixer"><AudioMixerCard /></CollapsibleCard>
      <CollapsibleCard id="video-muxer"><HlsCard /></CollapsibleCard>
      <CollapsibleCard id="output"><OutputCard /></CollapsibleCard>
    </div>
    <LogPanel />
  </div>
  <Toast />
  <script>
    import '../lib/dashboard.ts';
    import '../lib/modules/outputs.ts';

    document.querySelectorAll<HTMLElement>('.collapsible-module-wrapper').forEach((wrapper) => {
      const header = wrapper.querySelector<HTMLElement>('.process-header');
      const content = wrapper.querySelector<HTMLElement>('.process-content');
      if (!header || !content) return;

      const icon = document.createElement('span');
      icon.className = 'cm-collapse-icon';
      icon.textContent = '▶';
      icon.setAttribute('aria-hidden', 'true');

      header.insertBefore(icon, header.firstChild);
      header.style.cursor = 'pointer';
      header.title = 'Click para colapsar/expandir';

      const toggle = () => {
        const collapsed = wrapper.classList.toggle('collapsed');
        icon.textContent = collapsed ? '▶' : '▼';
        header.setAttribute('aria-expanded', String(!collapsed));
      };

      header.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('.toggle-switch, .gpu-badge, button, input, select, a')) return;
        toggle();
      });

      header.setAttribute('role', 'button');
      header.setAttribute('tabindex', '0');
      header.setAttribute('aria-expanded', 'true');
      header.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggle();
        }
      });
    });
  </script>
</BaseLayout>

<style>
  .dashboard {
    max-width: 1200px;
    margin: 0 auto;
    padding: 16px;
    min-height: calc(100vh - 32px);
  }
</style>
