---
import DocsLayout from '../../components/docs/DocsLayout.astro';

const sections = [
  {
    title: 'Primeros pasos',
    description: 'Instala SRT2Web y emite tu primer stream en menos de 10 minutos.',
    icon: '🚀',
    links: [
      { label: 'Getting Started', href: '/docs/getting-started', desc: 'Inicio rápido del proyecto' },
      { label: 'Installation', href: '/docs/installation', desc: 'Instalación paso a paso' },
      { label: 'Configuration', href: '/docs/configuration', desc: 'Configuración de módulos e inputs' },
    ],
  },
  {
    title: 'Módulos del pipeline',
    description: 'Cada módulo de procesamiento: transcripción, traducción, TTS, subtítulos y mezcla.',
    icon: '🧩',
    links: [
      { label: 'Whisper (Transcriber)', href: '/docs/modules/transcriber' },
      { label: 'Argos (Translator)', href: '/docs/modules/translator' },
      { label: 'Piper (TTS Engine)', href: '/docs/modules/tts-engine' },
      { label: 'Subtitle Generator', href: '/docs/modules/subtitle-generator' },
      { label: 'Audio Mixer', href: '/docs/modules/audio-mixer' },
      { label: 'Video Muxer', href: '/docs/modules/video-muxer' },
    ],
  },
  {
    title: 'API Reference',
    description: 'Endpoints REST y mensajes WebSocket del servidor.',
    icon: '🔌',
    links: [
      { label: 'REST API', href: '/docs/api', desc: 'GET /api/status, POST /api/pipeline/start, etc.' },
      { label: 'WebSocket', href: '/docs/api/websocket', desc: 'Canal /ws para logs y eventos en tiempo real' },
    ],
  },
  {
    title: 'Guías',
    description: 'Tutoriales paso a paso para casos de uso comunes.',
    icon: '📘',
    links: [
      { label: 'Quick Start', href: '/docs/guides/quick-start' },
      { label: 'OBS Setup', href: '/docs/guides/obs-setup' },
      { label: 'Troubleshooting', href: '/docs/guides/troubleshooting' },
    ],
  },
];
---

<DocsLayout title="Inicio" description="Documentación de SRT2Web — pipeline de transcripción, traducción, TTS y subtitulado en tiempo real.">
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>
    </div>
    <div class="hero-content">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        <span>v0.x · Documentación</span>
      </div>
      <h1 class="hero-title">SRT2Web Docs</h1>
      <p class="hero-subtitle">
        Pipeline modular para transcripción, traducción, TTS y subtitulado en tiempo real
        sobre streams SRT, RTMP o archivos de video.
      </p>
      <div class="hero-actions">
        <a href="/docs/getting-started" class="btn btn-primary">
          Empezar →
        </a>
        <a href="/docs/api" class="btn btn-ghost">
          API Reference
        </a>
      </div>
      <div class="hero-stats">
        <div class="stat">
          <div class="stat-num">6</div>
          <div class="stat-label">Módulos</div>
        </div>
        <div class="stat">
          <div class="stat-num">~12s</div>
          <div class="stat-label">Latencia</div>
        </div>
        <div class="stat">
          <div class="stat-num">3</div>
          <div class="stat-label">Inputs</div>
        </div>
        <div class="stat">
          <div class="stat-num">5+</div>
          <div class="stat-label">Outputs</div>
        </div>
      </div>
    </div>
  </section>

  <section class="sections">
    {sections.map((section) => (
      <div class="section-card">
        <div class="section-header">
          <span class="section-icon" aria-hidden="true">{section.icon}</span>
          <div>
            <h2 class="section-title">{section.title}</h2>
            <p class="section-desc">{section.description}</p>
          </div>
        </div>
        <ul class="section-links">
          {section.links.map((link) => (
            <li>
              <a href={link.href} class="section-link">
                <span class="section-link-arrow" aria-hidden="true">→</span>
                <div>
                  <div class="section-link-label">{link.label}</div>
                  {link.desc && <div class="section-link-desc">{link.desc}</div>}
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <section class="quickstart">
    <h2 class="quickstart-title">Inicio rápido</h2>
    <pre class="codeblock"><code><span class="c-comment"># 1. Clonar e instalar</span>
<span class="c-cmd">git</span> clone https://github.com/your-org/srt2web.git
<span class="c-cmd">cd</span> srt2web
<span class="c-cmd">pip install</span> -r config/requirements.txt

<span class="c-comment"># 2. Iniciar el servidor</span>
<span class="c-cmd">python</span> main.py

<span class="c-comment"># 3. Abrir el dashboard</span>
<span class="c-output">→ http://localhost:9999</span></code></pre>
  </section>
</DocsLayout>

<style>
  .hero {
    position: relative;
    padding: 64px 0 48px;
    overflow: hidden;
    border-bottom: 1px solid var(--docs-border);
    margin-bottom: 48px;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.5;
  }

  .orb-1 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, #6366f1 0%, transparent 70%);
    top: -100px;
    right: -100px;
  }

  .orb-2 {
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, #a855f7 0%, transparent 70%);
    bottom: -80px;
    left: -80px;
    opacity: 0.4;
  }

  .orb-3 {
    width: 240px;
    height: 240px;
    background: radial-gradient(circle, #ec4899 0%, transparent 70%);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    opacity: 0.2;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 720px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 12px;
    background: var(--docs-card);
    border: 1px solid var(--docs-border);
    border-radius: 999px;
    font-size: 12px;
    color: var(--docs-text-sec);
    margin-bottom: 24px;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    background: var(--docs-success);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--docs-success);
  }

  .hero-title {
    font-size: 56px;
    font-weight: 800;
    line-height: 1.1;
    margin: 0 0 16px;
    background: linear-gradient(135deg, #fff 0%, #a855f7 60%, #6366f1 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    font-size: 18px;
    line-height: 1.6;
    color: var(--docs-text-sec);
    margin: 0 0 32px;
    max-width: 600px;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    margin-bottom: 48px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 20px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
    border: 1px solid transparent;
    cursor: pointer;
  }

  .btn-primary {
    background: var(--docs-accent);
    color: #fff;
  }

  .btn-primary:hover {
    background: var(--docs-accent-hover);
    transform: translateY(-1px);
  }

  .btn-ghost {
    background: var(--docs-card);
    color: var(--docs-text);
    border-color: var(--docs-border);
  }

  .btn-ghost:hover {
    background: var(--docs-card-hover);
    border-color: var(--docs-border-bright);
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    max-width: 560px;
  }

  .stat {
    padding: 16px;
    background: var(--docs-card);
    border: 1px solid var(--docs-border);
    border-radius: var(--docs-radius);
  }

  .stat-num {
    font-size: 24px;
    font-weight: 700;
    color: var(--docs-text);
    line-height: 1;
  }

  .stat-label {
    font-size: 11px;
    color: var(--docs-text-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 4px;
  }

  .sections {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-bottom: 48px;
  }

  @media (max-width: 800px) {
    .sections { grid-template-columns: 1fr; }
    .hero-title { font-size: 40px; }
    .hero-stats { grid-template-columns: repeat(2, 1fr); }
  }

  .section-card {
    padding: 24px;
    background: var(--docs-card);
    border: 1px solid var(--docs-border);
    border-radius: var(--docs-radius);
    transition: border-color 0.2s;
  }

  .section-card:hover {
    border-color: var(--docs-border-bright);
  }

  .section-header {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 20px;
  }

  .section-icon {
    font-size: 28px;
    line-height: 1;
    flex-shrink: 0;
  }

  .section-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--docs-text);
    margin: 0 0 4px;
  }

  .section-desc {
    font-size: 13px;
    color: var(--docs-text-sec);
    margin: 0;
  }

  .section-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .section-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 6px;
    color: var(--docs-text);
    text-decoration: none;
    font-size: 13px;
    transition: all 0.15s;
  }

  .section-link:hover {
    background: var(--docs-card-hover);
    color: var(--docs-accent);
  }

  .section-link-arrow {
    color: var(--docs-text-dim);
    transition: color 0.15s, transform 0.15s;
  }

  .section-link:hover .section-link-arrow {
    color: var(--docs-accent);
    transform: translateX(2px);
  }

  .section-link-label {
    font-weight: 500;
  }

  .section-link-desc {
    font-size: 11px;
    color: var(--docs-text-dim);
    margin-top: 2px;
  }

  .quickstart {
    padding: 32px;
    background: var(--docs-card);
    border: 1px solid var(--docs-border);
    border-radius: var(--docs-radius);
  }

  .quickstart-title {
    font-size: 16px;
    font-weight: 700;
    color: var(--docs-text);
    margin: 0 0 16px;
  }

  .codeblock {
    margin: 0;
    padding: 20px;
    background: var(--docs-code-bg);
    border: 1px solid var(--docs-border);
    border-radius: var(--docs-radius-sm);
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    line-height: 1.7;
    color: var(--docs-text);
    overflow-x: auto;
  }

  .c-comment { color: var(--docs-text-dim); }
  .c-cmd { color: #a855f7; }
  .c-output { color: var(--docs-success); }
</style>
