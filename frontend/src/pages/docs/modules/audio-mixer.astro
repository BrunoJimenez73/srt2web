---
import DocsLayout from '../../../components/docs/DocsLayout.astro';
import ConfigTable from '../../../components/docs/ConfigTable.astro';
import CodeBlock from '../../../components/docs/CodeBlock.astro';
import Callout from '../../../components/docs/Callout.astro';
---

<DocsLayout title="Audio Mixer Module" description="Mix original and dubbed audio with FFmpeg">
    <div class="breadcrumb">
        <a href="/docs/getting-started">Docs</a>
        <span class="breadcrumb-sep">/</span>
        <a href="/docs/modules">Modules</a>
        <span class="breadcrumb-sep">/</span>
        <span>Audio Mixer</span>
    </div>

    <div class="docs-hero">
        <h1>Audio Mixer</h1>
        <p>Mezcla audio original (con ducking) y audio TTS doblado usando FFmpeg.</p>
    </div>

    <h2>Descripción</h2>
    <p>El módulo Audio Mixer combina el audio original del stream con el audio TTS generado. El audio original se reduce de volumen (ducking) automáticamente para dar prioridad a la voz doblada.</p>

    <h2>Configuración</h2>

    <ConfigTable entries={[
        { path: "modules.audio_mixer.enabled", type: "boolean", default: "false", description: "Habilitar mezcla de audio." },
        { path: "modules.audio_mixer.original_volume", type: "float", default: "0.4", description: "Volumen del audio original (0.0 - 2.0)." },
        { path: "modules.audio_mixer.dubbed_volume", type: "float", default: "1.1", description: "Volumen del audio doblado (0.0 - 2.0)." },
        { path: "modules.audio_mixer.tts_volume", type: "float", default: "1.0", description: "Volumen del audio TTS (0.0 - 2.0)." },
    ]} />

    <h2>Dependencias</h2>

    <div class="dependency-flow">
        <h4>Habilita automáticamente:</h4>
        <p>Ninguno — es módulo terminal.</p>
        <h4>Requiere que esté habilitado:</h4>
        <p><code>translator</code> y <code>tts_engine</code></p>
    </div>

    <Callout type="warning">
        <strong>Orden de volumen:</strong> <code>dubbed_volume</code> debe ser mayor que <code>original_volume</code> para que el doblaje sea claramente audible.
    </Callout>

    <h2>Ejemplos</h2>

    <h3>Doblaje Balanceado</h3>
    <CodeBlock lang="yaml" code={`modules:
  audio_mixer:
    enabled: true
    original_volume: 0.3   # audio original reducido
    dubbed_volume: 1.0      # doblaje a volumen normal
    tts_volume: 1.0`} title="config.yaml" />

    <h3>Mezcla Equilibrada</h3>
    <CodeBlock lang="yaml" code={`modules:
  audio_mixer:
    enabled: true
    original_volume: 0.5   # 50% del original
    dubbed_volume: 0.8    # 80% del doblaje
    tts_volume: 1.0`} title="config.yaml" />

    <h2>Métricas</h2>
    <table>
        <thead><tr><th>Métrica</th><th>Descripción</th></tr></thead>
        <tbody>
            <tr><td><code>process_time</code></td><td>Tiempo de mezcla (ms)</td></tr>
            <tr><td><code>memory_usage</code></td><td>Memoria usada</td></tr>
            <tr><td><code>chunks_processed</code></td><td>Total de chunks mezclados</td></tr>
        </tbody>
    </table>

    <h2>Salida</h2>
    <CodeBlock lang="python" code={`{
    "mixed_audio_path": "./output/temp_mix/chunk_001.wav",
    "metadata": {
        "original_volume": 0.3,
        "dubbed_volume": 1.0,
        "tts_volume": 1.0
    }
}`} title="PipelineData" />

    <h2>Siguiente Módulo</h2>
    <p><a href="/docs/modules/video-muxer">Video Muxer</a> — Empaqueta todo en HLS.</p>
</DocsLayout>
