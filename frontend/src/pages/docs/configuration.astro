    <div>
      <h3 class="font-semibold mb-2">modules.subtitle_generator.use_translated</h3>
      <p class="text-sm text-sec mb-2">Si usar texto traducido para subtítulos</p>
      <p class="text-xs font-mono bg-bg-deep p-2 rounded">true</p>
      <p class="text-xs text-sec mt-1">Si false, usa texto original transcrito</p>
    </div>
    <div>
      <h3 class="font-semibold mb-2">modules.subtitle_generator.rolling_update</h3>
      <p class="text-sm text-sec mb-2">Actualizar subtítulos en tiempo real (rolling)</p>
      <p class="text-xs font-mono bg-bg-deep p-2 rounded">true</p>
    </div>
  </div>
</div>

<h2 class="text-xl font-semibold mb-4">🔊 Síntesis de Voz (TTS)</h2>
<div class="bg-bg-surface p-6 rounded-lg border border-border-dim mb-6">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
    <div>
      <h3 class="font-semibold mb-2">modules.tts_engine.voice</h3>
