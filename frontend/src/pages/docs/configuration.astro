      <p class="text-xs font-mono bg-bg-deep p-2 rounded">1.0</p>
      <p class="text-xs text-sec mt-1">Rango: 0.5 (lento) a 2.0 (rápido)</p>
    </div>
    <div>
      <h3 class="font-semibold mb-2">modules.tts_engine.volume</h3>
      <p class="text-sm text-sec mb-2">Volumen del audio TTS</p>
      <p class="text-xs font-mono bg-bg-deep p-2 rounded">0.7</p>
      <p class="text-xs text-sec mt-1">Rango: 0.0 a 2.0</p>
    </div>
  </div>
</div>

<h2 class="text-xl font-semibold mb-4">🎚️ Mezcla de Audio</h2>
<div class="bg-bg-surface p-6 rounded-lg border border-border-dim mb-6">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
    <div>
      <h3 class="font-semibold mb-2">modules.audio_mixer.original_volume</h3>
      <p class="text-sm text-sec mb-2">Volumen del audio original</p>
      <p class="text-xs font-mono bg-bg-deep p-2 rounded">0.3</p>
      <p class="text-xs text-sec mt-1">Reducido para dejar espacio al TTS</p>
    </div>
    <div>
      <h3 class="font-semibold mb-2">modules.audio_mixer.dubbed_volume</h3>
      <p class="text-sm text-sec mb-2">Volumen del audio doblado (TTS)</p>
      <p class="text-xs font-mono bg-bg-deep p-2 rounded">0.7</p>
    </div>
    <div>
      <h3 class="font-semibold mb-2">modules.audio_mixer.ducking_enabled</h3>
      <p class="text-sm text-sec mb-2">Activar ducking (atenuar original cuando hay TTS)</p>
      <p class="text-xs font-mono bg-bg-deep p-2 rounded">true</p>
    </div>
    <div>
      <h3 class="font-semibold mb-2">modules.audio_mixer.ducking_threshold</h3>
