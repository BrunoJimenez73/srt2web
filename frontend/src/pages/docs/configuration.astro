    </div>
    <div>
      <h3 class="font-semibold mb-2">modules.translator.target_lang</h3>
      <p class="text-sm text-sec mb-2">Código de idioma de destino</p>
      <p class="text-xs font-mono bg-bg-deep p-2 rounded">"en"</p>
    </div>
  </div>
</div>

<h2 class="text-xl font-semibold mb-4">📝 Generación de Subtítulos</h2>
<div class="bg-bg-surface p-6 rounded-lg border border-border-dim mb-6">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
    <div>
