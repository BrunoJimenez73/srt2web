---
---

<form class="input-card" id="card-input">
  <div class="process-header">
    <span class="process-indicator" id="indicator-input"></span>
    <span class="process-title">📥 INPUT</span>
    <span class="gpu-badge" id="input-gpu-badge" style="display: none;">GPU</span>
  </div>
  <div class="process-content">
    <div class="form-group">
      <label class="form-label">Tipo</label>
      <select class="form-select" id="input-type" onchange="window.handleInputTypeChange(this.value)">
        <option value="srt">SRT</option>
        <option value="rtmp">RTMP</option>
        <option value="file">File (Video local)</option>
      </select>
    </div>
    
    <!-- SRT Settings -->
    <div class="input-settings" id="srt-settings">
      <div class="form-group">
        <label class="form-label">Puerto SRT</label>
        <input type="number" class="form-input" id="input-srt-port" value="9000" min="1" max="65535" />
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Modo</label>
          <select class="form-select" id="input-srt-mode">
            <option value="listener">Listener</option>
            <option value="caller">Caller</option>
            <option value="rendezvous">Rendezvous</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Chunk (s)</label>
          <input type="number" class="form-input" id="input-chunk-duration" value="10" min="2" max="30" step="1" />
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Latencia (ms)</label>
        <input type="number" class="form-input" id="input-srt-latency" value="200" min="0" max="5000" step="10" />
      </div>
      <div class="form-group" id="input-caller-group" style="display: none;">
        <label class="form-label">Dirección Caller (si aplica)</label>
        <input type="text" class="form-input" id="input-srt-caller" placeholder="ip:puerto" />
      </div>
    </div>
    
    <!-- RTMP Settings -->
    <div class="input-settings" id="rtmp-settings" style="display: none;">
      <div class="form-group">
        <label class="form-label">URL RTMP</label>
        <input type="text" class="form-input" id="input-rtmp-url" placeholder="rtmp://server/live/stream" />
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Puerto</label>
          <input type="number" class="form-input" id="input-rtmp-port" value="1935" min="1" max="65535" />
        </div>
        <div class="form-group">
          <label class="form-label">Stream Key</label>
          <input type="text" class="form-input" id="input-rtmp-key" placeholder="stream" />
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Chunk (s)</label>
        <input type="number" class="form-input" id="input-rtmp-chunk" value="10" min="2" max="30" step="1" />
      </div>
    </div>
    
    <!-- File Settings -->
    <div class="input-settings" id="file-settings" style="display: none;">
      <div class="form-group">
        <label class="form-label">Archivo de Video</label>
        <div class="file-input-wrapper">
          <input type="text" class="form-input" id="input-file-path" placeholder="Ruta al archivo de video" readonly />
          <button type="button" class="file-button" onclick="document.getElementById('input-file-select').click()">📁</button>
          <input type="file" id="input-file-select" accept="video/*" style="display: none;" onchange="handleFileSelect(this)" />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Loop</label>
          <select class="form-select" id="input-file-loop">
            <option value="false">No</option>
            <option value="true">Sí</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Velocidad</label>
          <input type="number" class="form-input" id="input-file-speed" value="1.0" min="0.5" max="2.0" step="0.1" />
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Chunk (s)</label>
        <input type="number" class="form-input" id="input-file-chunk" value="10" min="2" max="30" step="1" />
      </div>
    </div>
    
    <!-- Metrics -->
    <div class="form-group" id="input-metrics">
      <label class="form-label">Métricas</label>
      <div class="metrics-row">
        <div class="metric-mini">
          <span class="metric-label">Tiempo</span>
          <span class="metric-value" id="module-time-input">--</span>
        </div>
        <div class="metric-mini">
          <span class="metric-label">Chunks</span>
          <span class="metric-value" id="module-chunks-input">--</span>
        </div>
      </div>
    </div>
  </div>
</form>

<style>
  .input-card {
    background: var(--bg-card);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-md);
    padding: 12px;
    transition: all 0.3s ease;
  }

  .input-card.active {
    border-color: var(--success) !important;
    box-shadow: 0 0 12px rgba(16, 185, 129, 0.3) !important;
  }

  .process-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }

  .process-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--text-dim);
    transition: all 0.3s ease;
  }

  .process-indicator.active {
    background: #00ff00 !important;
    box-shadow: 0 0 6px #00ff00, 0 0 12px #00ff00 !important;
    animation: indicator-pulse 1.5s ease-in-out infinite;
  }

  @keyframes indicator-pulse {
    0%, 100% { opacity: 0.8; }
    50% { opacity: 1; }
  }

  .process-title {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-prime);
  }

  .process-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .form-label {
    font-size: 10px;
    color: var(--text-sec);
    font-weight: 500;
  }

  .form-input, .form-select {
    width: 100%;
    padding: 8px 10px;
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-sm);
    color: var(--text-prime);
    font-size: 12px;
    outline: none;
    transition: border-color 0.2s;
  }

  .form-input:focus, .form-select:focus {
    border-color: var(--accent);
  }

  .form-select {
    cursor: pointer;
  }

  .file-input-wrapper {
    display: flex;
    gap: 4px;
    align-items: center;
  }

  .file-input-wrapper .form-input {
    flex: 1;
    border-radius: var(--radius-sm) 0 0 var(--radius-sm);
  }

  .file-button {
    background: var(--accent);
    color: white;
    border: 1px solid var(--accent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    padding: 8px 12px;
    cursor: pointer;
    font-size: 12px;
    transition: background-color 0.2s;
  }

  .file-button:hover {
    background: var(--accent-hover, var(--accent));
  }

  .input-settings {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .metrics-row {
    display: flex;
    gap: 12px;
    padding: 8px;
    background: var(--bg-surface);
    border-radius: var(--radius-sm);
  }

  .metric-mini {
    flex: 1;
    text-align: center;
  }

  .metric-mini .metric-label {
    display: block;
    font-size: 9px;
    color: var(--text-sec);
    margin-bottom: 2px;
  }

  .metric-mini .metric-value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    color: var(--text-prime);
  }
</style>

<script>
  // Expose functions to window
  window.handleInputTypeChange = function(type: string) {
    console.log('handleInputTypeChange called with:', type);
    
    // Hide all settings
    const srtSettings = document.getElementById('srt-settings');
    const rtmpSettings = document.getElementById('rtmp-settings');
    const fileSettings = document.getElementById('file-settings');
    
    if (srtSettings) srtSettings.style.display = 'none';
    if (rtmpSettings) rtmpSettings.style.display = 'none';
    if (fileSettings) fileSettings.style.display = 'none';
    
    // Show caller field only for SRT caller/rendezvous modes
    const callerGroup = document.getElementById('input-caller-group');
    const srtMode = document.getElementById('input-srt-mode') as HTMLSelectElement;
    
    // Show appropriate settings
    if (type === 'srt') {
      if (srtSettings) srtSettings.style.display = 'flex';
      if (srtMode) {
        const showCaller = srtMode.value === 'caller' || srtMode.value === 'rendezvous';
        if (callerGroup) callerGroup.style.display = showCaller ? 'flex' : 'none';
      }
    } else if (type === 'rtmp') {
      if (rtmpSettings) rtmpSettings.style.display = 'flex';
    } else if (type === 'file') {
      if (fileSettings) fileSettings.style.display = 'flex';
    }
  };

  window.handleFileSelect = function(input: HTMLInputElement) {
    const file = input.files?.[0];
    if (file) {
      const pathInput = document.getElementById('input-file-path') as HTMLInputElement;
      if (pathInput) {
        pathInput.value = file.name;
        pathInput.dataset.filePath = file.name;
        pathInput.dataset.fileSize = String(file.size);
        pathInput.dataset.fileType = file.type;
      }
    }
  };

  // Initialize immediately and on load
  function initInputCard() {
    const typeSelect = document.getElementById('input-type') as HTMLSelectElement;
    if (typeSelect) {
      window.handleInputTypeChange(typeSelect.value);
    }
    
    const srtMode = document.getElementById('input-srt-mode') as HTMLSelectElement;
    if (srtMode) {
      srtMode.addEventListener('change', () => {
        const typeSelect = document.getElementById('input-type') as HTMLSelectElement;
        if (typeSelect?.value === 'srt') {
          window.handleInputTypeChange('srt');
        }
      });
    }
  }

  // Try to initialize now
  initInputCard();
  // Also on load as fallback
  window.addEventListener('load', initInputCard);
</script>
