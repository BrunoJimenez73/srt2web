---
---

<form class="input-card" id="card-input">
  <div class="process-header">
    <span class="process-indicator" id="indicator-input"></span>
    <span class="process-title">📥 INPUT</span>
    <span class="gpu-badge" id="input-gpu-badge" style="display: none;">GPU</span>
  </div>
  <div class="process-content">
    <div class="form-group">
      <label class="form-label">Tipo</label>
      <select class="form-select" id="input-type" onchange="window.handleInputTypeChange(this.value)">
        <option value="srt">SRT</option>
        <option value="rtmp">RTMP</option>
        <option value="file">File (Video local)</option>
      </select>
    </div>
    
    <!-- SRT Settings -->
    <div class="input-settings" id="srt-settings">
      <div class="form-group">
        <label class="form-label">Puerto SRT</label>
        <input type="number" class="form-input" id="input-srt-port" value="9000" min="1" max="65535" />
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Modo</label>
          <select class="form-select" id="input-srt-mode">
            <option value="listener">Listener</option>
            <option value="caller">Caller</option>
            <option value="rendezvous">Rendezvous</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Chunk (s)</label>
          <input type="number" class="form-input" id="input-chunk-duration" value="10" min="2" max="30" step="1" />
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Latencia (ms)</label>
        <input type="number" class="form-input" id="input-srt-latency" value="200" min="0" max="5000" step="10" />
      </div>
      <div class="form-group" id="input-caller-group" style="display: none;">
        <label class="form-label">Dirección Caller (si aplica)</label>
        <input type="text" class="form-input" id="input-srt-caller" placeholder="ip:puerto" />
      </div>
    </div>
    
    <!-- RTMP Settings -->
    <div class="input-settings" id="rtmp-settings" style="display: none;">
      <div class="form-group">
        <label class="form-label">URL RTMP</label>
        <input type="text" class="form-input" id="input-rtmp-url" placeholder="rtmp://server/live/stream" />
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Puerto</label>
          <input type="number" class="form-input" id="input-rtmp-port" value="1935" min="1" max="65535" />
        </div>
        <div class="form-group">
          <label class="form-label">Stream Key</label>
          <input type="text" class="form-input" id="input-rtmp-key" placeholder="stream" />
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Chunk (s)</label>
        <input type="number" class="form-input" id="input-rtmp-chunk" value="10" min="2" max="30" step="1" />
      </div>
    </div>
    
    <!-- File Settings -->
    <div class="input-settings" id="file-settings" style="display: none;">
      <div class="form-group">
        <label class="form-label">Archivo de Video</label>
        <div class="file-input-wrapper">
          <input type="text" class="form-input" id="input-file-path" placeholder="Ruta al archivo de video" readonly />
          <button type="button" class="file-button" onclick="document.getElementById('input-file-select').click()">📁</button>
          <input type="file" id="input-file-select" accept="video/*" style="display: none;" onchange="handleFileSelect(this)" />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Loop</label>
          <select class="form-select" id="input-file-loop">
            <option value="false">No</option>
            <option value="true">Sí</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Velocidad</label>
          <input type="number" class="form-input" id="input-file-speed" value="1.0" min="0.5" max="2.0" step="0.1" />
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Chunk (s)</label>
        <input type="number" class="form-input" id="input-file-chunk" value="10" min="2" max="30" step="1" />
      </div>
    </div>
    
    <!-- Metrics -->
    <div class="form-group" id="input-metrics">
      <label class="form-label">Métricas</label>
      <div class="metrics-row">
        <div class="metric-mini">
          <span class="metric-label">Tiempo</span>
          <span class="metric-value" id="module-time-input">--</span>
        </div>
        <div class="metric-mini">
          <span class="metric-label">Chunks</span>
          <span class="metric-value" id="module-chunks-input">--</span>
        </div>
      </div>
    </div>
  </div>
</form>
