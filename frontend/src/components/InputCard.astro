---
import { t, initLanguage } from "../lib/i18n";
initLanguage();
---

<form class="input-card" id="card-input">
    <div class="process-header">
      <span class="process-indicator" id="indicator-input"></span>
      <span class="process-title" id="input-process-title">📥 {t("input")}</span>
      <span class="gpu-badge" id="gpu-badge-input" style="display: none;" role="status" aria-label="Estado GPU">GPU</span>
    </div>
  <div class="process-content">
    <div class="form-group">
      <label class="form-label" for="input-type">{t("type")}</label>
      <select class="form-select" id="input-type" aria-describedby="input-type-desc">
        <option value="srt">SRT</option>
        <option value="rtmp">RTMP</option>
        <option value="file">{t("file_input")}</option>
      </select>
    </div>

    <!-- SRT Settings -->
    <div class="input-settings" id="input-srt-settings">
      <div class="form-group">
        <label class="form-label" for="input-srt-port">{t("srt_port")}</label>
        <input type="number" class="form-input" id="input-srt-port" value="9000" min="1" max="65535" />
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="input-srt-mode">{t("mode")}</label>
          <select class="form-select" id="input-srt-mode">
            <option value="listener">{t("listener")}</option>
            <option value="caller">{t("caller")}</option>
            <option value="rendezvous">{t("rendezvous")}</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="input-chunk-duration">{t("chunk")}</label>
          <input type="number" class="form-input" id="input-chunk-duration" value="10" min="2" max="60" step="1" />
        </div>
      </div>
      <div class="form-group">
        <label class="form-label" for="input-srt-latency">{t("latency_ms")}</label>
        <input type="number" class="form-input" id="input-srt-latency" value="200" min="0" max="5000" step="10" />
      </div>
      <div class="form-group" id="input-caller-group" style="display: none;">
        <label class="form-label" for="input-srt-caller">{t("caller_address")}</label>
        <input type="text" class="form-input" id="input-srt-caller" placeholder='ip:{t("port")}' />
      </div>
    </div>

<!-- RTMP Settings -->
    <div class="input-settings" id="input-rtmp-settings" style="display: none;">
      <div class="form-group">
        <label class="form-label" for="input-rtmp-url">{t("obs_url")}</label>
        <div class="copy-input-wrapper">
          <input type="text" class="form-input" id="input-rtmp-url" readonly placeholder="rtmp://127.0.0.1:1935/live/stream" />
          <button type="button" class="copy-button" id="btn-copy-rtmp" aria-label="Copiar URL">📋</button>
        </div>
      </div>
       <div class="form-row">
         <div class="form-group">
            <label class="form-label" for="input-rtmp-port">{t("port")}</label>
           <input type="number" class="form-input" id="input-rtmp-port" value="1935" min="1" max="65535" />
         </div>
         <div class="form-group">
            <label class="form-label" for="input-rtmp-app">{t("app")}</label>
            <input type="text" class="form-input" id="input-rtmp-app" value="live" />
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="input-rtmp-key">{t("stream_key")}</label>
           <input type="text" class="form-input" id="input-rtmp-key" placeholder="stream" />
         </div>
         <div class="form-group">
            <label class="form-label" for="input-rtmp-chunk">{t("chunk")}</label>
           <input type="number" class="form-input" id="input-rtmp-chunk" value="2" min="1" max="30" step="1" />
         </div>
       </div>
    </div>

    <!-- File Settings -->
    <div class="input-settings" id="input-file-settings" style="display: none;">
      <div class="form-group">
        <label class="form-label" for="input-file-path">{t("video_file_path")}</label>
        <div class="file-input-wrapper">
          <input type="text" class="form-input" id="input-file-path" placeholder="C:\Users\bruno\Desktop\video.mp4" />
          <button type="button" class="file-button" id="btn-file-select" aria-label={t("select_file")}>📁</button>
          <input type="file" id="input-file-select" accept="video/*" style="display: none;" />
        </div>
        <small class="form-hint">{t("file_hint")}</small>
      </div>

      <!-- File Player Controls -->
      <div class="file-player-controls" id="file-player-controls" style="display: none;">
        <div class="player-buttons">
          <button type="button" class="player-btn" id="btn-file-play" aria-label={t("play")}>▶</button>
          <button type="button" class="player-btn" id="btn-file-pause" aria-label={t("pause")} style="display: none;">⏸</button>
          <button type="button" class="player-btn" id="btn-file-restart" aria-label={t("restart")}>⏮</button>
        </div>
        <div class="player-slider">
          <input type="range" class="player-range" id="input-file-position" min="0" max="100" value="0" />
          <span class="player-time" id="file-time-current">0:00</span>
          <span class="player-time-sep">/</span>
          <span class="player-time" id="file-time-total">0:00</span>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="input-file-loop">{t("loop")}</label>
          <select class="form-select" id="input-file-loop">
            <option value="false">{t("no")}</option>
            <option value="true">{t("yes")}</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="input-file-speed">{t("speed")}</label>
          <input type="number" class="form-input" id="input-file-speed" value="1.0" min="0.5" max="2.0" step="0.1" />
        </div>
      </div>
      <div class="form-group">
        <label class="form-label" for="input-file-chunk">{t("chunk")}</label>
        <input type="number" class="form-input" id="input-file-chunk" value="2" min="1" max="30" step="1" />
      </div>
    </div>

    <!-- Metrics -->
    <div class="form-group" id="input-metrics">
      <label class="form-label">{t("metrics")}</label>
      <div class="metrics-row">
        <div class="metric-mini">
          <span class="metric-label">{t("time")}</span>
          <span class="metric-value" id="module-time-input">--</span>
        </div>
        <div class="metric-mini">
          <span class="metric-label">{t("chunks")}</span>
          <span class="metric-value" id="module-chunks-input">--</span>
        </div>
        <div class="metric-mini">
          <span class="metric-label">{t("encoder")}</span>
          <span class="metric-value" id="module-encoder-input">--</span>
        </div>
      </div>
    </div>
  </div>
</form>

<style>
  .input-card {
    background: var(--bg-card);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-md);
    padding: 12px;
    transition: all 0.3s ease;
  }

  .input-card.active {
    border-color: var(--success) !important;
    box-shadow: 0 0 12px rgba(16, 185, 129, 0.3) !important;
  }

  .process-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }

  .process-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--text-dim);
    transition: all 0.3s ease;
  }

  .process-indicator.active {
    background: #00ff00 !important;
    box-shadow: 0 0 6px #00ff00, 0 0 12px #00ff00 !important;
    animation: indicator-pulse 1.5s ease-in-out infinite;
  }

  @keyframes indicator-pulse {
    0%, 100% { opacity: 0.8; }
    50% { opacity: 1; }
  }

  .process-title {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-prime);
    flex: 1;
  }

  .process-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .form-label {
    font-size: 10px;
    color: var(--text-sec);
    font-weight: 500;
  }

  .form-input, .form-select {
    width: 100%;
    padding: 8px 10px;
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-sm);
    color: var(--text-prime);
    font-size: 12px;
    outline: none;
    transition: border-color 0.2s;
  }

  .form-input:focus, .form-select:focus {
    border-color: var(--accent);
  }

  .form-select {
    cursor: pointer;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .input-settings {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .file-input-wrapper {
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .copy-input-wrapper {
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .copy-input-wrapper input {
    flex: 1;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    background: var(--bg-surface);
    color: var(--success);
    font-weight: 600;
  }

  .copy-button {
    background: var(--bg-card);
    border: 1px solid var(--success);
    border-radius: var(--radius-sm);
    padding: 8px;
    cursor: pointer;
    font-size: 14px;
    transition: all 0.2s;
  }

  .copy-button:hover {
    background: var(--success);
    color: var(--bg-surface);
  }

  .file-button {
    background: var(--bg-card);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-sm);
    padding: 8px;
    cursor: pointer;
    font-size: 14px;
    transition: all 0.2s;
  }

  .file-button:hover {
    background: var(--border-dim);
  }

  .metrics-row {
    display: flex;
    gap: 12px;
    padding: 8px;
    background: var(--bg-surface);
    border-radius: var(--radius-sm);
  }

  .metric-mini {
    flex: 1;
    text-align: center;
  }

  .metric-mini .metric-label {
    display: block;
    font-size: 9px;
    color: var(--text-sec);
    margin-bottom: 2px;
  }

  .metric-mini .metric-value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    color: var(--text-prime);
  }

  .gpu-badge {
    background: var(--text-dim);
    color: var(--text-sec);
    font-size: 8px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
  }

  .gpu-badge.active {
    background: linear-gradient(135deg, #76b900, #a8e600);
    color: #000;
  }

  .file-player-controls {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px;
    background: var(--bg-surface);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-dim);
  }

  .player-buttons {
    display: flex;
    gap: 8px;
    justify-content: center;
  }

  .player-btn {
    background: var(--bg-card);
    border: 1px solid var(--accent);
    border-radius: var(--radius-sm);
    padding: 8px 16px;
    cursor: pointer;
    font-size: 14px;
    transition: all 0.2s;
  }

  .player-btn:hover {
    background: var(--accent);
    color: var(--bg-surface);
  }

  .player-slider {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .player-range {
    flex: 1;
    height: 4px;
    -webkit-appearance: none;
    background: var(--border-dim);
    border-radius: 2px;
    outline: none;
  }

  .player-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 12px;
    height: 12px;
    background: var(--accent);
    border-radius: 50%;
    cursor: pointer;
  }

  .player-time {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: var(--text-sec);
  }

  .player-time-sep {
    color: var(--text-dim);
  }
</style>

<script>
  import { initInputCard } from "../lib/components/input-card";
  document.addEventListener("DOMContentLoaded", initInputCard);
</script>
