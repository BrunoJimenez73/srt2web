---
---

<form class="input-card" id="card-input">
    <div class="process-header">
      <span class="process-indicator" id="indicator-input"></span>
      <span class="process-title" id="input-process-title">📥 INPUT</span>
      <span class="gpu-badge" id="input-gpu-badge" style="display: none;" role="status" aria-label="Estado GPU">GPU</span>
    </div>
  <div class="process-content">
    <div class="form-group">
      <label class="form-label" for="input-type">Tipo</label>
      <select class="form-select" id="input-type" onchange="window.handleInputTypeChange(this.value)" aria-describedby="input-type-desc">
        <option value="srt">SRT</option>
        <option value="rtmp">RTMP</option>
        <option value="file">File (Video local)</option>
      </select>
    </div>
    
    <!-- SRT Settings -->
    <div class="input-settings" id="input-srt-settings">
      <div class="form-group">
        <label class="form-label" for="input-srt-port">Puerto SRT</label>
        <input type="number" class="form-input" id="input-srt-port" value="9000" min="1" max="65535" />
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="input-srt-mode">Modo</label>
          <select class="form-select" id="input-srt-mode">
            <option value="listener">Listener</option>
            <option value="caller">Caller</option>
            <option value="rendezvous">Rendezvous</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="input-chunk-duration">Chunk (s)</label>
          <input type="number" class="form-input" id="input-chunk-duration" value="2" min="1" max="30" step="1" />
        </div>
      </div>
      <div class="form-group">
        <label class="form-label" for="input-srt-latency">Latencia (ms)</label>
        <input type="number" class="form-input" id="input-srt-latency" value="200" min="0" max="5000" step="10" />
      </div>
      <div class="form-group" id="input-caller-group" style="display: none;">
        <label class="form-label" for="input-srt-caller">Dirección Caller (si aplica)</label>
        <input type="text" class="form-input" id="input-srt-caller" placeholder="ip:puerto" />
      </div>
    </div>
    
<!-- RTMP Settings -->
    <div class="input-settings" id="input-rtmp-settings" style="display: none;">
      <div class="form-group">
        <label class="form-label" for="input-rtmp-url">URL para OBS (RTMP Listen)</label>
        <div class="copy-input-wrapper">
          <input type="text" class="form-input" id="input-rtmp-url" readonly placeholder="rtmp://127.0.0.1:1935/live/stream" />
          <button type="button" class="copy-button" onclick="copyRtmpUrl()" aria-label="Copiar URL">📋</button>
        </div>
      </div>
       <div class="form-row">
         <div class="form-group">
           <label class="form-label" for="input-rtmp-port">Puerto</label>
           <input type="number" class="form-input" id="input-rtmp-port" value="1935" min="1" max="65535" onchange="updateRtmpUrl()" />
         </div>
         <div class="form-group">
           <label class="form-label" for="input-rtmp-app">App</label>
           <input type="text" class="form-input" id="input-rtmp-app" value="live" onchange="updateRtmpUrl()" />
         </div>
       </div>
       <div class="form-row">
         <div class="form-group">
           <label class="form-label" for="input-rtmp-key">Stream Key</label>
           <input type="text" class="form-input" id="input-rtmp-key" placeholder="stream" onchange="updateRtmpUrl()" />
         </div>
         <div class="form-group">
           <label class="form-label" for="input-rtmp-chunk">Chunk (s)</label>
           <input type="number" class="form-input" id="input-rtmp-chunk" value="2" min="1" max="30" step="1" />
         </div>
       </div>
    </div>
    
    <!-- File Settings -->
    <div class="input-settings" id="input-file-settings" style="display: none;">
      <div class="form-group">
        <label class="form-label" for="input-file-path">Archivo de Video (ruta completa)</label>
        <div class="file-input-wrapper">
          <input type="text" class="form-input" id="input-file-path" placeholder="C:\Users\bruno\Desktop\video.mp4" />
          <button type="button" class="file-button" onclick="document.getElementById('input-file-select').click()" aria-label="Seleccionar archivo">📁</button>
          <input type="file" id="input-file-select" accept="video/*" style="display: none;" onchange="handleFileSelect(this)" />
        </div>
        <small class="form-hint">Selecciona un archivo o escribe la ruta completa manualmente</small>
      </div>
      
      <!-- File Player Controls -->
      <div class="file-player-controls" id="file-player-controls" style="display: none;">
        <div class="player-buttons">
          <button type="button" class="player-btn" id="btn-file-play" aria-label="Reproducir">▶</button>
          <button type="button" class="player-btn" id="btn-file-pause" aria-label="Pausar" style="display: none;">⏸</button>
          <button type="button" class="player-btn" id="btn-file-restart" aria-label="Reiniciar">⏮</button>
        </div>
        <div class="player-slider">
          <input type="range" class="player-range" id="input-file-position" min="0" max="100" value="0" />
          <span class="player-time" id="file-time-current">0:00</span>
          <span class="player-time-sep">/</span>
          <span class="player-time" id="file-time-total">0:00</span>
        </div>
      </div>
      
      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="input-file-loop">Loop</label>
          <select class="form-select" id="input-file-loop">
            <option value="false">No</option>
            <option value="true">Sí</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="input-file-speed">Velocidad</label>
          <input type="number" class="form-input" id="input-file-speed" value="1.0" min="0.5" max="2.0" step="0.1" />
        </div>
      </div>
      <div class="form-group">
        <label class="form-label" for="input-file-chunk">Chunk (s)</label>
        <input type="number" class="form-input" id="input-file-chunk" value="2" min="1" max="30" step="1" />
      </div>
    </div>
    
    <!-- Metrics -->
    <div class="form-group" id="input-metrics">
      <label class="form-label">Métricas</label>
      <div class="metrics-row">
        <div class="metric-mini">
          <span class="metric-label">Tiempo</span>
          <span class="metric-value" id="module-time-input">--</span>
        </div>
        <div class="metric-mini">
          <span class="metric-label">Chunks</span>
          <span class="metric-value" id="module-chunks-input">--</span>
        </div>
        <div class="metric-mini">
          <span class="metric-label">Encoder</span>
          <span class="metric-value" id="module-encoder-input">--</span>
        </div>
      </div>
    </div>
  </div>
</form>

<style>
  .input-card {
    background: var(--bg-card);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-md);
    padding: 12px;
    transition: all 0.3s ease;
  }

  .input-card.active {
    border-color: var(--success) !important;
    box-shadow: 0 0 12px rgba(16, 185, 129, 0.3) !important;
  }

  .process-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }

  .process-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--text-dim);
    transition: all 0.3s ease;
  }

  .process-indicator.active {
    background: #00ff00 !important;
    box-shadow: 0 0 6px #00ff00, 0 0 12px #00ff00 !important;
    animation: indicator-pulse 1.5s ease-in-out infinite;
  }

  @keyframes indicator-pulse {
    0%, 100% { opacity: 0.8; }
    50% { opacity: 1; }
  }

  .process-title {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-prime);
    flex: 1;
  }

  .process-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .form-label {
    font-size: 10px;
    color: var(--text-sec);
    font-weight: 500;
  }

  .form-input, .form-select {
    width: 100%;
    padding: 8px 10px;
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-sm);
    color: var(--text-prime);
    font-size: 12px;
    outline: none;
    transition: border-color 0.2s;
  }

  .form-input:focus, .form-select:focus {
    border-color: var(--accent);
  }

  .form-select {
    cursor: pointer;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .input-settings {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .file-input-wrapper {
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .copy-input-wrapper {
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .copy-input-wrapper input {
    flex: 1;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    background: var(--bg-surface);
    color: var(--success);
    font-weight: 600;
  }

  .copy-button {
    background: var(--bg-card);
    border: 1px solid var(--success);
    border-radius: var(--radius-sm);
    padding: 8px;
    cursor: pointer;
    font-size: 14px;
    transition: all 0.2s;
  }

  .copy-button:hover {
    background: var(--success);
    color: var(--bg-surface);
  }

  .file-button {
    background: var(--bg-card);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-sm);
    padding: 8px;
    cursor: pointer;
    font-size: 14px;
    transition: all 0.2s;
  }

  .file-button:hover {
    background: var(--border-dim);
  }

  .metrics-row {
    display: flex;
    gap: 12px;
    padding: 8px;
    background: var(--bg-surface);
    border-radius: var(--radius-sm);
  }

  .metric-mini {
    flex: 1;
    text-align: center;
  }

  .metric-mini .metric-label {
    display: block;
    font-size: 9px;
    color: var(--text-sec);
    margin-bottom: 2px;
  }

  .metric-mini .metric-value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    color: var(--text-prime);
  }

  .gpu-badge {
    background: var(--text-dim);
    color: var(--text-sec);
    font-size: 8px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
  }

  .gpu-badge.active {
    background: linear-gradient(135deg, #76b900, #a8e600);
    color: #000;
  }

  .file-player-controls {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px;
    background: var(--bg-surface);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-dim);
  }

  .player-buttons {
    display: flex;
    gap: 8px;
    justify-content: center;
  }

  .player-btn {
    background: var(--bg-card);
    border: 1px solid var(--accent);
    border-radius: var(--radius-sm);
    padding: 8px 16px;
    cursor: pointer;
    font-size: 14px;
    transition: all 0.2s;
  }

  .player-btn:hover {
    background: var(--accent);
    color: var(--bg-surface);
  }

  .player-slider {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .player-range {
    flex: 1;
    height: 4px;
    -webkit-appearance: none;
    background: var(--border-dim);
    border-radius: 2px;
    outline: none;
  }

  .player-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 12px;
    height: 12px;
    background: var(--accent);
    border-radius: 50%;
    cursor: pointer;
  }

  .player-time {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: var(--text-sec);
  }

  .player-time-sep {
    color: var(--text-dim);
  }
</style>