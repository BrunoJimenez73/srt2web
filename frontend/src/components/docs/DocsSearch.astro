<div class="docs-search">
    <button class="search-trigger" id="search-trigger">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <span>Search docs...</span>
        <kbd>⌘K</kbd>
    </button>
</div>

<div class="search-modal" id="search-modal">
    <div class="search-overlay" id="search-overlay"></div>
    <div class="search-dialog">
        <div class="search-header">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input type="text" id="search-input" placeholder="Search documentation..." autocomplete="off">
            <kbd>ESC</kbd>
        </div>
        <div class="search-results" id="search-results">
            <p class="search-hint">Start typing to search...</p>
        </div>
    </div>
</div>

<script>
    const trigger = document.getElementById('search-trigger');
    const modal = document.getElementById('search-modal');
    const overlay = document.getElementById('search-overlay');
    const input = document.getElementById('search-input') as HTMLInputElement;
    const results = document.getElementById('search-results');

    let pagefind: any = null;
    let pagefindLoading = false;
    let pagefindLoadTimeout: NodeJS.Timeout | null = null;

    async function loadPagefind() {
        if (pagefind || pagefindLoading) return;
        
        pagefindLoading = true;
        
        // Set a timeout to prevent the page from hanging
        pagefindLoadTimeout = setTimeout(() => {
            if (pagefindLoading && !pagefind) {
                pagefindLoading = false;
                if (results) {
                    results.innerHTML = '<p class="search-hint">Search index loading timeout. Please try again.</p>';
                }
            }
        }, 5000); // 5 second timeout

        try {
            const pf = '/docs/pagefind/pagefind.js';
            pagefind = await import(/* @vite-ignore */ pf);
            await pagefind.init();
            
            // Clear timeout if successful
            if (pagefindLoadTimeout) {
                clearTimeout(pagefindLoadTimeout);
                pagefindLoadTimeout = null;
            }
            pagefindLoading = false;
        } catch (e) {
            // Clear timeout on error
            if (pagefindLoadTimeout) {
                clearTimeout(pagefindLoadTimeout);
                pagefindLoadTimeout = null;
            }
            pagefindLoading = false;
            
            console.warn('Failed to load pagefind:', e);
            if (results) {
                results.innerHTML = '<p class="search-hint">Search index not available. Run npm run build first.</p>';
            }
        }
    }

    function openModal() {
        modal?.classList.add('open');
        input?.focus();
        loadPagefind();
    }

    function closeModal() {
        modal?.classList.remove('open');
        if (input) input.value = '';
        if (results) results.innerHTML = '<p class="search-hint">Start typing to search...</p>';
    }

    trigger?.addEventListener('click', openModal);
    overlay?.addEventListener('click', closeModal);

    document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
            e.preventDefault();
            openModal();
        }
        if (e.key === 'Escape') closeModal();
    });

    input?.addEventListener('input', async (e) => {
        const query = (e.target as HTMLInputElement).value.trim();
        if (!query || !pagefind) {
            if (results) {
                results.innerHTML = '<p class="search-hint">Start typing to search...</p>';
            }
            return;
        }

        try {
            const search = await pagefind.search(query);
            if (search.results.length === 0) {
                if (results) {
                    results.innerHTML = '<p class="search-hint">No results found.</p>';
                }
                return;
            }

            const items = await Promise.all(search.results.slice(0, 10).map(async (r: any) => {
                const data = await r.data();
                return `<a href="${data.url}" class="search-result-item">
                    <span class="search-result-title">${data.meta?.title || 'Untitled'}</span>
                    <span class="search-result-excerpt">${data.excerpt}</span>
                </a>`;
            }));

            if (results) {
                results.innerHTML = items.join('');
            }
            results?.querySelectorAll('.search-result-item').forEach(item => {
                item.addEventListener('click', closeModal);
            });
        } catch (error) {
            console.warn('Search error:', error);
            if (results) {
                results.innerHTML = '<p class="search-hint">Search error. Please try again.</p>';
            }
        }
    });
</script>
