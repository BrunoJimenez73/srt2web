---
import InputCard from './InputCard.astro';
import WhisperCard from './WhisperCard.astro';
import TranslateCard from './TranslateCard.astro';
import TtsCard from './TtsCard.astro';
import SubtitleCard from './SubtitleCard.astro';
import AudioMixerCard from './AudioMixerCard.astro';
import HlsCard from './HlsCard.astro';
import OutputCard from './OutputCard.astro';
---

<div class="process-grid" role="region" aria-label="Módulos de procesamiento">
  <InputCard />
  <WhisperCard />
  <TranslateCard />
  <TtsCard />
  <SubtitleCard />
  <AudioMixerCard />
  <HlsCard />
  <OutputCard />
</div>
<style>
  .process-grid {
    display: grid;
    /* F186: CSS grid guarantees every card in a row has the SAME width.
       flex-wrap produced irregular rows (4 / 3 / 1 loose card). */
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 12px;
    margin-bottom: 16px;
  }

  @media (max-width: 640px) {
    .process-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ================================
     COLLAPSIBLE CARD PATTERN (vMix-like)
     ================================ */
  .collapsible-card {
    position: relative;
  }

  .collapsible-card .process-header {
    cursor: pointer;
    user-select: none;
    border-radius: var(--radius-sm);
  }

  .collapsible-card .process-header:hover {
    background: var(--bg-surface);
  }

  .collapse-chevron {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    color: var(--text-sec);
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    transition: transform 0.2s ease;
    transform: rotate(90deg);
  }

  .collapsible-card.collapsed .collapse-chevron {
    transform: rotate(0deg);
  }

  .collapsible-card.collapsed .process-content {
    display: none !important;
  }
</style>

<script>
  // Collapsible cards: apply to all cards that are direct children of .process-grid
  function initCollapsibleCards() {
    const grid = document.querySelector('.process-grid');
    if (!grid) return;

    const cards = grid.querySelectorAll(':scope > .collapsible-card');
    for (const card of cards) {
      const header = card.querySelector('.process-header');
      if (!header) continue;

      // Check if header already has a chevron, add one if not
      let chevron = header.querySelector('.collapse-chevron');
      if (!chevron) {
        chevron = document.createElement('span');
        chevron.className = 'collapse-chevron';
        chevron.setAttribute('aria-hidden', 'true');
        chevron.textContent = '▶';
        header.insertBefore(chevron, header.firstChild);
      }

      header.addEventListener('click', (e) => {
        // Don't collapse if clicking a toggle, button, select, input, or link
        const target = e.target as HTMLElement;
        if (target.closest('label') || target.closest('button') || target.closest('select') ||
            target.closest('input') || target.closest('a') || target.closest('.toggle-switch') ||
            target.closest('.gpu-badge') || target.closest('.sync-badge') ||
            target.closest('.btn-copy-small') || target.closest('.btn')) {
          return;
        }
        card.classList.toggle('collapsed');
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCollapsibleCards);
  } else {
    initCollapsibleCards();
  }

  import { effect } from "@preact/signals-core";
  import { pipelineStatus, isPipelineRunning, throughputAvg } from "../lib/store/signals";

  function el<T extends HTMLElement>(id: string): T | null {
    return document.getElementById(id) as T | null;
  }

  effect(() => {
    const status = pipelineStatus.value;
    const modules = status?.modules ?? [];
    const running = isPipelineRunning.value;
    const tpAvg = throughputAvg.value;
    const moduleMap = Object.fromEntries(modules.map(m => [m.name, m])) as Record<string, typeof modules[number]>;

     // Module names to map to DOM indicators and metrics
    const moduleEntries = [
      { name: "input", indicator: "indicator-input", status: "status-input", badge: "gpu-badge-input", timeId: "module-time-input", chunksId: "module-chunks-input", encoderId: "module-encoder-input" },
      { name: "audio_extractor", indicator: "indicator-audio-extractor", status: "status-audio_extractor", badge: "gpu-badge-audio_extractor", timeId: "module-time-audio_extractor", chunksId: "module-chunks-audio_extractor", encoderId: "module-encoder-audio_extractor" },
      { name: "transcriber", indicator: "indicator-whisper", status: "status-transcriber", badge: "gpu-badge-transcriber", timeId: "module-time-transcriber", chunksId: "module-chunks-transcriber", encoderId: "module-encoder-transcriber" },
      { name: "translator", indicator: "indicator-translate", status: "status-translator", badge: null, timeId: "module-time-translator", chunksId: "module-chunks-translator", encoderId: "module-encoder-translator" },
      { name: "tts_engine", indicator: "indicator-tts", status: "status-tts_engine", badge: "gpu-badge-tts_engine", timeId: "module-time-tts_engine", chunksId: "module-chunks-tts_engine", encoderId: "module-encoder-tts_engine" },
      { name: "subtitle_generator", indicator: "indicator-subtitle", status: "status-subtitle_generator", badge: "gpu-badge-subtitle_generator", timeId: "module-time-subtitle_generator", chunksId: "module-chunks-subtitle_generator", encoderId: "module-encoder-subtitle_generator" },
      { name: "audio_mixer", indicator: "indicator-audio-mixer", status: "status-audio_mixer", badge: "gpu-badge-audio_mixer", timeId: "module-time-audio_mixer", chunksId: "module-chunks-audio_mixer", encoderId: "module-encoder-audio_mixer" },
      { name: "video_muxer", indicator: "indicator-video-muxer", status: "status-video_muxer", badge: "gpu-badge-video_muxer", timeId: "module-time-video_muxer", chunksId: "module-chunks-video_muxer", encoderId: "module-encoder-video_muxer" },
      { name: "output", indicator: "indicator-output", status: "status-output", badge: "gpu-badge-output", timeId: "module-time-output", chunksId: "module-chunks-output", encoderId: "module-encoder-output" },
    ];

    for (const entry of moduleEntries) {
      // F186: moduleMap keys match module names 1:1. The previous
      // `replace("_", "\\_")` produced "audio\\_extractor" — never a
      // real key — so every badge/indicator silently stayed off.
      const mod = moduleMap[entry.name];

      // Indicators (green dot)
      const ind = el<HTMLSpanElement>(entry.indicator);
      if (ind) {
        const isActive = running && mod?.enabled;
        ind.classList.toggle("active", isActive && mod?.state !== "degraded");
        ind.classList.toggle("degraded", mod?.state === "degraded");
      }

      // Status dots (in module cards)
      const dot = el<HTMLSpanElement>(entry.status);
      if (dot && mod) {
        dot.className = "status-dot";
        dot.classList.toggle("running", mod.state === "running");
        dot.classList.toggle("error", mod.state === "error");
        dot.classList.toggle("degraded", mod.state === "degraded");
        dot.classList.toggle("disabled", !mod.enabled);
      }

      // GPU badges
      const badge = el<HTMLSpanElement>(entry.badge);
      if (badge && mod?.extra) {
        const processing = running && mod.enabled && (mod.processed_chunks ?? 0) > 0;
        if (mod.extra.using_gpu) {
          badge.textContent = mod.extra.device === "mps" ? "MPS" : "GPU";
          badge.style.display = "inline";
          badge.classList.toggle("active", processing);
        } else if (mod.extra.encoder_mode === "passthrough") {
          badge.textContent = "Directo";
          badge.style.display = "inline";
          badge.classList.remove("active");
        } else {
          badge.textContent = "CPU";
          badge.style.display = "inline";
          badge.classList.remove("active");
        }
      }

      // Time
      const timeEl = el<HTMLSpanElement>(entry.timeId);
      if (timeEl && mod) {
        if (mod.last_process_time_ms > 0) {
          const ms = mod.last_process_time_ms;
          timeEl.textContent = ms < 1000 ? `${Math.round(ms)}ms` : `${(ms / 1000).toFixed(1)}s`;
        } else if (running && tpAvg > 0) {
          timeEl.textContent = `${(1000 / tpAvg).toFixed(0)}ms`;
        } else if (mod.state === "error") {
          timeEl.textContent = "ERROR";
          (timeEl as HTMLElement).style.color = "var(--error)";
        } else {
          timeEl.textContent = mod.enabled ? "--" : "OFF";
        }
      }

      // Chunks
      const chunksEl = el<HTMLSpanElement>(entry.chunksId);
      if (chunksEl && mod) chunksEl.textContent = String(mod.processed_chunks ?? 0);

      // Encoder
      const encoderEl = el<HTMLSpanElement>(entry.encoderId);
      if (encoderEl && mod?.extra) {
        const deviceLabel = mod.extra.device === "mps" ? "MPS" : mod.extra.using_gpu ? "GPU" : mod.extra.encoder_mode === "passthrough" ? "Directo" : "CPU";
        encoderEl.textContent = mod.extra.encoder_label || deviceLabel || "--";
      }
    }
  });
</script>
