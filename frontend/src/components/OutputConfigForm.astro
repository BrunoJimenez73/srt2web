---
import { getAuthToken, getWebSocketUrl } from '../lib/api';
import type { AnyOutputConfig } from '../lib/types';

interface Props {
  onAddOutput: (config: AnyOutputConfig) => void;
}

const { onAddOutput } = Astro.props;

let wsUrl = getWebSocketUrl('logs');
let authToken = getAuthToken();

// Estado del formulario
let outputType = 'web';
let outputName = '';
let url = 'srt://localhost:9001';
let mode = 'caller';
let latency = '200';
let streamId = '';
let passphrase = '';
let videoBitrate = '2500k';
let audioBitrate = '128k';
let videoCodec = 'h264';
let preset = 'medium';
let audioCodec = 'aac';
let saveVideo = true;
let saveAudio = true;
let saveSubtitles = true;
let path = './output';
let segmentDuration = '4';
let listSize = '6';
let audioOffset = '0';
let encoderMode = 'auto';

// Recording specific
let recordingPath = './output/recording.mp4';
let recordingFormat = 'mp4';
let recordingCodec = 'copy';
let recordingQualityMode = 'cbr';
let recordingVideoCrf = '23';
let recordingAudioCodec = 'copy';
let recordingSplitMode = 'none';
let recordingSplitValue = '600';
let recordingSubtitles = 'none';
let recordingPreset = 'fast';

// Manejadores de eventos
const handleAddOutput = () => {
  const config = {
    type: outputType,
    name: outputName || generateOutputName(outputType),
    ...(outputType === 'srt' && {
      url,
      mode,
      latency_ms: parseInt(latency),
      stream_id: streamId,
      passphrase,
      video_bitrate: videoBitrate,
      audio_bitrate: audioBitrate,
      video_codec: videoCodec,
      preset,
      audio_codec: audioCodec
    }),
    ...(outputType === 'file' && {
      save_video: saveVideo,
      save_audio: saveAudio,
      save_subtitles: saveSubtitles,
      path
    }),
    ...(outputType === 'rtmp' && {
      url,
      video_bitrate: videoBitrate,
      audio_bitrate: audioBitrate,
      video_codec: videoCodec,
      preset,
      audio_codec: audioCodec,
      encoder_mode: encoderMode
    }),
    ...(outputType === 'web' && {
      segment_duration: parseInt(segmentDuration),
      list_size: parseInt(listSize),
      audio_offset_ms: parseInt(audioOffset),
      encoder_mode: encoderMode
    }),
    ...(outputType === 'recording' && {
      output_path: recordingPath,
      format: recordingFormat,
      codec: recordingCodec,
      quality_mode: recordingQualityMode,
      video_bitrate: videoBitrate,
      video_crf: parseInt(recordingVideoCrf),
      audio_codec: recordingAudioCodec,
      audio_bitrate: audioBitrate,
      split_mode: recordingSplitMode,
      split_value: recordingSplitMode !== 'none' ? parseInt(recordingSplitValue) : undefined,
      subtitles: recordingSubtitles,
      video_preset: recordingPreset
    })
  };

  onAddOutput(config);

  // Limpiar formulario
  outputName = '';
  url = outputType === 'srt' ? 'srt://localhost:9001' : 'rtmp://localhost/live/stream';
  mode = 'caller';
  latency = '200';
  streamId = '';
  passphrase = '';
  videoBitrate = '2500k';
  audioBitrate = '128k';
  videoCodec = 'h264';
  preset = 'medium';
  audioCodec = 'aac';
  saveVideo = true;
  saveAudio = true;
  saveSubtitles = true;
  path = './output';
  segmentDuration = '4';
  listSize = '6';
  audioOffset = '0';
  encoderMode = 'auto';
};

const generateOutputName = (type: string) => {
  const baseName = type === 'srt' ? 'srt_output' : type === 'file' ? 'file_output' : type === 'rtmp' ? 'rtmp_output' : type === 'recording' ? 'recording' : 'web_output';
  return baseName;
};

const handleTypeChange = (e: Event) => {
  outputType = (e.target as HTMLSelectElement).value;
  // Resetear valores por defecto según el tipo
  if (outputType === 'srt') {
    url = 'srt://localhost:9001';
    mode = 'caller';
    latency = '200';
    streamId = '';
    passphrase = '';
    videoBitrate = '2500k';
    audioBitrate = '128k';
    videoCodec = 'h264';
    preset = 'medium';
    audioCodec = 'aac';
  } else if (outputType === 'file') {
    url = '';
    saveVideo = true;
    saveAudio = true;
    saveSubtitles = true;
    path = './output';
  } else if (outputType === 'rtmp') {
    url = 'rtmp://localhost/live/stream';
    videoBitrate = '2500k';
    audioBitrate = '128k';
    videoCodec = 'h264';
    preset = 'medium';
    audioCodec = 'aac';
    encoderMode = 'auto';
  } else if (outputType === 'web') {
    url = '';
    segmentDuration = '4';
    listSize = '6';
    audioOffset = '0';
    encoderMode = 'auto';
  } else if (outputType === 'recording') {
    recordingPath = './output/recording.mp4';
    recordingFormat = 'mp4';
    recordingCodec = 'copy';
    recordingQualityMode = 'cbr';
    recordingVideoCrf = '23';
    recordingAudioCodec = 'copy';
    recordingSplitMode = 'none';
    recordingSplitValue = '600';
    recordingSubtitles = 'none';
    recordingPreset = 'fast';
  }
};
---
<div class="bg-white rounded-lg border border-gray-200 p-4">
  <h4 class="font-medium text-gray-900 mb-3">Añadir Nueva Salida</h4>

  <div class="space-y-4">
    <!-- Tipo de salida -->
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Tipo de Salida</label>
      <select
        class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
        value={outputType}
        onchange={handleTypeChange}
      >
        <option value="web">Web/HLS (Player)</option>
        <option value="recording">Grabación (Recording)</option>
        <option value="srt">SRT</option>
        <option value="rtmp">RTMP</option>
        <option value="file">Archivo (Chunks)</option>
      </select>
    </div>

    <!-- Nombre de la salida -->
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Nombre (opcional)</label>
      <input
        type="text"
        class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
        value={outputName}
        oninput={(e) => outputName = (e.target as HTMLInputElement).value}
        placeholder={generateOutputName(outputType)}
      />
    </div>

    <!-- Campos específicos por tipo -->
    {outputType === 'srt' && (
      <div class="space-y-3">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">URL</label>
          <input
            type="text"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            value={url}
            oninput={(e) => url = (e.target as HTMLInputElement).value}
            placeholder="srt://localhost:9001"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Modo</label>
          <select
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            value={mode}
            oninput={(e) => mode = (e.target as HTMLSelectElement).value}
          >
            <option value="caller">Caller</option>
            <option value="listener">Listener</option>
            <option value="rendezvous">Rendezvous</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Latencia (ms)</label>
          <input
            type="number"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            value={latency}
            oninput={(e) => latency = (e.target as HTMLInputElement).value}
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Stream ID</label>
          <input
            type="text"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            value={streamId}
            oninput={(e) => streamId = (e.target as HTMLInputElement).value}
            placeholder="Opcional"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Contraseña</label>
          <input
            type="text"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            value={passphrase}
            oninput={(e) => passphrase = (e.target as HTMLInputElement).value}
            placeholder="Opcional"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Video Bitrate</label>
          <input
            type="text"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            value={videoBitrate}
            oninput={(e) => videoBitrate = (e.target as HTMLInputElement).value}
            placeholder="2500k"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Audio Bitrate</label>
          <input
            type="text"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            value={audioBitrate}
            oninput={(e) => audioBitrate = (e.target as HTMLInputElement).value}
            placeholder="128k"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Video Codec</label>
          <input
            type="text"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            value={videoCodec}
            oninput={(e) => videoCodec = (e.target as HTMLInputElement).value}
            placeholder="h264"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Preset</label>
          <input
            type="text"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            value={preset}
            oninput={(e) => preset = (e.target as HTMLInputElement).value}
            placeholder="medium"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Audio Codec</label>
          <input
            type="text"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            value={audioCodec}
            oninput={(e) => audioCodec = (e.target as HTMLInputElement).value}
            placeholder="aac"
          />
        </div>
      </div>
    )}

    {outputType === 'file' && (
      <div class="space-y-3">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Guardar Video</label>
          <input
            type="checkbox"
            checked={saveVideo}
            onchange={(e) => saveVideo = (e.target as HTMLInputElement).checked}
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Guardar Audio</label>
          <input
            type="checkbox"
            checked={saveAudio}
            onchange={(e) => saveAudio = (e.target as HTMLInputElement).checked}
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Guardar Subtítulos</label>
          <input
            type="checkbox"
            checked={saveSubtitles}
            onchange={(e) => saveSubtitles = (e.target as HTMLInputElement).checked}
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Directorio</label>
          <input
            type="text"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            value={path}
            oninput={(e) => path = (e.target as HTMLInputElement).value}
            placeholder="./output"
          />
        </div>
      </div>
    )}

    {outputType === 'rtmp' && (
      <div class="space-y-3">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">URL</label>
          <input
            type="text"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            value={url}
            oninput={(e) => url = (e.target as HTMLInputElement).value}
            placeholder="rtmp://localhost/live/stream"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Video Bitrate</label>
          <input
            type="text"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            value={videoBitrate}
            oninput={(e) => videoBitrate = (e.target as HTMLInputElement).value}
            placeholder="2500k"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Audio Bitrate</label>
          <input
            type="text"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            value={audioBitrate}
            oninput={(e) => audioBitrate = (e.target as HTMLInputElement).value}
            placeholder="128k"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Video Codec</label>
          <input
            type="text"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            value={videoCodec}
            oninput={(e) => videoCodec = (e.target as HTMLInputElement).value}
            placeholder="h264"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Preset</label>
          <input
            type="text"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            value={preset}
            oninput={(e) => preset = (e.target as HTMLInputElement).value}
            placeholder="medium"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Audio Codec</label>
          <input
            type="text"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            value={audioCodec}
            oninput={(e) => audioCodec = (e.target as HTMLInputElement).value}
            placeholder="aac"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Encoder Mode</label>
          <select
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            value={encoderMode}
            oninput={(e) => encoderMode = (e.target as HTMLSelectElement).value}
          >
            <option value="auto">Auto</option>
            <option value="cpu">CPU</option>
            <option value="gpu_nvenc">GPU NVENC</option>
            <option value="gpu_vaapi">GPU VAAPI</option>
          </select>
        </div>
      </div>
    )}

    {outputType === 'web' && (
      <div class="space-y-3">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Segment Duration (s)</label>
          <input
            type="number"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            value={segmentDuration}
            oninput={(e) => segmentDuration = (e.target as HTMLInputElement).value}
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">List Size</label>
          <input
            type="number"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            value={listSize}
            oninput={(e) => listSize = (e.target as HTMLInputElement).value}
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Audio Offset (ms)</label>
          <input
            type="number"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            value={audioOffset}
            oninput={(e) => audioOffset = (e.target as HTMLInputElement).value}
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Encoder Mode</label>
          <select
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            value={encoderMode}
            oninput={(e) => encoderMode = (e.target as HTMLSelectElement).value}
          >
            <option value="auto">Auto</option>
            <option value="cpu">CPU</option>
            <option value="gpu_nvenc">GPU NVENC</option>
            <option value="gpu_vaapi">GPU VAAPI</option>
          </select>
        </div>
      </div>
    )}

    {outputType === 'recording' && (
      <div class="space-y-3">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Archivo de Salida</label>
          <input type="text" class="w-full px-3 py-2 border border-gray-300 rounded-md"
            value={recordingPath} oninput={(e) => recordingPath = (e.target as HTMLInputElement).value}
            placeholder="./output/recording.mp4" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Formato</label>
          <select class="w-full px-3 py-2 border border-gray-300 rounded-md"
            value={recordingFormat} oninput={(e) => recordingFormat = (e.target as HTMLSelectElement).value}>
            <option value="mp4">MP4</option>
            <option value="mkv">MKV</option>
            <option value="webm">WebM</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Codec de Video</label>
          <select class="w-full px-3 py-2 border border-gray-300 rounded-md"
            value={recordingCodec} oninput={(e) => recordingCodec = (e.target as HTMLSelectElement).value}>
            <option value="copy">Copiar (Sin re-encoding)</option>
            <option value="h264_nvenc">NVIDIA H.264</option>
            <option value="h265_nvenc">NVIDIA H.265</option>
            <option value="libx264">CPU H.264</option>
          </select>
        </div>
        {recordingCodec !== 'copy' && (
          <>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Modo de Calidad</label>
              <select class="w-full px-3 py-2 border border-gray-300 rounded-md"
                value={recordingQualityMode} oninput={(e) => recordingQualityMode = (e.target as HTMLSelectElement).value}>
                <option value="cbr">CBR (Bitrate constante)</option>
                <option value="crf">CRF (Calidad constante)</option>
              </select>
            </div>
            {recordingQualityMode === 'cbr' ? (
              <div><label class="block text-sm font-medium text-gray-700 mb-1">Video Bitrate</label>
              <input type="text" class="w-full px-3 py-2 border border-gray-300 rounded-md"
                value={videoBitrate} oninput={(e) => videoBitrate = (e.target as HTMLInputElement).value} placeholder="5000k" /></div>
            ) : (
              <div><label class="block text-sm font-medium text-gray-700 mb-1">CRF (18=mejor, 28=peor)</label>
              <input type="number" class="w-full px-3 py-2 border border-gray-300 rounded-md"
                value={recordingVideoCrf} oninput={(e) => recordingVideoCrf = (e.target as HTMLInputElement).value} min="18" max="28" /></div>
            )}
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Preset</label>
              <select class="w-full px-3 py-2 border border-gray-300 rounded-md"
                value={recordingPreset} oninput={(e) => recordingPreset = (e.target as HTMLSelectElement).value}>
                <option value="fast">Fast</option>
                <option value="medium">Medium</option>
                <option value="slow">Slow</option>
              </select>
            </div>
          </>
        )}
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Codec de Audio</label>
          <select class="w-full px-3 py-2 border border-gray-300 rounded-md"
            value={recordingAudioCodec} oninput={(e) => recordingAudioCodec = (e.target as HTMLSelectElement).value}>
            <option value="copy">Copiar</option>
            <option value="aac">AAC</option>
            <option value="opus">Opus</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Dividir Archivo</label>
          <select class="w-full px-3 py-2 border border-gray-300 rounded-md"
            value={recordingSplitMode} oninput={(e) => recordingSplitMode = (e.target as HTMLSelectElement).value}>
            <option value="none">Sin dividir</option>
            <option value="time">Por tiempo</option>
            <option value="size">Por tamaño</option>
          </select>
        </div>
        {recordingSplitMode !== 'none' && (
          <div><label class="block text-sm font-medium text-gray-700 mb-1">{recordingSplitMode === 'time' ? 'Minutos' : 'MB'}</label>
          <input type="number" class="w-full px-3 py-2 border border-gray-300 rounded-md"
            value={recordingSplitValue} oninput={(e) => recordingSplitValue = (e.target as HTMLInputElement).value} min="1" /></div>
        )}
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Subtítulos</label>
          <select class="w-full px-3 py-2 border border-gray-300 rounded-md"
            value={recordingSubtitles} oninput={(e) => recordingSubtitles = (e.target as HTMLSelectElement).value}>
            <option value="none">Sin subtítulos</option>
            <option value="burnt">Incustrados en video</option>
            <option value="vtt">Archivo VTT</option>
          </select>
        </div>
      </div>
    )}

    <div class="mt-4 flex justify-end space-x-3">
      <button
        onclick={handleAddOutput}
        class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
      >
        Añadir Salida
      </button>
      <button
        type="button"
        onclick={() => {
          outputName = '';
          url = outputType === 'srt' ? 'srt://localhost:9001' : 'rtmp://localhost/live/stream';
          mode = 'caller';
          latency = '200';
          streamId = '';
          passphrase = '';
          videoBitrate = '2500k';
          audioBitrate = '128k';
          videoCodec = 'h264';
          preset = 'medium';
          audioCodec = 'aac';
          saveVideo = true;
          saveAudio = true;
          saveSubtitles = true;
          path = './output';
          segmentDuration = '4';
          listSize = '6';
          audioOffset = '0';
          encoderMode = 'auto';
          recordingPath = './output/recording.mp4';
          recordingFormat = 'mp4';
          recordingCodec = 'copy';
          recordingQualityMode = 'cbr';
          recordingVideoCrf = '23';
          recordingAudioCodec = 'copy';
          recordingSplitMode = 'none';
          recordingSplitValue = '600';
          recordingSubtitles = 'none';
          recordingPreset = 'fast';
        }}
        class="px-4 py-2 text-gray-700 rounded-md hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2"
      >
        Limpiar
      </button>
    </div>
  </div>
</div>
