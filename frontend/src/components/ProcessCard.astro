---
interface Props {
  id: string;
  icon: string;
  title: string;
  hasToggle?: boolean;
  disabled?: boolean;
}

const { id, icon, title, hasToggle = false, disabled = false } = Astro.props;
---

<div class:list={["process-card", { disabled }]} id={`card-${id}`}>
    <div class="process-header">
        <span class="process-indicator" id={`indicator-${id}`}></span>
        <span class="process-title">{icon} {title}</span>
        {hasToggle && (
            <label class="toggle-switch">
                <input type="checkbox" id={`${id}-enabled`} />
                <span class="toggle-slider"></span>
            </label>
        )}
    </div>
    <div id={`${id}-settings`} class="process-settings">
        <slot />
    </div>
</div>

<style>
    /* Styles moved to BaseLayout.astro for global scope */
</style>