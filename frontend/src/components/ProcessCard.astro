---
interface Props {
  id: string;
  icon: string;
  title: string;
  hasToggle?: boolean;
  disabled?: boolean;
}

const { id, icon, title, hasToggle = false, disabled = false } = Astro.props;
---

<div class:list={["process-card", { disabled }]} id={`card-${id}`}>
    <div class="process-header">
        <span class="process-indicator" id={`indicator-${id}`}></span>
        <span class="process-title">{icon} {title}</span>
        {hasToggle && (
            <label class="toggle-switch">
                <input type="checkbox" id={`${id}-enabled`} />
                <span class="toggle-slider"></span>
            </label>
        )}
    </div>
    <div id={`${id}-settings`} class="process-settings">
        <slot />
    </div>
</div>

<style>
    .process-card {
        background: var(--bg-card);
        border: 1px solid var(--border-dim);
        border-radius: var(--radius-md);
        padding: 12px;
        transition: all 0.3s ease;
    }

    .process-card.disabled {
        opacity: 0.5;
    }

    .process-card.active {
        border-color: var(--success);
        box-shadow: 0 0 12px rgba(16, 185, 129, 0.2);
    }

    .process-header {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 10px;
    }

    .process-indicator {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--text-dim);
        transition: all 0.3s ease;
    }

    .process-indicator.active {
        background: #00ff00;
        box-shadow: 0 0 6px #00ff00, 0 0 12px #00ff00, 0 0 18px #00ff00;
        animation: indicator-pulse 1.5s ease-in-out infinite;
    }

    .process-title {
        font-size: 11px;
        font-weight: 600;
        color: var(--text-prime);
        flex: 1;
    }

    .process-settings {
        opacity: 1;
        transition: opacity 0.3s ease;
    }

    .process-card.disabled .process-settings {
        opacity: 0.5;
    }

    /* Toggle Switch */
    .toggle-switch {
        position: relative;
        display: inline-block;
        width: 36px;
        height: 20px;
    }

    .toggle-switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .toggle-slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: var(--text-dim);
        transition: 0.3s;
        border-radius: 20px;
    }

    .toggle-slider:before {
        position: absolute;
        content: "";
        height: 14px;
        width: 14px;
        left: 3px;
        bottom: 3px;
        background-color: white;
        transition: 0.3s;
        border-radius: 50%;
    }

    input:checked + .toggle-slider {
        background-color: var(--success);
    }

    input:checked + .toggle-slider:before {
        transform: translateX(16px);
    }

    /* Form Elements */
    .form-group {
        margin-bottom: 8px;
    }

    .form-label {
        display: block;
        font-size: 10px;
        color: var(--text-sec);
        margin-bottom: 4px;
        font-weight: 500;
    }

    .form-input, .form-select {
        width: 100%;
        padding: 8px 10px;
        background: var(--bg-surface);
        border: 1px solid var(--border-dim);
        border-radius: var(--radius-sm);
        color: var(--text-prime);
        font-size: 12px;
        outline: none;
        transition: border-color 0.2s;
    }

    .form-input:focus, .form-select:focus {
        border-color: var(--accent);
    }

    .form-select {
        cursor: pointer;
    }
</style>