---
---

<div class="video-muxer-card collapsible-card" id="card-video-muxer">
  <div class="process-header">
    <span class="process-indicator" id="indicator-video-muxer"></span>
    <span class="process-title">📦 VIDEO MUXER</span>
    <span class="gpu-badge" id="gpu-badge-video_muxer" style="display: none;" role="status" aria-label="Aceleración GPU">GPU</span>
    <label class="toggle-switch" aria-label="Activar/desactivar video muxer">
      <input type="checkbox" id="muxer-enabled" onchange="window.toggleModule('video_muxer', this.checked)" />
      <span class="toggle-slider"></span>
    </label>
  </div>
  <div class="process-content">
    <!-- Motor selector -->
    <div class="form-group">
      <label class="form-label" for="video-muxer-engine">Motor</label>
      <select class="form-select" id="video-muxer-engine" onchange="window.handleEngineChange(this.value)">
        <option value="hls">HLS (Compatible)</option>
        <option value="webrtc">WebRTC (Baja latencia)</option>
      </select>
    </div>

    <!-- HLS Settings -->
    <div class="hls-settings">
      <div class="form-group">
        <label class="form-label" for="hls-encoder">Encoder</label>
        <select class="form-select" id="hls-encoder" onchange="window.updateVideoMuxerConfig()">
          <option value="auto">Auto (GPU/CPU)</option>
          <option value="cpu">CPU (libx264)</option>
          <option value="gpu_nvenc">NVIDIA NVENC</option>
          <option value="gpu_amf">AMD AMF</option>
          <option value="gpu_qsv">Intel QSV</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label" id="hls-crf-label">CRF: <span id="hls-crf-value">18</span></label>
        <input type="range" class="form-range" id="hls-crf" min="0" max="51" value="18"
                aria-labelledby="hls-crf-label"
                oninput="document.getElementById('hls-crf-value').textContent = this.value; window.updateVideoMuxerConfig();" />
      </div>
      <div class="form-group">
        <label class="form-label" for="hls-audio-offset">Offset audio (ms)</label>
        <input type="number" class="form-input" id="hls-audio-offset" value="0" onchange="window.updateVideoMuxerConfig()" />
      </div>
      <div class="form-group">
        <label class="form-label" for="hls-audio-codec">Audio Codec</label>
        <select class="form-select" id="hls-audio-codec" onchange="window.updateVideoMuxerConfig()">
          <option value="aac">AAC</option>
          <option value="opus">Opus</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label" for="hls-audio-bitrate">Bitrate</label>
        <select class="form-select" id="hls-audio-bitrate" onchange="window.updateVideoMuxerConfig()">
          <option value="64k">64 kbps</option>
          <option value="96k">96 kbps</option>
          <option value="128k">128 kbps</option>
          <option value="192k">192 kbps</option>
          <option value="256k">256 kbps</option>
          <option value="320k">320 kbps</option>
        </select>
      </div>
    </div>

     <!-- WebRTC Settings -->
     <div class="webrtc-settings">
       <div class="form-group">
         <label class="form-label" for="webrtc-encoder">Encoder</label>
         <select class="form-select" id="webrtc-encoder" onchange="window.updateWebRTCConfig()">
           <option value="auto">Auto (GPU/CPU)</option>
           <option value="cpu">CPU (libx264)</option>
           <option value="gpu_nvenc">NVIDIA NVENC</option>
           <option value="gpu_amf">AMD AMF</option>
           <option value="gpu_qsv">Intel QSV</option>
         </select>
       </div>
       <div class="form-group">
         <label class="form-label" for="webrtc-video-codec">Video Codec</label>
         <select class="form-select" id="webrtc-video-codec" onchange="window.updateWebRTCConfig()">
           <option value="h264">H.264 (NVENC soportado)</option>
           <option value="vp8">VP8</option>
           <option value="vp9">VP9</option>
         </select>
       </div>
      <div class="form-group">
        <label class="form-label" for="webrtc-video-bitrate">Video Bitrate</label>
        <select class="form-select" id="webrtc-video-bitrate" onchange="window.updateWebRTCConfig()">
          <option value="500k">500 kbps</option>
          <option value="1000k">1000 kbps</option>
          <option value="2000k">2000 kbps</option>
          <option value="4000k">4000 kbps</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label" for="webrtc-video-resolution">Video Resolution</label>
        <select class="form-select" id="webrtc-video-resolution" onchange="window.updateWebRTCConfig()">
          <option value="320x240">320x240</option>
          <option value="640x480">640x480</option>
          <option value="1280x720">1280x720</option>
          <option value="1920x1080">1920x1080</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label" for="webrtc-video-fps">Video FPS</label>
        <select class="form-select" id="webrtc-video-fps" onchange="window.updateWebRTCConfig()">
          <option value="15">15 fps</option>
          <option value="24">24 fps</option>
          <option value="30">30 fps</option>
          <option value="60">60 fps</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label" for="webrtc-audio-codec">Audio Codec</label>
        <select class="form-select" id="webrtc-audio-codec" onchange="window.updateWebRTCConfig()">
          <option value="opus">Opus</option>
          <option value="vorbis">Vorbis</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label" for="webrtc-audio-bitrate">Audio Bitrate</label>
        <select class="form-select" id="webrtc-audio-bitrate" onchange="window.updateWebRTCConfig()">
          <option value="32k">32 kbps</option>
          <option value="64k">64 kbps</option>
          <option value="96k">96 kbps</option>
          <option value="128k">128 kbps</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label" for="webrtc-audio-sample-rate">Audio Sample Rate</label>
        <select class="form-select" id="webrtc-audio-sample-rate" onchange="window.updateWebRTCConfig()">
          <option value="24000">24 kHz</option>
          <option value="48000">48 kHz</option>
        </select>
      </div>
    </div>

    <!-- Metrics -->
    <div class="form-group" id="video-muxer-metrics">
      <label class="form-label">Métricas</label>
      <div class="metrics-row">
        <div class="metric-mini">
          <span class="metric-label">Tiempo</span>
          <span class="metric-value" id="module-time-video_muxer">--</span>
        </div>
        <div class="metric-mini">
          <span class="metric-label">Memoria</span>
          <span class="metric-value" id="module-memory-video_muxer">--</span>
        </div>
        <div class="metric-mini">
          <span class="metric-label">Chunks</span>
          <span class="metric-value" id="module-chunks-video_muxer">--</span>
        </div>
        <div class="metric-mini">
          <span class="metric-label">Encoder</span>
          <span class="metric-value" id="module-encoder-video_muxer">--</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .video-muxer-card {
    background: var(--bg-card);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-md);
    padding: 12px;
    transition: all 0.3s ease;
  }

  .video-muxer-card.active {
    border-color: var(--success) !important;
    box-shadow: 0 0 12px rgba(16, 185, 129, 0.3) !important;
  }

  .process-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }

  .process-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--text-dim);
    transition: all 0.3s ease;
  }

  .process-indicator.active {
    background: #00ff00 !important;
    box-shadow: 0 0 6px #00ff00, 0 0 12px #00ff00 !important;
    animation: indicator-pulse 1.5s ease-in-out infinite;
  }

  @keyframes indicator-pulse {
    0%, 100% { opacity: 0.8; }
    50% { opacity: 1; }
  }

  .process-title {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-prime);
    flex: 1;
  }

  .toggle-switch {
    position: relative;
    display: inline-block;
    width: 36px;
    height: 20px;
  }

  .toggle-switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .toggle-slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--text-dim);
    transition: 0.3s;
    border-radius: 20px;
  }

  .toggle-slider:before {
    position: absolute;
    content: "";
    height: 14px;
    width: 14px;
    left: 3px;
    bottom: 3px;
    background-color: white;
    transition: 0.3s;
    border-radius: 50%;
  }

  input:checked + .toggle-slider {
    background-color: var(--success);
  }

  input:checked + .toggle-slider:before {
    transform: translateX(16px);
  }

  .process-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .form-label {
    font-size: 10px;
    color: var(--text-sec);
    font-weight: 500;
  }

  .form-input, .form-select {
    width: 100%;
    padding: 8px 10px;
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-sm);
    color: var(--text-prime);
    font-size: 12px;
    outline: none;
  }

  .form-input:focus, .form-select:focus {
    border-color: var(--accent);
  }

  .form-select {
    cursor: pointer;
  }

  .form-range {
    width: 100%;
    height: 6px;
    -webkit-appearance: none;
    background: var(--bg-surface);
    border-radius: 3px;
    outline: none;
  }

  .form-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 16px;
    height: 16px;
    background: var(--accent);
    border-radius: 50%;
    cursor: pointer;
  }

  .metrics-row {
    display: flex;
    gap: 12px;
    padding: 8px;
    background: var(--bg-surface);
    border-radius: var(--radius-sm);
  }

  .metric-mini {
    flex: 1;
    text-align: center;
  }

  .metric-mini .metric-label {
    display: block;
    font-size: 9px;
    color: var(--text-sec);
    margin-bottom: 2px;
  }

  .metric-mini .metric-value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    color: var(--text-prime);
  }

  .gpu-badge {
    background: var(--text-dim);
    color: var(--text-sec);
    font-size: 8px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
  }

  .gpu-badge.active {
    background: linear-gradient(135deg, #76b900, #a8e600);
    color: #000;
  }

  .hls-settings {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .webrtc-settings {
    display: none;
    flex-direction: column;
    gap: 8px;
    padding: 12px;
    background: var(--bg-surface);
    border-radius: var(--radius-sm);
    border: 1px dashed var(--border-dim);
  }

  .webrtc-settings p {
    font-size: 11px;
    color: var(--text-sec);
    text-align: center;
    margin: 0;
  }
</style>

<script>
  // Expose engine change handler to window
  window.handleEngineChange = function(engine: string) {
    const hlsSettings = document.querySelector('.hls-settings') as HTMLElement;
    const webrtcSettings = document.querySelector('.webrtc-settings') as HTMLElement;

    if (engine === 'hls') {
      if (hlsSettings) hlsSettings.style.display = 'flex';
      if (webrtcSettings) webrtcSettings.style.display = 'none';
    } else if (engine === 'webrtc') {
      if (hlsSettings) hlsSettings.style.display = 'none';
      if (webrtcSettings) webrtcSettings.style.display = 'flex';
    }
  };

  // Update WebRTC settings when individual controls change
  window.updateWebRTCConfig = function() {
    // Get values from WebRTC controls
    const webrtcEncoder = document.getElementById('webrtc-encoder') as HTMLSelectElement;
    const videoCodec = document.getElementById('webrtc-video-codec') as HTMLSelectElement;
    const videoBitrate = document.getElementById('webrtc-video-bitrate') as HTMLSelectElement;
    const videoResolution = document.getElementById('webrtc-video-resolution') as HTMLSelectElement;
    const videoFPS = document.getElementById('webrtc-video-fps') as HTMLSelectElement;
    const audioCodec = document.getElementById('webrtc-audio-codec') as HTMLSelectElement;
    const audioBitrate = document.getElementById('webrtc-audio-bitrate') as HTMLSelectElement;
    const audioSampleRate = document.getElementById('webrtc-audio-sample-rate') as HTMLSelectElement;

    // Send config update to backend
    const configUpdate = {
      encoder_mode: webrtcEncoder?.value,
      video_codec: videoCodec?.value,
      video_bitrate: videoBitrate?.value,
      video_resolution: videoResolution?.value,
      video_fps: videoFPS?.value ? parseInt(videoFPS.value) : undefined,
      audio_codec: audioCodec?.value,
      audio_bitrate: audioBitrate?.value,
      audio_sample_rate: audioSampleRate?.value ? parseInt(audioSampleRate.value) : undefined
    };

    // Send to backend via API
    if (window.apiCall) {
      window.apiCall('PUT', '/api/config/video_muxer', configUpdate).catch(err => {
        console.error('Failed to update WebRTC config:', err);
      });
    }
  };

  // Update video muxer config (called when engine changes or settings updated)
  window.updateVideoMuxerConfig = function() {
    const engineSelect = document.getElementById('video-muxer-engine') as HTMLSelectElement;
    const engine = engineSelect?.value;

    // Prepare config update
    const configUpdate: Record<string, any> = {
      engine: engine
    };

    // Add engine-specific settings
    if (engine === 'webrtc') {
      const videoCodec = document.getElementById('webrtc-video-codec') as HTMLSelectElement;
      const videoBitrate = document.getElementById('webrtc-video-bitrate') as HTMLSelectElement;
      const videoResolution = document.getElementById('webrtc-video-resolution') as HTMLSelectElement;
      const videoFPS = document.getElementById('webrtc-video-fps') as HTMLSelectElement;
      const audioCodec = document.getElementById('webrtc-audio-codec') as HTMLSelectElement;
      const audioBitrate = document.getElementById('webrtc-audio-bitrate') as HTMLSelectElement;
      const audioSampleRate = document.getElementById('webrtc-audio-sample-rate') as HTMLSelectElement;

      configUpdate['engine'] = 'webrtc';
      configUpdate['video_codec'] = videoCodec?.value;
      configUpdate['video_bitrate'] = videoBitrate?.value;

      // Parse resolution
      if (videoResolution?.value) {
        const [width, height] = videoResolution.value.split('x');
        configUpdate['video_width'] = parseInt(width);
        configUpdate['video_height'] = parseInt(height);
      }

      configUpdate['video_fps'] = parseInt(videoFPS?.value || '30');
      configUpdate['audio_codec'] = audioCodec?.value;
      configUpdate['audio_bitrate'] = audioBitrate?.value;
      configUpdate['audio_sample_rate'] = parseInt(audioSampleRate?.value || '48000');
    } else if (engine === 'hls') {
      // Also include HLS settings
      const hlsEncoder = document.getElementById('hls-encoder') as HTMLSelectElement;
      const hlsCrf = document.getElementById('hls-crf') as HTMLInputElement;
      const hlsAudioOffset = document.getElementById('hls-audio-offset') as HTMLInputElement;
      const hlsAudioCodec = document.getElementById('hls-audio-codec') as HTMLSelectElement;
      const hlsAudioBitrate = document.getElementById('hls-audio-bitrate') as HTMLSelectElement;

      configUpdate['encoder_mode'] = hlsEncoder?.value;
      configUpdate['video_crf'] = parseInt(hlsCrf?.value || '18');
      configUpdate['audio_offset_ms'] = parseInt(hlsAudioOffset?.value || '0');
      configUpdate['audio_codec'] = hlsAudioCodec?.value;
      configUpdate['audio_bitrate'] = hlsAudioBitrate?.value;
    }

    // Send to backend via API
    if (window.apiCall) {
      window.apiCall('PUT', '/api/config/video_muxer', configUpdate).catch(err => {
        console.error('Failed to update video muxer config:', err);
      });
    }
  };

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', () => {
    // Set initial state based on current engine
    const engineSelect = document.getElementById('video-muxer-engine') as HTMLSelectElement;
    if (engineSelect) {
      window.handleEngineChange(engineSelect.value);
    }
  });
</script>
