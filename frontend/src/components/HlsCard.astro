---
---

<div class="hls-card" id="card-hls">
  <div class="process-header">
    <span class="process-indicator" id="indicator-hls"></span>
    <span class="process-title">📦 HLS OUTPUT</span>
    <span class="gpu-badge" id="hls-gpu-badge" style="display: none;">GPU</span>
    <label class="toggle-switch">
      <input type="checkbox" id="muxer-enabled" onchange="window.toggleModule('video_muxer', this.checked)" />
      <span class="toggle-slider"></span>
    </label>
  </div>
  <div class="process-content">
    <div class="form-row">
      <div class="form-group">
        <label class="form-label">Segmento</label>
        <input type="number" class="form-input" id="hls-segment" value="10" min="1" max="60" />
      </div>
      <div class="form-group">
        <label class="form-label">Lista</label>
        <input type="number" class="form-input" id="hls-list" value="6" min="2" max="20" />
      </div>
    </div>
    <div class="form-group">
      <label class="form-label">Encoder</label>
      <select class="form-select" id="hls-encoder">
        <option value="auto">Auto (GPU/CPU)</option>
        <option value="cpu">CPU (libx264)</option>
        <option value="gpu_nvenc">NVIDIA NVENC</option>
        <option value="gpu_amf">AMD AMF</option>
        <option value="gpu_qsv">Intel QSV</option>
      </select>
    </div>
    <div class="form-group">
      <label class="form-label">CRF: <span id="hls-crf-value">18</span></label>
      <input type="range" class="form-range" id="hls-crf" min="0" max="51" value="18" 
              oninput="document.getElementById('hls-crf-value').textContent = this.value" />
    </div>
    <div class="form-group">
      <label class="form-label">Offset audio (ms)</label>
      <input type="number" class="form-input" id="hls-audio-offset" value="0" />
    </div>
    <div class="form-group">
      <label class="form-label">Audio Codec</label>
      <select class="form-select" id="hls-audio-codec">
        <option value="aac">AAC</option>
        <option value="opus">Opus</option>
      </select>
    </div>
    <div class="form-group">
      <label class="form-label">Bitrate</label>
      <select class="form-select" id="hls-audio-bitrate">
        <option value="64k">64 kbps</option>
        <option value="96k">96 kbps</option>
        <option value="128k">128 kbps</option>
        <option value="192k">192 kbps</option>
        <option value="256k">256 kbps</option>
        <option value="320k">320 kbps</option>
      </select>
    </div>
    <div class="form-group" id="hls-metrics">
      <label class="form-label">Encoder Info</label>
      <div class="metrics-row">
        <div class="metric-mini">
          <span class="metric-label">Encoder</span>
          <span class="metric-value" id="module-encoder-video_muxer">--</span>
        </div>
        <div class="metric-mini">
          <span class="metric-label">Tiempo</span>
          <span class="metric-value" id="module-time-video_muxer">--</span>
        </div>
        <div class="metric-mini">
          <span class="metric-label">Chunks</span>
          <span class="metric-value" id="module-chunks-video_muxer">--</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .hls-card {
    background: var(--bg-card);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-md);
    padding: 12px;
    transition: all 0.3s ease;
  }

  .hls-card.active {
    border-color: var(--success) !important;
    box-shadow: 0 0 12px rgba(16, 185, 129, 0.3) !important;
  }

  .process-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }

  .process-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--text-dim);
    transition: all 0.3s ease;
  }

  .process-indicator.active {
    background: #00ff00 !important;
    box-shadow: 0 0 6px #00ff00, 0 0 12px #00ff00 !important;
    animation: indicator-pulse 1.5s ease-in-out infinite;
  }

  @keyframes indicator-pulse {
    0%, 100% { opacity: 0.8; }
    50% { opacity: 1; }
  }

  .process-title {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-prime);
    flex: 1;
  }

  .toggle-switch {
    position: relative;
    display: inline-block;
    width: 36px;
    height: 20px;
  }

  .toggle-switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .toggle-slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--text-dim);
    transition: 0.3s;
    border-radius: 20px;
  }

  .toggle-slider:before {
    position: absolute;
    content: "";
    height: 14px;
    width: 14px;
    left: 3px;
    bottom: 3px;
    background-color: white;
    transition: 0.3s;
    border-radius: 50%;
  }

  input:checked + .toggle-slider {
    background-color: var(--success);
  }

  input:checked + .toggle-slider:before {
    transform: translateX(16px);
  }

  .process-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .form-label {
    font-size: 10px;
    color: var(--text-sec);
    font-weight: 500;
  }

  .form-input, .form-select {
    width: 100%;
    padding: 8px 10px;
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-sm);
    color: var(--text-prime);
    font-size: 12px;
    outline: none;
  }

  .form-input:focus, .form-select:focus {
    border-color: var(--accent);
  }

  .form-select {
    cursor: pointer;
  }

  .form-range {
    width: 100%;
    height: 6px;
    -webkit-appearance: none;
    background: var(--bg-surface);
    border-radius: 3px;
    outline: none;
  }

  .form-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 16px;
    height: 16px;
    background: var(--accent);
    border-radius: 50%;
    cursor: pointer;
  }

  .metrics-row {
    display: flex;
    gap: 12px;
    padding: 8px;
    background: var(--bg-surface);
    border-radius: var(--radius-sm);
  }

  .metric-mini {
    flex: 1;
    text-align: center;
  }

  .metric-mini .metric-label {
    display: block;
    font-size: 9px;
    color: var(--text-sec);
    margin-bottom: 2px;
  }

  .metric-mini .metric-value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    color: var(--text-prime);
  }

  .gpu-badge {
    background: var(--text-dim);
    color: var(--text-sec);
    font-size: 8px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
  }

  .gpu-badge.active {
    background: linear-gradient(135deg, #76b900, #a8e600);
    color: #000;
  }
</style>
