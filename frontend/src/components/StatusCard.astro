---
import { t, initLanguage } from "../lib/i18n";
initLanguage();

interface Props {
  state?: 'idle' | 'running' | 'stopping';
}

const { state = 'idle' } = Astro.props;
---

<div class="status-card" id="status-card" role="region" aria-label="Estado del pipeline">
  <div class="status-top">
    <div class="status-left">
      <span class="status-dot" id="status-dot" role="status" aria-live="polite"></span>
      <span class="status-text" id="status-text">{t("status_off")}</span>
    </div>
    <div class="mode-selector">
      <button class="mode-btn active" data-mode="local" id="btn-mode-local" aria-label={t("local")}>🏠 {t("local")}</button>
      <button class="mode-btn" data-mode="remote" id="btn-mode-remote" aria-label={t("remote")}>🌐 {t("remote")}</button>
    </div>
    <div class="status-right">
      <button class="btn-stop" id="btn-stop" disabled aria-label={t("stop")}>
        <span class="btn-text">⏹ {t("stop")}</span>
        <span class="btn-loading" aria-hidden="true"></span>
      </button>
      <button class="btn-start" id="btn-start" aria-label={t("start")}>
        <span class="btn-text">▶ {t("start")}</span>
        <span class="btn-loading" aria-hidden="true"></span>
      </button>
    </div>
  </div>
  <div class="urls-row">
    <div class="url-item">
      <span class="url-label" id="url-emision-label">{t("srt_label")}</span>
      <code class="url-value" id="url-emision">srt://...</code>
      <button class="btn-copy-small" id="btn-copy-emision" aria-label="Copiar URL de emisión">📋</button>
    </div>
    <div class="url-item">
      <span class="url-label">{t("stream_label")}</span>
      <code class="url-value" id="url-stream">http://...</code>
      <button class="btn-copy-small" id="btn-copy-stream" aria-label="Copiar URL del stream">📋</button>
    </div>
    <div class="url-item">
      <span class="url-label">{t("player_label")}</span>
      <a class="url-link" id="url-player" href="/player" target="_blank" rel="noopener noreferrer">http://...</a>
      <button class="btn-copy-small" id="btn-copy-player" aria-label="Copiar URL del player">📋</button>
    </div>
  </div>
</div>

<div class="remote-config" id="remote-config" style="display: none;">
  <div class="form-group">
    <label class="form-label" for="emitter-address">{t("emitter_address_label")}</label>
    <input type="text" class="form-input" id="emitter-address" placeholder={t("emitter_placeholder")} />
  </div>
</div>

<script>
  import { effect } from "@preact/signals-core";
  import { connectionUrls } from "../lib/store/signals";

  function el<T extends HTMLElement>(id: string): T | null {
    return document.getElementById(id) as T | null;
  }

  // F162: Status text/buttons effect removed — centralized in effects.ts

  // Update URLs (unique to StatusCard)
  effect(() => {
    const urls = connectionUrls.value;
    const emLabel = el<HTMLSpanElement>("url-emision-label");
    const emValue = el<HTMLSpanElement>("url-emision");
    const stValue = el<HTMLSpanElement>("url-stream");
    const plLink = el<HTMLAnchorElement>("url-player");

    if (emLabel) emLabel.textContent = urls.primaryLabel;
    if (emValue) emValue.textContent = urls.primaryUrl;
    if (stValue) stValue.textContent = urls.streamUrl;
    if (plLink) { plLink.textContent = urls.playerUrl; plLink.href = urls.playerUrl; }
  });


</script>
