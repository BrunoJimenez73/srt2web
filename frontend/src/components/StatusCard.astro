---
interface Props {
  state?: 'idle' | 'running' | 'stopping';
}

const { state = 'idle' } = Astro.props;
---

<div class="status-card" id="status-card">
  <div class="status-top">
    <div class="status-left">
      <span class="status-dot" id="status-dot"></span>
      <span class="status-text" id="status-text">APAGADO</span>
    </div>
    <div class="mode-selector">
      <button class="mode-btn active" data-mode="local" id="btn-mode-local">🏠 LOCAL</button>
      <button class="mode-btn" data-mode="remote" id="btn-mode-remote">🌐 REMOTE</button>
    </div>
    <div class="status-right">
      <button class="btn-stop" id="btn-stop" disabled aria-label="Detener el pipeline de procesamiento">
        <span class="btn-text">⏹ Detener</span>
        <span class="btn-loading" aria-hidden="true">⏳</span>
      </button>
      <button class="btn-start" id="btn-start" aria-label="Iniciar el pipeline de procesamiento">
        <span class="btn-text">▶ Iniciar</span>
        <span class="btn-loading" aria-hidden="true">⏳</span>
      </button>
    </div>
  </div>
  <div class="urls-row">
    <div class="url-item">
      <span class="url-label">SRT:</span>
      <code class="url-value" id="url-srt">srt://...</code>
      <button class="btn-copy-small" id="btn-copy-srt">📋</button>
    </div>
    <div class="url-item">
      <span class="url-label">Stream:</span>
      <code class="url-value" id="url-stream">http://...</code>
      <button class="btn-copy-small" id="btn-copy-stream">📋</button>
    </div>
    <div class="url-item">
      <span class="url-label">Player:</span>
      <a class="url-link" id="url-player" href="/player" target="_blank">http://...</a>
      <button class="btn-copy-small" id="btn-copy-player">📋</button>
    </div>
  </div>
</div>

<div class="remote-config" id="remote-config" style="display: none;">
  <div class="form-group">
    <label class="form-label">Emisor SRT Address</label>
    <input type="text" class="form-input" id="emitter-address" placeholder="203.0.113.xx" />
  </div>
</div>

<style>
  .status-card {
    background: var(--bg-card);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-md);
    padding: 16px;
    margin-bottom: 16px;
  }

  .status-top {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .status-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .status-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--text-dim);
  }

  .status-dot.running {
    background: #00ff00;
    box-shadow: 0 0 8px #00ff00, 0 0 15px #00ff00;
    animation: phosphor-pulse 1.5s ease-in-out infinite;
  }

  @keyframes phosphor-pulse {
    0%, 100% { opacity: 0.8; box-shadow: 0 0 8px #00ff00, 0 0 15px #00ff00; }
    50% { opacity: 1; box-shadow: 0 0 15px #00ff00, 0 0 30px #00ff00, 0 0 45px #00ff00; }
  }

  .status-text {
    font-size: 14px;
    font-weight: 600;
  }

  .mode-selector {
    display: flex;
    gap: 4px;
  }

  .mode-btn {
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-sm);
    padding: 5px 10px;
    font-size: 10px;
    color: var(--text-sec);
    cursor: pointer;
    transition: all 0.2s;
  }

  .mode-btn:hover {
    border-color: var(--accent);
  }

  .mode-btn.active {
    background: var(--accent);
    border-color: var(--accent);
    color: white;
  }

  .status-right {
    display: flex;
    gap: 6px;
    margin-left: auto;
  }

  .btn-start, .btn-stop {
    padding: 6px 14px;
    border-radius: var(--radius-sm);
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: all 0.2s;
  }

  .btn-start {
    background: var(--success);
    color: white;
  }

  .btn-start:hover {
    background: #0ea571;
  }

  .btn-start:disabled {
    background: var(--text-dim);
    cursor: not-allowed;
  }

  .btn-start.loading .btn-text,
  .btn-stop.loading .btn-text {
    display: none;
  }

  .btn-start.loading .btn-loading,
  .btn-stop.loading .btn-loading {
    display: inline;
  }

  .btn-loading {
    display: none;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .btn-stop {
    background: var(--error);
    color: white;
  }

  .btn-stop:hover {
    background: #dc2626;
  }

  .btn-stop:disabled {
    background: var(--text-dim);
    color: var(--text-sec);
    opacity: 1;
    cursor: not-allowed;
  }

  .urls-row {
    display: flex;
    gap: 12px;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--border-dim);
    flex-wrap: wrap;
  }

  .url-item {
    display: flex;
    align-items: center;
    gap: 6px;
    background: var(--bg-surface);
    padding: 5px 8px;
    border-radius: var(--radius-sm);
    flex: 1;
    min-width: 200px;
  }

  .url-label {
    font-size: 10px;
    color: var(--text-sec);
    font-weight: 500;
  }

  .url-value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: var(--text-prime);
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .url-link {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: var(--accent);
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
  }

  .url-link:hover {
    text-decoration: underline;
  }

  .btn-copy-small {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 11px;
    padding: 2px 4px;
    flex-shrink: 0;
  }

  .btn-copy-small:hover {
    opacity: 0.7;
  }

  .remote-config {
    background: var(--bg-card);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-md);
    padding: 12px 16px;
    margin-bottom: 16px;
  }

  .form-group {
    margin-bottom: 8px;
  }

  .form-label {
    display: block;
    font-size: 10px;
    color: var(--text-sec);
    margin-bottom: 4px;
    font-weight: 500;
  }

  .form-input {
    width: 100%;
    padding: 8px 10px;
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-sm);
    color: var(--text-prime);
    font-size: 12px;
    outline: none;
    transition: border-color 0.2s;
  }

  .form-input:focus {
    border-color: var(--accent);
  }

  @media (max-width: 700px) {
    .status-top {
      flex-direction: column;
      align-items: flex-start;
    }
    .status-right {
      margin-left: 0;
      width: 100%;
    }
    .url-item {
      min-width: 100%;
    }
  }
</style>
