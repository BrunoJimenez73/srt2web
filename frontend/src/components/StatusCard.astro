---
interface Props {
  state?: 'idle' | 'running' | 'stopping';
}

const { state = 'idle' } = Astro.props;
---

<div class="status-card" id="status-card">
  <div class="status-top">
    <div class="status-left">
      <span class="status-dot" id="status-dot"></span>
      <span class="status-text" id="status-text">APAGADO</span>
    </div>
    <div class="mode-selector">
      <button class="mode-btn active" data-mode="local" id="btn-mode-local" aria-label="Modo local">🏠 LOCAL</button>
      <button class="mode-btn" data-mode="remote" id="btn-mode-remote" aria-label="Modo remoto">🌐 REMOTE</button>
    </div>
    <div class="status-right">
      <button class="btn-stop" id="btn-stop" disabled aria-label="Detener el pipeline de procesamiento" onclick="window.stopPipeline()">
        <span class="btn-text">⏹ Detener</span>
        <span class="btn-loading" aria-hidden="true">⏳</span>
      </button>
      <button class="btn-start" id="btn-start" aria-label="Iniciar el pipeline de procesamiento" onclick="window.startPipeline()">
        <span class="btn-text">▶ Iniciar</span>
        <span class="btn-loading" aria-hidden="true">⏳</span>
      </button>
    </div>
  </div>
  <div class="urls-row">
    <div class="url-item">
      <span class="url-label" id="url-emision-label">SRT:</span>
      <code class="url-value" id="url-emision">srt://...</code>
      <button class="btn-copy-small" id="btn-copy-emision" aria-label="Copiar URL de emisión">📋</button>
    </div>
    <div class="url-item">
      <span class="url-label">Stream:</span>
      <code class="url-value" id="url-stream">http://...</code>
      <button class="btn-copy-small" id="btn-copy-stream" aria-label="Copiar URL del stream">📋</button>
    </div>
    <div class="url-item">
      <span class="url-label">Player:</span>
      <a class="url-link" id="url-player" href="/player" target="_blank" rel="noopener noreferrer">http://...</a>
      <button class="btn-copy-small" id="btn-copy-player" aria-label="Copiar URL del player">📋</button>
    </div>
  </div>
</div>

<div class="remote-config" id="remote-config" style="display: none;">
  <div class="form-group">
    <label class="form-label" for="emitter-address">Emisor SRT Address</label>
    <input type="text" class="form-input" id="emitter-address" placeholder="203.0.113.xx" />
  </div>
</div>
