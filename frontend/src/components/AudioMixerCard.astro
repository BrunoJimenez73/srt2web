---
---
<div class="audio-mixer-card collapsible-card" id="card-audio-mixer">
  <div class="process-header">
    <span class="process-indicator" id="indicator-audio-mixer"></span>
    <span class="process-title">🔊 MEZCLA DE AUDIO</span>
    <label class="toggle-switch" aria-label="Activar/desactivar mezcla de audio">
      <input type="checkbox" id="audio-mixer-enabled" onchange="window.toggleModule('audio_mixer', this.checked)" />
      <span class="toggle-slider"></span>
    </label>
  </div>
  <div class="process-content">
    <div class="form-group">
      <label class="form-label" id="audio-mixer-original-label">Volumen Original</label>
      <input type="range" class="form-range" id="audio-mixer-original-volume"
             min="0" max="2" step="0.1" value="0.7" aria-labelledby="audio-mixer-original-label" aria-valuetext="0.7">
      <span id="audio-mixer-original-value" aria-hidden="true">0.7</span>
    </div>
    <div class="form-group">
      <label class="form-label" id="audio-mixer-dubbed-label">Volumen Doblado</label>
      <input type="range" class="form-range" id="audio-mixer-dubbed-volume"
             min="0" max="2" step="0.1" value="1.0" aria-labelledby="audio-mixer-dubbed-label" aria-valuetext="1.0">
      <span id="audio-mixer-dubbed-value" aria-hidden="true">1.0</span>
    </div>
    <div class="form-group">
      <label class="form-label">Métricas</label>
      <div class="metrics-row">
        <div class="metric-mini">
          <span class="metric-label">Tiempo</span>
          <span class="metric-value" id="module-time-audio_mixer">--</span>
        </div>
        <div class="metric-mini">
          <span class="metric-label">Chunks</span>
          <span class="metric-value" id="module-chunks-audio_mixer">--</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .audio-mixer-card {
    background: var(--bg-card);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-md);
    padding: 12px;
    transition: all 0.3s ease;
  }

  .audio-mixer-card.active {
    border-color: var(--success) !important;
    box-shadow: 0 0 12px rgba(16, 185, 129, 0.3) !important;
  }

  .process-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }

  .process-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--text-dim);
    transition: all 0.3s ease;
  }

  .process-indicator.active {
    background: #00ff00 !important;
    box-shadow: 0 0 6px #00ff00, 0 0 12px #00ff00 !important;
    animation: indicator-pulse 1.5s ease-in-out infinite;
  }

  @keyframes indicator-pulse {
    0%, 100% { opacity: 0.8; }
    50% { opacity: 1; }
  }

  .process-title {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-prime);
    flex: 1;
  }

  .toggle-switch {
    position: relative;
    display: inline-block;
    width: 36px;
    height: 20px;
  }

  .toggle-switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .toggle-slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--text-dim);
    transition: 0.3s;
    border-radius: 20px;
  }

  .toggle-slider:before {
    position: absolute;
    content: "";
    height: 14px;
    width: 14px;
    left: 3px;
    bottom: 3px;
    background-color: white;
    transition: 0.3s;
    border-radius: 50%;
  }

  input:checked + .toggle-slider {
    background-color: var(--success);
  }

  input:checked + .toggle-slider:before {
    transform: translateX(16px);
  }

  .process-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .form-label {
    font-size: 10px;
    color: var(--text-sec);
    font-weight: 500;
  }

  .form-input, .form-select {
    width: 100%;
    padding: 8px 10px;
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-sm);
    color: var(--text-prime);
    font-size: 12px;
    outline: none;
  }

  .form-input:focus, .form-select:focus {
    border-color: var(--accent);
  }

  .form-select {
    cursor: pointer;
  }

  .form-range {
    width: 100%;
    height: 6px;
    -webkit-appearance: none;
    background: var(--bg-surface);
    border-radius: 3px;
    outline: none;
  }

  .form-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 16px;
    height: 16px;
    background: var(--accent);
    border-radius: 50%;
    cursor: pointer;
  }

  .metrics-row {
    display: flex;
    gap: 12px;
    padding: 8px;
    background: var(--bg-surface);
    border-radius: var(--radius-sm);
  }

  .metric-mini {
    flex: 1;
    text-align: center;
  }

  .metric-mini .metric-label {
    display: block;
    font-size: 9px;
    color: var(--text-sec);
    margin-bottom: 2px;
  }

  .metric-mini .metric-value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    color: var(--text-prime);
  }
</style>

<script>
  import { fetchWithAuth } from "../lib/api";
  let saveTimeout = null;

  function dottedToNested(dottedKey, value) {
    const parts = dottedKey.split('.');
    let result = {};
    let current = result;
    for (let i = 0; i < parts.length - 1; i++) {
      current[parts[i]] = {};
      current = current[parts[i]];
    }
    current[parts[parts.length - 1]] = value;
    return result;
  }

  async function saveAudioConfig(key, value) {
    clearTimeout(saveTimeout);
    saveTimeout = setTimeout(async () => {
      try {
        const nested = dottedToNested(key, value);
        const res = await fetchWithAuth('/api/config', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ config: nested })
        });
        if (!res.ok) {
          const text = await res.text().catch(() => 'unknown error');
          console.error('[AudioMixer] Error saving config:', res.status, text);
        }
      } catch (e) {
        console.error('[AudioMixer] Failed to save audio config:', e);
      }
    }, 500);
  }

  async function loadAudioConfig() {
    try {
      const res = await fetchWithAuth('/api/config');
      if (!res.ok) return;
      const data = await res.json();
      const mixer = data?.config?.modules?.audio_mixer;
      if (!mixer) return;
      const origSlider = document.getElementById('audio-mixer-original-volume');
      const origVal = document.getElementById('audio-mixer-original-value');
      const dubSlider = document.getElementById('audio-mixer-dubbed-volume');
      const dubVal = document.getElementById('audio-mixer-dubbed-value');

      if (origSlider && origVal && mixer.original_volume !== undefined) {
        const v = String(mixer.original_volume);
        origSlider.value = v;
        origVal.textContent = v;
      }
      if (dubSlider && dubVal && mixer.tts_volume !== undefined) {
        const v = String(mixer.tts_volume);
        dubSlider.value = v;
        dubVal.textContent = v;
      }
    } catch (e) {
      console.error('[AudioMixer] Failed to load config:', e);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const originalVol = document.getElementById('audio-mixer-original-volume');
    const originalVal = document.getElementById('audio-mixer-original-value');
    const dubbedVol = document.getElementById('audio-mixer-dubbed-volume');
    const dubbedVal = document.getElementById('audio-mixer-dubbed-value');

    void loadAudioConfig();

    if (originalVol && originalVal) {
      originalVol.addEventListener('input', () => {
        originalVal.textContent = originalVol.value;
        saveAudioConfig('modules.audio_mixer.original_volume', parseFloat(originalVol.value));
      });
    }

    if (dubbedVol && dubbedVal) {
      dubbedVol.addEventListener('input', () => {
        dubbedVal.textContent = dubbedVol.value;
        saveAudioConfig('modules.audio_mixer.tts_volume', parseFloat(dubbedVol.value));
      });
    }
  });

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    document.dispatchEvent(new Event('DOMContentLoaded'));
  }
</script>
