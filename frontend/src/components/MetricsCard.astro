---
interface Props {
  title?: string;
}

const { title = 'System' } = Astro.props;
---

<div class="metrics-card" id="metrics-card">
  <div class="metrics-header" onclick="document.getElementById('metrics-content').classList.toggle('collapsed'); this.querySelector('.collapse-icon').classList.toggle('rotated')">
    <span class="metrics-title">{title}</span>
    <span class="collapse-icon">▼</span>
  </div>
  <div class="metrics-content" id="metrics-content">
    <div class="metrics-row">
      <div class="metric-col">
        <div class="metric-info"><span class="metric-icon">⚡</span><span class="metric-label">CPU</span></div>
        <span class="metric-value" id="metric-cpu-value">0%</span>
        <div class="metric-bar-wrap"><div class="metric-bar" id="metric-cpu-bar"></div></div>
      </div>
      <div class="metric-col">
        <div class="metric-info"><span class="metric-icon">🧠</span><span class="metric-label">MEM</span></div>
        <span class="metric-value" id="metric-memory-value">0 MB <span class="metric-percent" id="metric-memory-percent">0%</span></span>
        <div class="metric-bar-wrap"><div class="metric-bar" id="metric-memory-bar"></div></div>
      </div>
      <div class="metric-col">
        <div class="metric-info"><span class="metric-icon">🎮</span><span class="metric-label">GPU</span></div>
        <span class="metric-value" id="metric-gpu-value">-- <span class="metric-percent" id="metric-gpu-memory">--</span></span>
        <div class="metric-bar-wrap"><div class="metric-bar" id="metric-gpu-bar"></div></div>
      </div>
      <div class="metric-col">
        <div class="metric-info"><span class="metric-icon">📊</span><span class="metric-label">FPS</span></div>
        <span class="metric-value" id="metric-throughput-value">0/s</span>
        <div class="metric-bar-wrap"><div class="metric-bar" id="metric-throughput-bar"></div></div>
      </div>
    </div>
  </div>
</div>

<style>
  .metrics-card {
    background: var(--bg-card);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-md);
    padding: 8px 12px;
    margin-bottom: 16px;
  }

  .metrics-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
    cursor: pointer;
    user-select: none;
  }

  .metrics-title {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-prime);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .collapse-icon {
    font-size: 10px;
    color: var(--text-dim);
    transition: transform 0.2s;
  }

  .collapse-icon.rotated { transform: rotate(-90deg); }
  .metrics-content.collapsed { display: none; }

  .metrics-row {
    display: flex;
    width: 100%;
  }

  .metric-col {
    flex: 1;
    width: 25%;
    padding: 0 8px;
    border-right: 1px solid var(--border-dim);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .metric-col:last-child { border-right: none; }

  .metric-info {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .metric-icon { font-size: 11px; }

  .metric-label {
    font-size: 10px;
    color: var(--text-sec);
    text-transform: uppercase;
  }

  .metric-value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-prime);
  }

  .metric-percent {
    font-size: 10px;
    color: var(--text-dim);
  }

  .metric-bar-wrap {
    width: 100%;
    height: 4px;
    background: var(--bg-surface);
    border-radius: 2px;
    overflow: hidden;
  }

  .metric-bar {
    height: 100%;
    width: 0%;
    background: var(--accent);
    border-radius: 2px;
    transition: width 0.3s;
  }

  #metric-cpu-bar { background: linear-gradient(90deg, #22c55e, #84cc16); }
  #metric-memory-bar { background: linear-gradient(90deg, #3b82f6, #8b5cf6); }
  #metric-gpu-bar { background: linear-gradient(90deg, #f97316, #ec4899); }
  #metric-throughput-bar { background: linear-gradient(90deg, #06b6d4, #10b981); }
</style>