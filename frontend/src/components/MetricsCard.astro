---
interface Props {
  title?: string;
}

const { title = 'System Metrics' } = Astro.props;
---

<div class="metrics-card" id="metrics-card" role="region" aria-label="Métricas del sistema">
  <button
    type="button"
    class="metrics-header"
    id="metrics-header-toggle"
    aria-expanded="true"
    aria-controls="metrics-body"
  >
    <span class="metrics-title">
      <span class="metrics-chevron" id="metrics-chevron" aria-hidden="true">▾</span>
      {title}
    </span>
    <span class="latency-indicator" id="latency-indicator" title="Latencia estimada por etapa">
      <span class="latency-icon" aria-hidden="true">⏱</span>
      <span class="latency-value" id="latency-value">0s</span>
    </span>
  </button>
  <div class="metrics-body" id="metrics-body">
    <div class="metrics-grid">
      <div class="metric-item" id="metric-cpu" role="meter" aria-label="Uso de CPU" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <div class="metric-info">
          <span class="metric-icon" aria-hidden="true">⚡</span>
          <span class="metric-label">CPU</span>
        </div>
        <div class="metric-bar-container">
          <div class="metric-bar" id="metric-cpu-bar" style="width: 0%"></div>
        </div>
        <div class="metric-values">
          <span class="metric-value" id="metric-cpu-value">0%</span>
        </div>
      </div>
      <div class="metric-item" id="metric-memory" role="meter" aria-label="Uso de memoria" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <div class="metric-info">
          <span class="metric-icon" aria-hidden="true">🧠</span>
          <span class="metric-label">Memory</span>
        </div>
        <div class="metric-bar-container">
          <div class="metric-bar" id="metric-memory-bar" style="width: 0%"></div>
        </div>
        <div class="metric-values">
          <span class="metric-value" id="metric-memory-value">0 MB</span>
          <span class="metric-percent" id="metric-memory-percent">0%</span>
        </div>
      </div>
      <div class="metric-item" id="metric-gpu" role="meter" aria-label="Uso de GPU" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <div class="metric-info">
          <span class="metric-icon" aria-hidden="true">🎮</span>
          <span class="metric-label">GPU</span>
        </div>
        <div class="metric-bar-container">
          <div class="metric-bar gpu-bar" id="metric-gpu-bar" style="width: 0%"></div>
        </div>
        <div class="metric-values">
          <span class="metric-value" id="metric-gpu-value">0%</span>
          <span class="metric-percent" id="metric-gpu-memory">N/A</span>
        </div>
      </div>
      <div class="metric-item" id="metric-throughput" role="meter" aria-label="Rendimiento de procesamiento" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <div class="metric-info">
          <span class="metric-icon" aria-hidden="true">📊</span>
          <span class="metric-label">Throughput</span>
        </div>
        <div class="metric-bar-container">
          <div class="metric-bar throughput-bar" id="metric-throughput-bar" style="width: 0%"></div>
        </div>
        <div class="metric-values">
          <span class="metric-value" id="metric-throughput-value">0/s</span>
        </div>
      </div>
    </div>
    <div class="module-timing-section" id="module-timing-section" style="display:none">
      <button
        type="button"
        class="timing-header"
        id="timing-header-toggle"
        aria-expanded="true"
        aria-controls="timing-stages"
      >
        <span class="timing-title">
          <span class="timing-chevron" id="timing-chevron" aria-hidden="true">▾</span>
          Per-Module Latency
        </span>
        <span class="timing-subtitle" id="timing-subtitle">0 stages</span>
      </button>
      <div class="timing-stages" id="timing-stages" role="region" aria-labelledby="timing-header-toggle"></div>
    </div>
  </div>
</div>

<style>
  .metrics-card {
    background: var(--bg-card);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-md);
    padding: 12px;
    margin-bottom: 16px;
  }

  .metrics-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin: 0 0 12px;
    padding: 4px 2px 8px;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--border-dim);
    cursor: pointer;
    color: inherit;
    font: inherit;
    border-radius: var(--radius-sm, 4px);
    transition: background 0.15s ease;
  }

  .metrics-header:hover {
    background: var(--bg-surface, rgba(255, 255, 255, 0.04));
  }

  .metrics-header:focus-visible {
    outline: 2px solid var(--accent, #6366f1);
    outline-offset: 1px;
  }

  .metrics-title {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 600;
    color: var(--text-prime);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .metrics-chevron {
    display: inline-block;
    font-size: 11px;
    line-height: 1;
    color: var(--text-sec);
    transition: transform 0.18s ease;
    transform-origin: 50% 55%;
  }

  .metrics-header[aria-expanded="false"] .metrics-chevron {
    transform: rotate(-90deg);
  }

  .metrics-header[aria-expanded="false"] + .metrics-body {
    display: none;
  }

  .latency-indicator {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 10px;
    color: var(--text-sec);
    background: var(--bg-surface);
    padding: 4px 8px;
    border-radius: var(--radius-sm);
  }

  .latency-icon {
    font-size: 10px;
  }

  .latency-value {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 600;
    color: var(--text-prime);
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  @media (max-width: 480px) {
    .metrics-grid {
      grid-template-columns: 1fr;
    }
  }

  .metric-item {
    background: var(--bg-surface) !important;
    border-radius: var(--radius-sm);
    padding: 10px !important;
    transition: all 0.3s ease;
  }

  .metric-item:hover {
    background: var(--bg-card-hover) !important;
  }

  .metric-info {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
  }

  .metric-icon {
    font-size: 12px;
  }

  .metric-label {
    font-size: 10px;
    color: var(--text-sec);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 500;
  }

  .metric-bar-container {
    height: 6px;
    background: var(--bg-deep);
    border-radius: 3px;
    overflow: hidden;
    margin-bottom: 6px;
  }

  .metric-bar {
    height: 100%;
    border-radius: 3px;
    transition: width 0.5s ease, background-color 0.3s ease;
    position: relative;
    min-width: 4px;
  }

  .metric-bar::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.15) 50%, transparent 100%);
    animation: shimmer 3s ease-in-out infinite;
  }

  @keyframes shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }

  #metric-cpu-bar {
    background: linear-gradient(90deg, #f97316, #ec4899);
  }

  #metric-memory-bar {
    background: linear-gradient(90deg, #f97316, #ec4899);
  }

  #metric-throughput-bar {
    background: linear-gradient(90deg, #f97316, #ec4899);
  }

  #metric-gpu-bar {
    background: linear-gradient(90deg, #f97316, #ec4899);
  }

  .metric-bar.low {
    background: linear-gradient(90deg, #22c55e, #16a34a) !important;
  }

  .metric-bar.medium {
    background: linear-gradient(90deg, #f59e0b, #d97706) !important;
  }

  .metric-bar.high {
    background: linear-gradient(90deg, #ef4444, #dc2626) !important;
  }

  .metric-values {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .metric-value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-prime);
  }

  .metric-percent {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: var(--text-sec);
  }

  .metric-item.warning .metric-bar {
    animation: pulse-warning 1s ease-in-out infinite;
  }

  .metric-item.critical .metric-bar {
    animation: pulse-critical 0.5s ease-in-out infinite;
  }

  .module-timing-section {
    margin-top: 12px;
    padding-top: 8px;
    border-top: 1px solid var(--border-dim);
  }

  .timing-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin: 0 0 6px 0;
    padding: 4px 2px;
    background: transparent;
    border: none;
    cursor: pointer;
    color: inherit;
    font: inherit;
    border-radius: var(--radius-sm, 4px);
    transition: background 0.15s ease;
  }

  .timing-header:hover {
    background: var(--bg-surface, rgba(255, 255, 255, 0.04));
  }

  .timing-header:focus-visible {
    outline: 2px solid var(--accent, #6366f1);
    outline-offset: 1px;
  }

  .timing-title {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 10px;
    font-weight: 600;
    color: var(--text-prime);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .timing-chevron {
    display: inline-block;
    font-size: 11px;
    line-height: 1;
    color: var(--text-sec);
    transition: transform 0.18s ease;
    transform-origin: 50% 55%;
  }

  .timing-header[aria-expanded="false"] .timing-chevron {
    transform: rotate(-90deg);
  }

  .timing-subtitle {
    font-size: 9px;
    color: var(--text-sec);
  }

  .timing-stages {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px 10px;
  }

  .timing-header[aria-expanded="false"] + .timing-stages {
    display: none;
  }

:global(.timing-stage) {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 3px 6px;
  border-radius: var(--radius-sm);
  background: var(--bg-deep);
}

:global(.timing-stage-name) {
  font-size: 9px;
  font-weight: 500;
  color: var(--text-prime);
  width: 80px;
  flex-shrink: 0;
  text-transform: capitalize;
}

:global(.timing-stage-bar-container) {
  flex: 1;
  height: 6px;
  background: var(--bg-surface);
  border-radius: 3px;
  overflow: hidden;
}

:global(.timing-stage-bar) {
  height: 100%;
  border-radius: 3px;
  transition: width 0.5s ease;
  min-width: 2px;
}

:global(.timing-stage-value) {
  font-family: 'JetBrains Mono', monospace;
  font-size: 9px;
  font-weight: 600;
  color: var(--text-sec);
  width: 48px;
  text-align: right;
  flex-shrink: 0;
}

@keyframes pulse-warning {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }

  @keyframes pulse-critical {
    0%, 100% { opacity: 1; box-shadow: 0 0 8px #ef4444; }
    50% { opacity: 0.6; box-shadow: 0 0 16px #ef4444; }
  }
</style>

<script>
  import { effect } from "@preact/signals-core";
  import {
    systemMetrics,
    cpuHistory,
    gpuHistory,
    throughputHistory,
    throughputAvg,
    pipelineLatency,
    moduleLatencyBreakdown,
    cpuAlertActive,
    pipelineStatus,
  } from "../lib/store/signals";

  function el<T extends HTMLElement>(id: string): T | null {
    return document.getElementById(id) as T | null;
  }

  function getBarClass(value: number): string {
    if (value < 40) return "low";
    if (value < 80) return "medium";
    return "high";
  }

  function getItemClass(value: number): string {
    return value < 80 ? "warning" : "critical";
  }

  function getSparklineColor(value: number): string {
    if (value < 70) return "#22c55e";
    if (value < 85) return "#f59e0b";
    return "#ef4444";
  }

  let cpuHighTimer: number | null = null;

  effect(() => {
    const m = systemMetrics.value;
    const tpAvg = throughputAvg.value;
    const lat = pipelineLatency.value;

    // CPU
    const cpuBar = el<HTMLDivElement>("metric-cpu-bar");
    const cpuValue = el<HTMLSpanElement>("metric-cpu-value");
    const cpuItem = el<HTMLDivElement>("metric-cpu");
    if (cpuBar) {
      cpuBar.style.width = `${m.cpu}%`;
      cpuBar.className = `metric-bar ${getBarClass(m.cpu)}`;
    }
    if (cpuItem) {
      cpuItem.className = `metric-item ${getItemClass(m.cpu)}`;
    }
    if (cpuValue) cpuValue.textContent = `${m.cpu.toFixed(0)}%`;

    // Memory
    const memBar = el<HTMLDivElement>("metric-memory-bar");
    const memValue = el<HTMLSpanElement>("metric-memory-value");
    const memPercent = el<HTMLSpanElement>("metric-memory-percent");
    if (memBar) {
      memBar.style.width = `${m.memoryPercent}%`;
      memBar.className = `metric-bar ${getBarClass(m.memoryPercent)}`;
    }
    if (memValue) memValue.textContent = `${m.memoryMb.toFixed(0)} MB`;
    if (memPercent) memPercent.textContent = `${m.memoryPercent.toFixed(0)}%`;

    // GPU
    const gpuBar = el<HTMLDivElement>("metric-gpu-bar");
    const gpuValue = el<HTMLSpanElement>("metric-gpu-value");
    const gpuMem = el<HTMLSpanElement>("metric-gpu-memory");
    if (gpuBar) {
      gpuBar.style.width = `${m.gpuUtil}%`;
      gpuBar.className = `metric-bar ${getBarClass(m.gpuUtil)}`;
    }
    if (gpuValue) gpuValue.textContent = `${m.gpuUtil.toFixed(0)}%`;
    if (gpuMem) gpuMem.textContent = m.gpuMemMb > 0 ? `${m.gpuMemMb.toFixed(0)} MB` : "N/A";

    // Throughput
    const tpBar = el<HTMLDivElement>("metric-throughput-bar");
    const tpValue = el<HTMLSpanElement>("metric-throughput-value");
    if (tpBar) tpBar.style.width = `${Math.min(tpAvg * 10, 100)}%`;
    if (tpValue) tpValue.textContent = tpAvg < 1 ? `${tpAvg.toFixed(1)}/s` : `${tpAvg.toFixed(1)}/s`;

    // Latency
    const latEl = el<HTMLSpanElement>("latency-value");
    if (latEl) latEl.textContent = lat > 0 ? `${lat.toFixed(1)}s` : "0s";

    // CPU Alert
    const now = Date.now();
    if (m.cpu > 90) {
      if (cpuHighTimer === null) cpuHighTimer = now;
      else if (now - cpuHighTimer >= 5000) cpuAlertActive.value = true;
    } else {
      cpuHighTimer = null;
      cpuAlertActive.value = false;
    }

    // Chunks failed
    const cf = (pipelineStatus.value as any)?.chunks_failed ?? 0;
    const cfEl = el<HTMLDivElement>("chunks-failed");
    const cfText = el<HTMLSpanElement>("chunks-failed-text");
    if (cfEl && cfText) {
      cfEl.style.display = cf > 0 ? "inline-flex" : "none";
      cfText.textContent = `${cf} failed`;
    }
  });

  // Per-module latency breakdown
  effect(() => {
    const breakdown = moduleLatencyBreakdown.value;
    const section = el<HTMLDivElement>("module-timing-section");
    const stagesEl = el<HTMLDivElement>("timing-stages");
    const subtitleEl = el<HTMLSpanElement>("timing-subtitle");
    if (!section || !stagesEl || !subtitleEl) return;

    if (breakdown.length === 0) {
      section.style.display = "none";
      return;
    }

    section.style.display = "block";
    subtitleEl.textContent = `${breakdown.length} ${breakdown.length === 1 ? "stage" : "stages"}`;

    const maxMs = Math.max(...breakdown.map((m) => m.avgMs), 1);

    // Compact: tiny padding, small fonts, thin bars. Items live inside a
    // 2-column grid so the section uses half the vertical space it used to.
    stagesEl.innerHTML = "";
    const fragment = document.createDocumentFragment();

    for (const m of breakdown) {
      const stage = document.createElement("div");
      stage.style.cssText = "display:flex;align-items:center;gap:3px;padding:1px 2px;border-radius:2px;min-width:0;";

      const nameSpan = document.createElement("span");
      nameSpan.style.cssText = "font-size:7.5px;font-weight:500;color:var(--text-sec, #94a3b8);width:46px;flex-shrink:0;text-transform:capitalize;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;";
      nameSpan.textContent = m.name;
      nameSpan.title = `${m.name}: ${m.avgMs >= 1000 ? (m.avgMs / 1000).toFixed(2) + "s" : m.avgMs.toFixed(0) + "ms"}`;

      const barContainer = document.createElement("div");
      barContainer.style.cssText = "flex:1;height:2.5px;background:var(--bg-surface, #2d2d44);border-radius:2px;overflow:hidden;min-width:8px;";

      const bar = document.createElement("div");
      bar.style.cssText = `height:100%;border-radius:2px;width:${(m.avgMs / maxMs) * 100}%;background:${getTimingColor(m.avgMs)};`;

      barContainer.appendChild(bar);

      const valueSpan = document.createElement("span");
      valueSpan.style.cssText = "font-family:monospace;font-size:7.5px;font-weight:600;color:var(--text-prime, #e2e8f0);width:30px;text-align:right;flex-shrink:0;";
      valueSpan.textContent = m.avgMs >= 1000 ? (m.avgMs / 1000).toFixed(1) + "s" : m.avgMs.toFixed(0) + "ms";

      stage.appendChild(nameSpan);
      stage.appendChild(barContainer);
      stage.appendChild(valueSpan);
      fragment.appendChild(stage);
    }

    stagesEl.appendChild(fragment);
  });

  // Collapse/expand toggle for the per-module latency section. The expanded
  // state is persisted in localStorage so it survives page reloads.
  const TIMING_EXPANDED_KEY = "srt2web:metrics:timing-expanded";
  const headerToggle = el<HTMLButtonElement>("timing-header-toggle");
  if (headerToggle) {
    const stored = localStorage.getItem(TIMING_EXPANDED_KEY);
    // Default to expanded if no preference has been recorded yet.
    const initialExpanded = stored === null ? true : stored === "true";
    headerToggle.setAttribute("aria-expanded", String(initialExpanded));

    headerToggle.addEventListener("click", (e) => {
      // Stop propagation so clicking the inner timing toggle doesn't also
      // toggle the outer metrics card.
      e.stopPropagation();
      const isExpanded = headerToggle.getAttribute("aria-expanded") === "true";
      const next = !isExpanded;
      headerToggle.setAttribute("aria-expanded", String(next));
      try {
        localStorage.setItem(TIMING_EXPANDED_KEY, String(next));
      } catch {
        // localStorage may be disabled (private mode, etc.) — non-fatal.
      }
    });
  }

  // Collapse/expand toggle for the entire System Metrics card body. The
  // expanded state is persisted in localStorage so it survives page reloads.
  const METRICS_EXPANDED_KEY = "srt2web:metrics:system-expanded";
  const metricsHeader = el<HTMLButtonElement>("metrics-header-toggle");
  if (metricsHeader) {
    const stored = localStorage.getItem(METRICS_EXPANDED_KEY);
    const initialExpanded = stored === null ? true : stored === "true";
    metricsHeader.setAttribute("aria-expanded", String(initialExpanded));

    metricsHeader.addEventListener("click", (e) => {
      // Don't toggle when the click is on the inner per-module timing button
      // (it has its own stopPropagation above) — but the inner button lives
      // inside .metrics-body which is hidden when collapsed, so this is just
      // belt-and-suspenders.
      if ((e.target as HTMLElement).closest(".timing-header")) {
        return;
      }
      const isExpanded = metricsHeader.getAttribute("aria-expanded") === "true";
      const next = !isExpanded;
      metricsHeader.setAttribute("aria-expanded", String(next));
      try {
        localStorage.setItem(METRICS_EXPANDED_KEY, String(next));
      } catch {
        // localStorage may be disabled (private mode, etc.) — non-fatal.
      }
    });
  }

  function getTimingColor(ms: number): string {
    if (ms < 100) return "#22c55e";
    if (ms < 500) return "#f59e0b";
    if (ms < 1000) return "#f97316";
    return "#ef4444";
  }

  // Sparklines
  effect(() => {
    const cpu = cpuHistory.value;
    const gpu = gpuHistory.value;
    const tp = throughputHistory.value;

    const cpuLine = document.getElementById("cpu-sparkline-line") as unknown as SVGElement & { setAttribute: (k: string, v: string) => void; style: { stroke: string } };
    const gpuLine = document.getElementById("gpu-sparkline-line") as unknown as SVGElement & { setAttribute: (k: string, v: string) => void; style: { stroke: string } };
    const tpLine = document.getElementById("tp-sparkline-line") as unknown as SVGElement & { setAttribute: (k: string, v: string) => void; style: { stroke: string } };

    if (cpuLine && cpu.length > 1) {
      cpuLine.setAttribute("points", cpu.map((v, i) => `${i},${20 - Math.min(v * 0.2, 20)}`).join(" "));
      cpuLine.style.stroke = getSparklineColor(cpu[cpu.length - 1] || 0);
    }
    if (gpuLine && gpu.length > 1) {
      gpuLine.setAttribute("points", gpu.map((v, i) => `${i},${20 - Math.min(v * 0.2, 20)}`).join(" "));
      gpuLine.style.stroke = getSparklineColor(gpu[gpu.length - 1] || 0);
    }
    if (tpLine && tp.length > 1) {
      const maxTp = Math.max(...tp, 0.1);
      tpLine.setAttribute("points", tp.map((v, i) => `${i},${20 - Math.min((v / maxTp) * 20, 20)}`).join(" "));
    }
  });
</script>
