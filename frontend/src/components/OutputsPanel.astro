---
interface OutputStatus {
  name: string;
  type: string;
  state: string;
  enabled: boolean;
  processed_chunks: number;
  last_process_time_ms: number;
  extra?: Record<string, any>;
  stream_info?: Record<string, any>;
  error?: string;
}
---

<div class="outputs-section" id="outputs-section">
  <div class="section-header">
    <div class="header-left">
      <span class="section-icon">📤</span>
      <span class="section-title">OUTPUTS</span>
      <span class="output-count" id="output-count">0</span>
    </div>
    <button class="btn-add" id="btn-add-output" title="Añadir salida">
      <span>+</span>
    </button>
  </div>
  
  <div class="outputs-grid" id="outputs-grid">
    <div class="empty-state" id="outputs-empty">
      <div class="empty-icon">📭</div>
      <div class="empty-text">Sin salidas configuradas</div>
      <button class="btn-add-empty" id="btn-add-first-output">Añadir Salida</button>
    </div>
  </div>
  
  <div class="output-form-wrapper" id="output-form-wrapper" style="display: none;">
    <div class="form-backdrop" id="output-form-backdrop"></div>
    <div class="output-form">
      <div class="form-header">
        <span class="form-title">Nueva Salida</span>
        <button class="btn-close" id="btn-close-output-form">✕</button>
      </div>
      
      <div class="form-body">
        <div class="form-group">
          <label class="form-label">Tipo de Salida</label>
          <select class="form-select" id="new-output-type">
            <option value="web">🌐 Web Player (HLS)</option>
            <option value="recording">⏺ Grabación</option>
            <option value="srt">📡 SRT</option>
            <option value="rtmp">📺 RTMP</option>
          </select>
        </div>
        
        <div class="output-type-settings" id="settings-web">
          <div class="settings-title">Configuración Web HLS</div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Segmentos (seg)</label>
              <input type="number" class="form-input" id="output-web-segment" value="4" min="1" max="30" />
            </div>
            <div class="form-group">
              <label class="form-label">Lista</label>
              <input type="number" class="form-input" id="output-web-list" value="6" min="2" max="30" />
            </div>
          </div>
        </div>
        
        <div class="output-type-settings" id="settings-recording" style="display: none;">
          <div class="settings-title">Configuración de Grabación</div>
          <div class="form-group">
            <label class="form-label">Ruta del archivo</label>
            <input type="text" class="form-input" id="output-recording-path" value="./output/recording.mp4" />
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Formato</label>
              <select class="form-select" id="output-recording-format">
                <option value="mp4">MP4</option>
                <option value="mkv">MKV</option>
                <option value="webm">WebM</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Codec</label>
              <select class="form-select" id="output-recording-codec">
                <option value="copy">Copiar (sin re-encode)</option>
                <option value="h264_nvenc">NVIDIA H.264</option>
                <option value="h265_nvenc">NVIDIA H.265</option>
                <option value="libx264">CPU H.264</option>
              </select>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Calidad</label>
              <select class="form-select" id="output-recording-quality">
                <option value="cbr">CBR (bitrate)</option>
                <option value="crf">CRF (calidad)</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label" id="recording-bitrate-label">Bitrate</label>
              <input type="text" class="form-input" id="output-recording-bitrate" value="5000k" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Dividir archivo</label>
              <select class="form-select" id="output-recording-split">
                <option value="none">Sin dividir</option>
                <option value="time">Por tiempo</option>
                <option value="size">Por tamaño</option>
              </select>
            </div>
            <div class="form-group" id="recording-split-value-group" style="display: none;">
              <label class="form-label" id="recording-split-label">Minutos</label>
              <input type="number" class="form-input" id="output-recording-split-value" value="10" min="1" />
            </div>
          </div>
          <div class="form-group">
            <label class="form-label">Subtítulos</label>
            <select class="form-select" id="output-recording-subs">
              <option value="none">Sin subtítulos</option>
              <option value="burnt">Burnt-in (incrustados)</option>
              <option value="vtt">VTT (externos)</option>
            </select>
          </div>
        </div>
        
        <div class="output-type-settings" id="settings-srt" style="display: none;">
          <div class="settings-title">Configuración SRT</div>
          <div class="form-group">
            <label class="form-label">URL de destino</label>
            <input type="text" class="form-input" id="output-srt-url" value="srt://localhost:9001" placeholder="srt://ip:puerto" />
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Modo</label>
              <select class="form-select" id="output-srt-mode">
                <option value="caller">Caller (conectar)</option>
                <option value="listener">Listener (escuchar)</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Latencia (ms)</label>
              <input type="number" class="form-input" id="output-srt-latency" value="2000" min="0" max="10000" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Video Bitrate</label>
              <select class="form-select" id="output-srt-vbitrate">
                <option value="1500k">1500 kbps</option>
                <option value="2500k" selected>2500 kbps</option>
                <option value="4000k">4000 kbps</option>
                <option value="6000k">6000 kbps</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Audio Bitrate</label>
              <select class="form-select" id="output-srt-abitrate">
                <option value="96k">96 kbps</option>
                <option value="128k" selected>128 kbps</option>
                <option value="192k">192 kbps</option>
              </select>
            </div>
          </div>
        </div>
        
        <div class="output-type-settings" id="settings-rtmp" style="display: none;">
          <div class="settings-title">Configuración RTMP</div>
          <div class="form-group">
            <label class="form-label">URL de destino</label>
            <input type="text" class="form-input" id="output-rtmp-url" value="rtmp://localhost/live/stream" placeholder="rtmp://servidor/app/key" />
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Video Bitrate</label>
              <select class="form-select" id="output-rtmp-vbitrate">
                <option value="1500k">1500 kbps</option>
                <option value="2500k" selected>2500 kbps</option>
                <option value="4000k">4000 kbps</option>
                <option value="6000k">6000 kbps</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Audio Bitrate</label>
              <select class="form-select" id="output-rtmp-abitrate">
                <option value="96k">96 kbps</option>
                <option value="128k" selected>128 kbps</option>
                <option value="192k">192 kbps</option>
              </select>
            </div>
          </div>
        </div>
      </div>
      
      <div class="form-footer">
        <button class="btn-cancel" id="btn-cancel-output">Cancelar</button>
        <button class="btn-save" id="btn-save-output">Crear Salida</button>
      </div>
    </div>
  </div>
</div>

<style>
  .outputs-section {
    background: var(--bg-card);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  
  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border-dim);
  }
  
  .header-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  
  .section-icon {
    font-size: 16px;
  }
  
  .section-title {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-prime);
    letter-spacing: 0.5px;
  }
  
  .output-count {
    background: var(--accent);
    color: white;
    font-size: 10px;
    padding: 2px 8px;
    border-radius: 10px;
    font-weight: 600;
  }
  
  .btn-add {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid var(--border-dim);
    background: var(--bg-card);
    color: var(--text-prime);
    cursor: pointer;
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }
  
  .btn-add:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: white;
    transform: scale(1.05);
  }
  
  .outputs-grid {
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 80px;
  }
  
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px;
    color: var(--text-sec);
  }
  
  .empty-icon {
    font-size: 32px;
    margin-bottom: 8px;
    opacity: 0.5;
  }
  
  .empty-text {
    font-size: 12px;
    margin-bottom: 12px;
  }
  
  .btn-add-empty {
    padding: 8px 20px;
    background: var(--accent);
    border: none;
    border-radius: var(--radius-md);
    color: white;
    cursor: pointer;
    font-size: 12px;
    font-weight: 500;
    transition: all 0.2s ease;
  }
  
  .btn-add-empty:hover {
    background: var(--accent-hover, #3b82f6);
    transform: translateY(-1px);
  }
  
  .output-card {
    background: var(--bg-card);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-md);
    padding: 12px;
    transition: all 0.3s ease;
  }
  
  .output-card.active {
    border-color: var(--success) !important;
    box-shadow: 0 0 12px rgba(16, 185, 129, 0.3) !important;
  }
  
  .process-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
    cursor: pointer;
  }
  
  .process-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--text-dim);
    transition: all 0.3s ease;
  }
  
  .process-indicator.active {
    background: #00ff00 !important;
    box-shadow: 0 0 6px #00ff00, 0 0 12px #00ff00 !important;
    animation: indicator-pulse 1.5s ease-in-out infinite;
  }
  
  @keyframes indicator-pulse {
    0%, 100% { opacity: 0.8; }
    50% { opacity: 1; }
  }
  
  .process-title {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-prime);
    flex: 1;
  }
  
  .toggle-switch {
    position: relative;
    display: inline-block;
    width: 36px;
    height: 20px;
  }
  
  .toggle-switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }
  
  .toggle-slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--text-dim);
    transition: 0.3s;
    border-radius: 20px;
  }
  
  .toggle-slider:before {
    position: absolute;
    content: "";
    height: 14px;
    width: 14px;
    left: 3px;
    bottom: 3px;
    background-color: white;
    transition: 0.3s;
    border-radius: 50%;
  }
  
  .toggle-switch input:checked + .toggle-slider {
    background-color: var(--success);
  }
  
  .toggle-switch input:checked + .toggle-slider:before {
    transform: translateX(16px);
  }
  
  .process-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  
  .output-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  
  .stat-item {
    background: var(--bg-surface);
    padding: 8px;
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  
  .stat-label {
    font-size: 9px;
    color: var(--text-sec);
    text-transform: uppercase;
  }
  
  .stat-value {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-prime);
  }
  
  .stat-value.success {
    color: var(--success);
  }
  
  .stat-value.error {
    color: var(--error);
  }
  
  .metrics-row {
    display: flex;
    gap: 12px;
    padding: 8px;
    background: var(--bg-surface);
    border-radius: var(--radius-sm);
  }
  
  .metric-mini {
    flex: 1;
    text-align: center;
  }
  
  .metric-mini .metric-label {
    display: block;
    font-size: 9px;
    color: var(--text-sec);
    margin-bottom: 2px;
  }
  
  .metric-mini .metric-value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    color: var(--text-prime);
  }
  
  .output-details {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
    padding: 8px;
    background: var(--bg-surface);
    border-radius: var(--radius-sm);
  }
  
  .detail-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  
  .detail-label {
    font-size: 9px;
    color: var(--text-sec);
    text-transform: uppercase;
  }
  
  .detail-value {
    font-size: 11px;
    color: var(--text-prime);
    font-family: var(--font-mono);
    word-break: break-all;
  }
  
  .error-box {
    display: flex;
    gap: 8px;
    padding: 10px;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid var(--error);
    border-radius: var(--radius-sm);
  }
  
  .error-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--error);
    text-transform: uppercase;
  }
  
  .error-msg {
    font-size: 11px;
    color: var(--error);
  }
  
  .output-actions {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
    padding-top: 8px;
    border-top: 1px solid var(--border-dim);
  }
  
  .btn-expand, .btn-remove {
    padding: 6px 12px;
    border: 1px solid var(--border-dim);
    background: var(--bg-surface);
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-size: 11px;
    transition: all 0.2s;
  }
  
  .btn-expand:hover, .btn-remove:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: white;
  }
  
  .btn-remove:hover {
    background: var(--error);
    border-color: var(--error);
  }
  
  .output-form-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .form-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
  }
  
  .output-form {
    position: relative;
    width: 90%;
    max-width: 480px;
    background: var(--bg-card);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    max-height: 90vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  
  .form-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border-dim);
    background: var(--bg-surface);
  }
  
  .form-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-prime);
  }
  
  .btn-close {
    width: 28px;
    height: 28px;
    border: none;
    background: transparent;
    color: var(--text-dim);
    cursor: pointer;
    border-radius: var(--radius-sm);
    font-size: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .btn-close:hover {
    background: var(--bg-card);
    color: var(--text-prime);
  }
  
  .form-body {
    padding: 20px;
    overflow-y: auto;
    flex: 1;
  }
  
  .form-group {
    margin-bottom: 16px;
  }
  
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  
  .form-label {
    display: block;
    font-size: 11px;
    color: var(--text-sec);
    margin-bottom: 6px;
    font-weight: 500;
  }
  
  .form-input, .form-select {
    width: 100%;
    padding: 10px 12px;
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-md);
    color: var(--text-prime);
    font-size: 13px;
    transition: border-color 0.2s ease;
  }
  
  .form-input:focus, .form-select:focus {
    outline: none;
    border-color: var(--accent);
  }
  
  .settings-title {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-prime);
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border-dim);
  }
  
  .form-footer {
    display: flex;
    gap: 12px;
    padding: 16px 20px;
    border-top: 1px solid var(--border-dim);
    background: var(--bg-surface);
  }
  
  .btn-cancel, .btn-save {
    flex: 1;
    padding: 12px 20px;
    border-radius: var(--radius-md);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  
  .btn-cancel {
    background: var(--bg-card);
    border: 1px solid var(--border-dim);
    color: var(--text-sec);
  }
  
  .btn-cancel:hover {
    background: var(--bg-surface);
    color: var(--text-prime);
  }
  
  .btn-save {
    background: var(--accent);
    border: none;
    color: white;
  }
  
  .btn-save:hover {
    background: var(--accent-hover, #3b82f6);
  }
</style>

<script>
  import { fetchOutputs, addOutput, toggleOutput, removeOutput, getOutputIcon, formatOutputState } from '../lib/modules/outputs';
  import type { OutputStatus } from '../lib/modules/outputs';

  const outputIcon = getOutputIcon;
  const formatState = formatOutputState;

  let outputs: OutputStatus[] = [];
  const expandedCards = new Set<string>();

  function getOutputTypeName(type: string): string {
    const names: Record<string, string> = {
      web: 'HLS',
      recording: 'REC',
      srt: 'SRT',
      rtmp: 'RTMP',
      file: 'FILE'
    };
    return names[type] || type.toUpperCase();
  }

  function renderOutputs(outputList: OutputStatus[]): void {
    outputs = outputList;
    const grid = document.getElementById('outputs-grid');
    const empty = document.getElementById('outputs-empty');
    const countEl = document.getElementById('output-count');
    
    if (!grid) return;
    
    if (countEl) {
      countEl.textContent = String(outputList.length);
    }
    
    if (outputList.length === 0) {
      if (empty) empty.style.display = 'flex';
      grid.querySelectorAll('.output-card').forEach(el => el.remove());
      return;
    }
    
    if (empty) empty.style.display = 'none';
    
    grid.querySelectorAll('.output-card').forEach(el => el.remove());
    
    outputList.forEach(output => {
      const card = document.createElement('div');
      card.className = `output-card${output.state === 'running' ? ' active' : ''}`;
      card.dataset.name = output.name;
      
      const isExpanded = expandedCards.has(output.name);
      
      let extraInfo = '';
      if (output.stream_info) {
        extraInfo = Object.entries(output.stream_info)
          .slice(0, 4)
          .map(([k, v]) => `<div class="detail-item"><span class="detail-label">${k}</span><span class="detail-value">${v}</span></div>`)
          .join('');
      }
      
      card.innerHTML = `
        <div class="output-card ${output.state === 'running' ? 'active' : ''}">
          <div class="process-header" data-card-toggle="${output.name}">
            <span class="process-indicator ${output.state === 'running' ? 'active' : ''}"></span>
            <span class="process-title">${outputIcon(output.type)} ${output.name}</span>
            <span class="output-type-badge">${getOutputTypeName(output.type)}</span>
            <label class="toggle-switch">
              <input type="checkbox" ${output.enabled ? 'checked' : ''} data-output-toggle="${output.name}" />
              <span class="toggle-slider"></span>
            </label>
          </div>
          <div class="process-content">
            <div class="output-stats">
              <div class="stat-item">
                <span class="stat-label">Chunks</span>
                <span class="stat-value">${output.processed_chunks}</span>
              </div>
              <div class="stat-item">
                <span class="stat-label">Estado</span>
                <span class="stat-value ${output.state === 'running' ? 'success' : output.state === 'error' ? 'error' : ''}">${output.state}</span>
              </div>
            </div>
            <div class="metrics-row">
              <div class="metric-mini">
                <span class="metric-label">Tiempo</span>
                <span class="metric-value">${output.last_process_time_ms}ms</span>
              </div>
              <div class="metric-mini">
                <span class="metric-label">Tipo</span>
                <span class="metric-value">${output.type}</span>
              </div>
              <div class="metric-mini">
                <span class="metric-label">Activo</span>
                <span class="metric-value">${output.enabled ? '✓' : '✗'}</span>
              </div>
            </div>
            ${output.error ? `<div class="error-box"><span class="error-label">Error:</span><span class="error-msg">${output.error}</span></div>` : ''}
            <div class="output-details">
              ${extraInfo || '<div class="detail-item"><span class="detail-label">Sin stream info</span><span class="detail-value">-</span></div>'}
            </div>
            <div class="output-actions">
              <button class="btn-expand ${isExpanded ? 'expanded' : ''}" data-expand="${output.name}" title="Configuración">▼ Más</button>
              <button class="btn-remove" data-output-remove="${output.name}" title="Eliminar">🗑️ Eliminar</button>
            </div>
          </div>
        </div>
      `;
      
      grid.appendChild(card);
    });
    
    setupOutputEventListeners();
  }

  function setupOutputEventListeners(): void {
    document.querySelectorAll('[data-output-toggle]').forEach(toggle => {
      toggle.addEventListener('change', async (e) => {
        const name = (e.target as HTMLElement).dataset.outputToggle;
        const enabled = (e.target as HTMLInputElement).checked;
        if (name) await toggleOutput(name, enabled);
      });
    });
    
    document.querySelectorAll('[data-output-remove]').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const name = (e.target as HTMLElement).dataset.outputRemove;
        if (name && confirm(`¿Eliminar salida "${name}"?`)) {
          await removeOutput(name);
        }
      });
    });
    
    document.querySelectorAll('[data-expand]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const name = (e.target as HTMLElement).dataset.expand;
        if (name) {
          if (expandedCards.has(name)) {
            expandedCards.delete(name);
          } else {
            expandedCards.add(name);
          }
          renderOutputs(outputs);
        }
      });
    });
    
    document.querySelectorAll('[data-card-toggle]').forEach(header => {
      header.addEventListener('click', (e) => {
        const name = (e.currentTarget as HTMLElement).dataset.cardToggle;
        if (name) {
          if (expandedCards.has(name)) {
            expandedCards.delete(name);
          } else {
            expandedCards.add(name);
          }
          renderOutputs(outputs);
        }
      });
    });
  }

  function showOutputForm(): void {
    const wrapper = document.getElementById('output-form-wrapper');
    if (wrapper) wrapper.style.display = 'flex';
  }

  function hideOutputForm(): void {
    const wrapper = document.getElementById('output-form-wrapper');
    if (wrapper) wrapper.style.display = 'none';
  }

  function updateOutputTypeSettings(type: string): void {
    document.querySelectorAll('.output-type-settings').forEach(el => {
      (el as HTMLElement).style.display = 'none';
    });
    
    const settingsEl = document.getElementById(`settings-${type}`);
    if (settingsEl) {
      (settingsEl as HTMLElement).style.display = 'block';
    }
    
    const qualitySelect = document.getElementById('output-recording-quality') as HTMLSelectElement;
    const bitrateLabel = document.getElementById('recording-bitrate-label');
    const bitrateInput = document.getElementById('output-recording-bitrate') as HTMLInputElement;
    
    if (qualitySelect && bitrateLabel && bitrateInput) {
      if (qualitySelect.value === 'crf') {
        bitrateLabel.textContent = 'CRF (18-28)';
        bitrateInput.value = '23';
      } else {
        bitrateLabel.textContent = 'Bitrate (kbps)';
        bitrateInput.value = '5000';
      }
    }
    
    const splitSelect = document.getElementById('output-recording-split') as HTMLSelectElement;
    const splitGroup = document.getElementById('recording-split-value-group') as HTMLElement;
    const splitLabel = document.getElementById('recording-split-label');
    
    if (splitSelect && splitGroup && splitLabel) {
      if (splitSelect.value === 'none') {
        splitGroup.style.display = 'none';
      } else {
        splitGroup.style.display = 'block';
        splitLabel.textContent = splitSelect.value === 'time' ? 'Minutos' : 'MB';
      }
    }
  }

  async function handleSaveOutput(): Promise<void> {
    const type = (document.getElementById('new-output-type') as HTMLSelectElement)?.value || 'web';
    const timestamp = Date.now();
    const name = `${type}_${timestamp}`;
    
    let config: Record<string, any> = { type, name };
    
    if (type === 'web') {
      config = {
        ...config,
        segment_duration: parseInt((document.getElementById('output-web-segment') as HTMLInputElement)?.value || '4'),
        list_size: parseInt((document.getElementById('output-web-list') as HTMLInputElement)?.value || '6'),
        audio_offset_ms: 0,
        encoder_mode: 'auto'
      };
    } else if (type === 'recording') {
      const quality = (document.getElementById('output-recording-quality') as HTMLSelectElement)?.value || 'cbr';
      config = {
        ...config,
        output_path: (document.getElementById('output-recording-path') as HTMLInputElement)?.value || './output/recording.mp4',
        format: (document.getElementById('output-recording-format') as HTMLSelectElement)?.value || 'mp4',
        codec: (document.getElementById('output-recording-codec') as HTMLSelectElement)?.value || 'copy',
        quality_mode: quality,
        video_bitrate: quality === 'cbr' ? (document.getElementById('output-recording-bitrate') as HTMLInputElement)?.value + 'k' : undefined,
        video_crf: quality === 'crf' ? parseInt((document.getElementById('output-recording-bitrate') as HTMLInputElement)?.value || '23') : undefined,
        audio_codec: 'aac',
        split_mode: (document.getElementById('output-recording-split') as HTMLSelectElement)?.value || 'none',
        split_value: (document.getElementById('output-recording-split-value') as HTMLInputElement)?.value ? parseInt((document.getElementById('output-recording-split-value') as HTMLInputElement).value) : undefined,
        subtitles: (document.getElementById('output-recording-subs') as HTMLSelectElement)?.value || 'none'
      };
    } else if (type === 'srt') {
      config = {
        ...config,
        url: (document.getElementById('output-srt-url') as HTMLInputElement)?.value || 'srt://localhost:9001',
        mode: (document.getElementById('output-srt-mode') as HTMLSelectElement)?.value || 'caller',
        latency_ms: parseInt((document.getElementById('output-srt-latency') as HTMLInputElement)?.value || '2000'),
        video_bitrate: (document.getElementById('output-srt-vbitrate') as HTMLSelectElement)?.value || '2500k',
        audio_bitrate: (document.getElementById('output-srt-abitrate') as HTMLSelectElement)?.value || '128k'
      };
    } else if (type === 'rtmp') {
      config = {
        ...config,
        url: (document.getElementById('output-rtmp-url') as HTMLInputElement)?.value || 'rtmp://localhost/live/stream',
        video_bitrate: (document.getElementById('output-rtmp-vbitrate') as HTMLSelectElement)?.value || '2500k',
        audio_bitrate: (document.getElementById('output-rtmp-abitrate') as HTMLSelectElement)?.value || '128k',
        encoder_mode: 'auto'
      };
    }
    
    const success = await addOutput({ name, type, config });
    if (success) {
      hideOutputForm();
      const outputList = await fetchOutputs();
      renderOutputs(outputList);
    }
  }

  document.getElementById('btn-add-output')?.addEventListener('click', showOutputForm);
  document.getElementById('btn-add-first-output')?.addEventListener('click', showOutputForm);
  document.getElementById('btn-close-output-form')?.addEventListener('click', hideOutputForm);
  document.getElementById('output-form-backdrop')?.addEventListener('click', hideOutputForm);
  document.getElementById('btn-cancel-output')?.addEventListener('click', hideOutputForm);
  document.getElementById('btn-save-output')?.addEventListener('click', handleSaveOutput);
  
  document.getElementById('new-output-type')?.addEventListener('change', (e) => {
    updateOutputTypeSettings((e.target as HTMLSelectElement).value);
  });
  
  document.getElementById('output-recording-quality')?.addEventListener('change', () => {
    updateOutputTypeSettings('recording');
  });
  
  document.getElementById('output-recording-split')?.addEventListener('change', () => {
    updateOutputTypeSettings('recording');
  });
  
  fetchOutputs().then(renderOutputs).catch(() => renderOutputs([]));
  
  (window as unknown as { refreshOutputs: () => Promise<void> }).refreshOutputs = async () => {
    const outputList = await fetchOutputs();
    renderOutputs(outputList);
  };
</script>