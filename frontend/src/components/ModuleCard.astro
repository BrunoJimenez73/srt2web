---
interface Props {
  id: string;
  name: string;
  enabled?: boolean;
}

const { id, name, enabled = true } = Astro.props;
---

<div class="module-card" id={`mod-${id}`}>
    <div class="module-header">
        <span class="module-name">
            <span class="status-dot" id={`status-${id}`}></span>
            {name}
        </span>
        <label class="toggle-switch">
            <input type="checkbox" id={`adv-${id}-enabled`} checked={enabled} />
            <span class="toggle-slider"></span>
        </label>
    </div>
    <div class="module-settings">
        <slot />
    </div>
</div>

<style>
    .module-card {
        background: var(--bg-card);
        border: 1px solid var(--border-dim);
        border-radius: var(--radius-md);
        padding: 10px;
    }

    .module-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }

    .module-name {
        font-size: 11px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--text-dim);
    }

    .status-dot.running {
        background: #00ff00;
        box-shadow: 0 0 6px #00ff00;
    }

    .status-dot.disabled {
        opacity: 0.5;
    }

    .module-settings {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .toggle-switch {
        position: relative;
        display: inline-block;
        width: 36px;
        height: 20px;
    }

    .toggle-switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .toggle-slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: var(--text-dim);
        transition: 0.3s;
        border-radius: 20px;
    }

    .toggle-slider:before {
        position: absolute;
        content: "";
        height: 14px;
        width: 14px;
        left: 3px;
        bottom: 3px;
        background-color: white;
        transition: 0.3s;
        border-radius: 50%;
    }

    input:checked + .toggle-slider {
        background-color: var(--success);
    }

    input:checked + .toggle-slider:before {
        transform: translateX(16px);
    }

    .form-group {
        margin-bottom: 4px;
    }

    .form-label {
        display: block;
        font-size: 9px;
        color: var(--text-sec);
        margin-bottom: 2px;
    }

    .form-input, .form-select {
        width: 100%;
        padding: 6px 8px;
        background: var(--bg-surface);
        border: 1px solid var(--border-dim);
        border-radius: var(--radius-sm);
        color: var(--text-prime);
        font-size: 11px;
    }
</style>