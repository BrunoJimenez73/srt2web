---
import type { OutputStatus } from '../lib/types';

interface Props {
  output: OutputStatus;
  error: string | null;
  onRemove: () => void;
  onReconnect: () => void;
  onEnable: (enable: boolean) => void;
}

const { output, error, onRemove, onReconnect, onEnable } = Astro.props;

// Obtener clase de estado
const getStateClass = (state: string) => {
  switch (state) {
    case 'running': return 'bg-green-100 text-green-800';
    case 'starting': return 'bg-yellow-100 text-yellow-800';
    case 'stopping': return 'bg-orange-100 text-orange-800';
    case 'stopped': return 'bg-gray-100 text-gray-800';
    default: return 'bg-gray-100 text-gray-800';
  }
};

// Obtener texto de estado
const getStateText = (state: string) => {
  switch (state) {
    case 'running': return 'En ejecución';
    case 'starting': return 'Iniciando';
    case 'stopping': return 'Deteniendo';
    case 'stopped': return 'Detenido';
    default: return 'Desconocido';
  }
};

// Obtener icono de tipo
const getTypeIcon = (type: string) => {
  switch (type) {
    case 'srt': return '📡';
    case 'file': return '💾';
    case 'rtmp': return '🎬';
    case 'web': return '🌐';
    default: return '📤';
  }
};

// Obtener nombre del tipo
const getTypeName = (type: string) => {
  switch (type) {
    case 'srt': return 'SRT';
    case 'file': return 'Archivo';
    case 'rtmp': return 'RTMP';
    case 'web': return 'Web/HLS';
    default: return 'Salida';
  }
};
---
<div class="bg-white rounded-lg border border-gray-200 p-4 shadow-sm hover:shadow-md transition-shadow">
  <div class="flex items-center justify-between mb-3">
    <div class="flex items-center space-x-2">
      <span class="text-2xl">{getTypeIcon(output.type)}</span>
      <div>
        <h5 class="font-medium text-gray-900">{output.name}</h5>
        <p class="text-sm text-gray-500">{getTypeName(output.type)}</p>
      </div>
    </div>
    <span class={`px-2 py-1 text-xs font-medium rounded-full ${getStateClass(output.state)}`}>
      {getStateText(output.state)}
    </span>
  </div>

  <!-- Error -->
  {error && (
    <div class="mb-3 p-2 bg-red-50 border border-red-200 rounded-md text-sm text-red-700">
      {error}
    </div>
  )}

  <!-- Métricas -->
  <div class="grid grid-cols-2 gap-2 mb-3 text-sm">
    <div>
      <span class="text-gray-500">Chunks:</span>
      <span class="font-medium ml-1">{output.processed_chunks}</span>
    </div>
    <div>
      <span class="text-gray-500">Tiempo:</span>
      <span class="font-medium ml-1">{output.last_process_time_ms.toFixed(1)} ms</span>
    </div>
  </div>

  <!-- Controles -->
  <div class="flex items-center justify-between pt-3 border-t border-gray-100">
    <div class="flex items-center space-x-2">
      <label class="flex items-center space-x-1 text-sm">
        <input
          type="checkbox"
          checked={output.enabled}
          onchange={(e) => onEnable((e.target as HTMLInputElement).checked)}
          class="rounded text-blue-600 focus:ring-blue-500"
        />
        <span class="text-gray-700">Habilitado</span>
      </label>
    </div>
    <div class="flex space-x-2">
      <button
        onclick={onReconnect}
        class="px-2 py-1 text-xs bg-blue-100 text-blue-700 rounded hover:bg-blue-200 transition-colors"
      >
        Reconectar
      </button>
      <button
        onclick={onRemove}
        class="px-2 py-1 text-xs bg-red-100 text-red-700 rounded hover:bg-red-200 transition-colors"
      >
        Eliminar
      </button>
    </div>
  </div>
</div>