---
import { t, initLanguage } from "../lib/i18n";
const _lang = initLanguage();

interface Props {
  version?: string;
}

const { version = 'dev' } = Astro.props;
---

<header class="header">
  <div class="logo">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" fill="none" aria-hidden="true">
      <circle cx="16" cy="16" r="14" stroke="url(#grad)" stroke-width="2"/>
      <path d="M10 20L16 10L22 20H10Z" fill="url(#grad)"/>
      <defs>
        <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#6366f1"/>
          <stop offset="100%" stop-color="#a855f7"/>
        </linearGradient>
      </defs>
    </svg>
    <span class="logo-text">SRT2Web</span>
    <span class="version-badge">{version}</span>
  </div>

  <div class="header-right">
    <!-- Theme Toggle -->
    <button class="btn-theme" id="btn-theme-toggle" aria-label="Toggle theme">
      <span id="theme-icon">🌙</span>
    </button>

    <!-- Language Selector -->
    <select class="lang-select" id="lang-select" aria-label={t("language_selector")}>
      <option value="en">🇬🇧 EN</option>
      <option value="es">🇪🇸 ES</option>
    </select>

    <a href="/docs/" class="btn-docs" target="_blank">
      📚 {t("docs")}
    </a>

    <!-- Shortcuts Help -->
    <button class="btn-shortcuts" id="btn-shortcuts-help" aria-label={t("keyboard_shortcuts")} title={t("keyboard_shortcuts")}>
      ⌨️
    </button>
    <div id="ws-status" class="ws-status disconnected" role="status" aria-label="Estado de conexión WebSocket">
      <span class="ws-status-dot"></span>
      <span class="ws-status-label" id="ws-status-label">{t("ws_off")}</span>
    </div>

    <!-- Security Toggle -->
    <div class="security-wrapper">
      <button class="btn-secure" id="btn-secure-toggle" aria-label="Configurar autenticación" aria-expanded="false" aria-controls="secure-panel">
        <span class="secure-icon" aria-hidden="true">🔐</span>
        <span class="secure-label" id="secure-label">{t("security_off")}</span>
        <span class="secure-arrow" id="secure-arrow">▾</span>
      </button>
      <div class="secure-panel" id="secure-panel">
        <div class="secure-panel-header">
          <span>{t("auth_token")}</span>
          <button class="btn-close-panel" id="btn-close-secure" aria-label={t("close_panel")}>✕</button>
        </div>
        <div class="secure-input-row">
          <input type="password" class="secure-input" id="secure-token-input" placeholder={t("token_placeholder")} aria-label={t("auth_token")} />
          <button class="btn-eye" id="btn-eye-token" aria-label={t("show_hide")} title={t("show_hide")}>👁</button>
        </div>
        <div class="secure-actions">
          <button class="btn-gen" id="btn-gen-token" aria-label={t("generate_token")} title={t("generate_token")}>🎲</button>
          <button class="btn-save-token" id="btn-save-secure">💾 {t("save_token")}</button>
        </div>
      </div>
    </div>

    <span id="live-clock" class="live-clock">--:--:--</span>
    <button class="btn-save" id="btn-save-config" onclick="saveConfig()" aria-label={t("save_config")}>
      <span class="btn-text">💾 {t("save_config")}</span>
      <span class="btn-loading" aria-hidden="true"></span>
    </button>
  </div>
</header>

<style>
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-dim);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .logo svg {
    width: 32px;
    height: 32px;
  }

  .logo-text {
    font-size: 18px;
    font-weight: 700;
    background: linear-gradient(135deg, #6366f1, #a855f7);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .version-badge {
    background: var(--bg-card);
    padding: 2px 8px;
    border-radius: 10px;
    font-size: 11px;
    color: var(--text-sec);
    border: 1px solid var(--border-dim);
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .lang-select {
    background: var(--bg-card);
    border: 1px solid var(--border-dim);
    color: var(--text-prime);
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    outline: none;
    transition: border-color 0.2s;
  }

  .lang-select:hover, .lang-select:focus {
    border-color: var(--accent);
  }

  .lang-select option {
    background: var(--bg-surface);
    color: var(--text-prime);
  }

  .btn-theme {
    background: var(--bg-card);
    border: 1px solid var(--border-dim);
    color: var(--text-prime);
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    font-size: 14px;
    cursor: pointer;
    line-height: 1;
    transition: all 0.2s;
    display: flex;
    align-items: center;
  }

  .btn-theme:hover {
    border-color: var(--accent);
  }

  .btn-shortcuts {
    background: var(--bg-card);
    border: 1px solid var(--border-dim);
    color: var(--text-sec);
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    cursor: pointer;
    line-height: 1;
    transition: all 0.2s;
  }

  .btn-shortcuts:hover {
    border-color: var(--accent);
    color: var(--text-prime);
  }

  .btn-docs {
    background: transparent;
    color: var(--text-sec);
    text-decoration: none;
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    font-size: 11px;
    font-weight: 600;
    transition: all 0.2s;
    border: 1px solid var(--border-dim);
  }

  .btn-docs:hover {
    background: var(--bg-card);
    color: var(--text);
    border-color: var(--accent);
  }

  .btn-save {
    background: var(--accent);
    color: white;
    border: none;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-save:hover {
    background: var(--accent-hover);
  }

  .btn-save.loading .btn-text {
    display: none;
  }

  .btn-save.loading .btn-loading {
    display: inline;
    animation: spin 1s linear infinite;
  }

  .btn-loading {
    display: none;
  }

  /* Security Toggle */
  .security-wrapper {
    position: relative;
  }

  .btn-secure {
    display: flex;
    align-items: center;
    gap: 6px;
    background: var(--bg-card);
    border: 1px solid var(--border-dim);
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    font-size: 11px;
    color: var(--text-sec);
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-secure:hover {
    border-color: var(--accent);
  }

  .btn-secure.active {
    background: rgba(34, 197, 94, 0.1);
    border-color: #22c55e;
    color: #22c55e;
  }

  .secure-icon {
    font-size: 12px;
  }

  .secure-label {
    font-weight: 500;
  }

  .secure-arrow {
    font-size: 10px;
    transition: transform 0.2s;
  }

  .secure-arrow.open {
    transform: rotate(180deg);
  }

  .secure-panel {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: 280px;
    background: var(--bg-card);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-md);
    padding: 12px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.5);
    z-index: 100;
    display: none;
  }

  .secure-panel.open {
    display: block;
    animation: fadeIn 0.15s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .secure-panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
    font-size: 11px;
    font-weight: 600;
    color: var(--text-sec);
  }

  .btn-close-panel {
    background: none;
    border: none;
    color: var(--text-dim);
    cursor: pointer;
    font-size: 12px;
    padding: 2px 4px;
  }

  .btn-close-panel:hover {
    color: var(--text);
  }

  .secure-input-row {
    display: flex;
    gap: 4px;
    margin-bottom: 10px;
  }

  .secure-input {
    flex: 1;
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-sm);
    padding: 6px 8px;
    font-size: 11px;
    color: var(--text-prime);
    font-family: 'JetBrains Mono', monospace;
    outline: none;
  }

  .secure-input:focus {
    border-color: var(--accent);
  }

  .btn-eye {
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-sm);
    padding: 6px 8px;
    cursor: pointer;
    font-size: 11px;
  }

  .secure-actions {
    display: flex;
    gap: 6px;
  }

  .btn-gen {
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-sm);
    padding: 6px 10px;
    cursor: pointer;
    font-size: 12px;
    transition: all 0.2s;
  }

  .btn-gen:hover {
    background: var(--bg-card-hover, rgba(255,255,255,0.05));
  }

  .btn-save-token {
    flex: 1;
    background: var(--accent);
    color: white;
    border: none;
    border-radius: var(--radius-sm);
    padding: 6px 10px;
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-save-token:hover {
    background: var(--accent-hover);
  }

  .live-clock {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--text-dim);
    padding: 0 8px;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @media (max-width: 768px) {
    .btn-docs, .live-clock {
      display: none;
    }
    .secure-label {
      display: none;
    }
    .secure-panel {
      width: 240px;
    }
  }
</style>

<script>
  import { getAuthToken, setAuthToken } from '../lib/api.ts';

  const btnToggle = document.getElementById('btn-secure-toggle') as HTMLButtonElement;
  const panel = document.getElementById('secure-panel') as HTMLDivElement;
  const arrow = document.getElementById('secure-arrow') as HTMLSpanElement;
  const label = document.getElementById('secure-label') as HTMLSpanElement;
  const tokenInput = document.getElementById('secure-token-input') as HTMLInputElement;
  const btnEye = document.getElementById('btn-eye-token') as HTMLButtonElement;
  const btnGen = document.getElementById('btn-gen-token') as HTMLButtonElement;
  const btnSave = document.getElementById('btn-save-secure') as HTMLButtonElement;
  const btnClose = document.getElementById('btn-close-secure') as HTMLButtonElement;

  // Update UI based on token state
  function updateSecureState() {
    const token = getAuthToken();
    if (token) {
      label.textContent = 'Secure ON';
      btnToggle.classList.add('active');
      tokenInput.value = token;
    } else {
      label.textContent = 'Secure OFF';
      btnToggle.classList.remove('active');
      tokenInput.value = '';
    }
  }

  // Toggle panel
  btnToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    panel.classList.toggle('open');
    arrow.classList.toggle('open');
    btnToggle.setAttribute('aria-expanded', panel.classList.contains('open') ? 'true' : 'false');
    updateSecureState();
  });

  // Close panel
  btnClose?.addEventListener('click', () => {
    panel.classList.remove('open');
    arrow.classList.remove('open');
    btnToggle.setAttribute('aria-expanded', 'false');
  });

  // Close on click outside
  document.addEventListener('click', (e) => {
    if (!panel.contains(e.target as Node) && !btnToggle.contains(e.target as Node)) {
      panel.classList.remove('open');
      arrow.classList.remove('open');
      btnToggle.setAttribute('aria-expanded', 'false');
    }
  });

  // Toggle password visibility
  btnEye?.addEventListener('click', () => {
    if (tokenInput.type === 'password') {
      tokenInput.type = 'text';
      btnEye.textContent = '🙈';
    } else {
      tokenInput.type = 'password';
      btnEye.textContent = '👁';
    }
  });

  // Generate token
  btnGen?.addEventListener('click', () => {
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
    const length = 32;
    let token = '';
    const array = new Uint32Array(length);
    crypto.getRandomValues(array);
    for (let i = 0; i < length; i++) {
      token += chars[array[i] % chars.length];
    }
    tokenInput.value = token;
    tokenInput.type = 'text';
    btnEye.textContent = '🙈';
  });

  // Save token
  btnSave?.addEventListener('click', () => {
    const token = tokenInput.value.trim();
    setAuthToken(token);
    updateSecureState();

    // Show toast
    const toastEvent = new CustomEvent('toast', {
      detail: {
        message: token ? '🔐 Token guardado. Recarga para aplicar.' : '🔓 Autenticación desactivada.',
        type: token ? 'success' : 'info'
      }
    });
    document.dispatchEvent(toastEvent);

    // Close panel
    panel.classList.remove('open');
    arrow.classList.remove('open');
  });

  // Language selector: change → persist + reload
  const langSelect = document.getElementById('lang-select') as HTMLSelectElement;
  if (langSelect) {
    const currentLang = localStorage.getItem('srt2web_language') || 'es';
    langSelect.value = currentLang;
    langSelect.addEventListener('change', () => {
      localStorage.setItem('srt2web_language', langSelect.value);
      location.reload();
    });
  }

  // Shortcuts help button: dispatch ? key to trigger modal
  const shortcutsBtn = document.getElementById('btn-shortcuts-help');
  shortcutsBtn?.addEventListener('click', () => {
    document.dispatchEvent(new KeyboardEvent('keydown', { key: '?' }));
  });

  // Theme toggle: change → persist (no reload)
  const themeBtn = document.getElementById('btn-theme-toggle') as HTMLButtonElement;
  const themeIcon = document.getElementById('theme-icon') as HTMLSpanElement;
  if (themeBtn) {
    const isDark = document.documentElement.classList.contains('dark');
    themeIcon.textContent = isDark ? '🌙' : '☀️';
    themeBtn.addEventListener('click', () => {
      const currentlyDark = document.documentElement.classList.contains('dark');
      if (currentlyDark) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('srt2web_theme', 'light');
        themeIcon.textContent = '☀️';
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('srt2web_theme', 'dark');
        themeIcon.textContent = '🌙';
      }
    });
  }

  // Initial state
  updateSecureState();

  // Reactive WS status
  import { effect } from "@preact/signals-core";
  import { wsConnected } from "../lib/store/signals";
  import { t } from "../lib/i18n";

  effect(() => {
    const connected = wsConnected.value;
    const badge = document.getElementById('ws-status');
    const label = document.getElementById('ws-status-label');
    if (badge) {
      badge.className = `ws-status ${connected ? 'connected' : 'disconnected'}`;
    }
    if (label) label.textContent = connected ? t('ws_on') : t('ws_off');
  });

  // Close panel on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel.classList.contains('open')) {
      panel.classList.remove('open');
      arrow.classList.remove('open');
      btnToggle.setAttribute('aria-expanded', 'false');
      btnToggle.focus();
    }
  });
</script>
