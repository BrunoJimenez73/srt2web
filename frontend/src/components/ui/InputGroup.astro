---
import type { HTMLAttributes } from 'astro/types';

type InputType = 'text' | 'number' | 'password' | 'email' | 'url' | 'tel';
type InputSize = 'sm' | 'md' | 'lg';

interface Props extends Omit<HTMLAttributes<'input'>, 'type'> {
  type?: InputType;
  label?: string;
  placeholder?: string;
  size?: InputSize;
  error?: boolean;
  helperText?: string;
  rightAddon?: string;
}

const {
  type = 'text',
  label,
  placeholder,
  size = 'md',
  error = false,
  helperText,
  rightAddon,
  class: className = '',
  id,
  name,
  disabled,
  readonly,
  value,
  ...rest
} = Astro.props;

const sizeClasses = {
  sm: 'px-2 py-1 text-xs',
  md: 'px-3 py-1.5 text-xs',
  lg: 'px-4 py-2 text-sm',
};

const baseClasses = `w-full bg-deep border rounded-sm text-surface-light font-size-12 outline-none transition-all duration-200 placeholder:text-surface-dimmer`;
const disabledClasses = disabled ? 'opacity-50 cursor-not-allowed' : '';
const readonlyClasses = readonly ? 'bg-surface cursor-default' : '';
const errorClasses = error ? 'border-error focus:border-error focus:shadow-[0_0_0_3px_rgba(239,68,68,0.2)]' : 'border-white/8 focus:border-accent focus:shadow-[0_0_0_3px_rgba(99,102,241,0.2)]';
const addonClasses = rightAddon ? 'rounded-r-none' : '';
const allClasses = `${baseClasses} ${sizeClasses[size]} ${disabledClasses} ${readonlyClasses} ${errorClasses} ${addonClasses} ${className}`.trim();
---

<div class="form-group">
  {label && (
    <label class="form-label" for={id}>
      {label}
    </label>
  )}
  <div class="flex items-center">
    <input
      type={type}
      class={allClasses}
      id={id}
      name={name}
      placeholder={placeholder}
      disabled={disabled}
      readonly={readonly}
      value={value}
      {...rest}
    />
    {rightAddon && (
      <span class="px-3 py-1.5 bg-surface border border-l-0 border-white/8 rounded-sm text-xs text-surface-dim">
        {rightAddon}
      </span>
    )}
  </div>
  {helperText && (
    <p class={`mt-1 text-xs ${error ? 'text-error' : 'text-surface-dim'}`}>
      {helperText}
    </p>
  )}
</div>