---
import type { HTMLAttributes } from 'astro/types';

type BadgeVariants = 'accent' | 'success' | 'warning' | 'error' | 'default';
type BadgeSizes = 'sm' | 'md';

interface Props extends HTMLAttributes<'span'> {
  variant?: BadgeVariants;
  size?: BadgeSizes;
}

const {
  variant = 'default',
  size = 'sm',
  class: className = '',
  ...rest
} = Astro.props as Props;

const variantClasses = {
  accent: 'bg-accent/20 text-accent',
  success: 'bg-success/20 text-success',
  warning: 'bg-warning/20 text-warning',
  error: 'bg-error/20 text-error',
  default: 'bg-surface text-surface-light',
};

const sizeClasses = {
  sm: 'px-2 py-0.5 text-xs',
  md: 'px-2.5 py-1 text-xs',
};

const baseClasses = 'inline-flex items-center rounded font-semibold uppercase tracking-wide';
const allClasses = `${baseClasses} ${variantClasses[variant]} ${sizeClasses[size]} ${className}`.trim();
---

<span class={allClasses} {...rest}>
  <slot />
</span>