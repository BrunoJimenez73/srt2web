---
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'label'>, 'children'> {
  checked?: boolean;
  disabled?: boolean;
  id?: string;
  name?: string;
}

const {
  checked = false,
  disabled = false,
  id,
  name,
  class: className = '',
  ...rest
} = Astro.props as Props;

const wrapperClasses = `relative inline-block w-9 h-5 ${disabled ? 'opacity-50 cursor-not-allowed' : 'cursor-pointer'} ${className}`.trim();
const sliderClasses = 'absolute inset-0 bg-surface-dimmer rounded-full transition-all duration-300 before:content-[""] before:absolute before:w-3.5 before:h-3.5 before:left-0.5 before:bottom-0.5 before:bg-white before:rounded-full before:transition-all before:duration-300';
const checkedClasses = checked ? 'bg-success before:translate-x-4' : '';
---

<label class={wrapperClasses}>
  <input
    type="checkbox"
    class="sr-only peer"
    checked={checked}
    disabled={disabled}
    id={id}
    name={name}
    {...rest}
  />
  <div class:list={[sliderClasses, checkedClasses]}></div>
</label>
