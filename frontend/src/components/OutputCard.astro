---
---

<div class="output-card" id="card-output">
  <div class="process-header">
    <span class="process-indicator" id="indicator-output"></span>
    <span class="process-title">🎬 OUTPUT</span>
  </div>
  <div class="process-content">
    <div class="output-stats">
      <div class="stat-item">
        <span class="stat-label">Chunks</span>
        <span class="stat-value" id="stat-chunks">0</span>
      </div>
      <div class="stat-item">
        <span class="stat-label">Estado</span>
        <span class="stat-value" id="stat-state">idle</span>
      </div>
    </div>
    <div class="form-group" id="output-metrics">
      <label class="form-label">Métricas</label>
      <div class="metrics-row">
        <div class="metric-mini">
          <span class="metric-label">Tiempo</span>
          <span class="metric-value" id="module-time-output">--</span>
        </div>
        <div class="metric-mini">
          <span class="metric-label">Chunks</span>
          <span class="metric-value" id="module-chunks-output">--</span>
        </div>
        <div class="metric-mini">
          <span class="metric-label">Device</span>
          <span class="metric-value" id="module-device-output">--</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .output-card {
    background: var(--bg-card);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-md);
    padding: 12px;
    transition: all 0.3s ease;
  }

  .output-card.active {
    border-color: var(--success) !important;
    box-shadow: 0 0 12px rgba(16, 185, 129, 0.3) !important;
  }

  .process-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }

  .process-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--text-dim);
    transition: all 0.3s ease;
  }

  .process-indicator.active {
    background: #00ff00 !important;
    box-shadow: 0 0 6px #00ff00, 0 0 12px #00ff00 !important;
    animation: indicator-pulse 1.5s ease-in-out infinite;
  }

  @keyframes indicator-pulse {
    0%, 100% { opacity: 0.8; }
    50% { opacity: 1; }
  }

  .process-title {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-prime);
  }

  .process-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .output-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .stat-item {
    background: var(--bg-surface);
    padding: 8px;
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .stat-label {
    font-size: 9px;
    color: var(--text-sec);
    text-transform: uppercase;
  }

  .stat-value {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-prime);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .form-label {
    font-size: 10px;
    color: var(--text-sec);
    font-weight: 500;
  }

  .metrics-row {
    display: flex;
    gap: 12px;
    padding: 8px;
    background: var(--bg-surface);
    border-radius: var(--radius-sm);
  }

  .metric-mini {
    flex: 1;
    text-align: center;
  }

  .metric-mini .metric-label {
    display: block;
    font-size: 9px;
    color: var(--text-sec);
    margin-bottom: 2px;
  }

  .metric-mini .metric-value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    color: var(--text-prime);
  }
</style>
