---
---

<div class="output-card" id="card-output">
  <div class="process-header">
    <span class="process-indicator" id="indicator-output"></span>
    <span class="process-title">🎬 OUTPUT</span>
  </div>
  <div class="process-content">
    <!-- Formato selector -->
    <div class="form-group">
      <label class="form-label">Formato</label>
      <select class="form-select" id="output-format" onchange="handleOutputFormatChange(this.value)">
        <option value="web">Web Player (HLS)</option>
        <option value="srt">SRT</option>
        <option value="rtmp">RTMP</option>
        <option value="file">File</option>
      </select>
    </div>
    
    <!-- Web Player Settings -->
    <div class="output-settings" id="web-settings">
      <div class="output-stats">
        <div class="stat-item">
          <span class="stat-label">Chunks</span>
          <span class="stat-value" id="stat-chunks">0</span>
        </div>
        <div class="stat-item">
          <span class="stat-label">Estado</span>
          <span class="stat-value" id="stat-state">idle</span>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">URL del Player</label>
        <div class="url-display">
          <span id="url-player-display">http://localhost:9999/player</span>
        </div>
      </div>
    </div>
    
    <!-- SRT Settings -->
    <div class="output-settings" id="output-srt-settings" style="display: none;">
      <div class="form-group">
        <label class="form-label">URL SRT</label>
        <input type="text" class="form-input" id="output-srt-url" placeholder="srt://localhost:9001" />
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Modo</label>
          <select class="form-select" id="output-srt-mode">
            <option value="caller">Caller</option>
            <option value="listener">Listener</option>
            <option value="rendezvous">Rendezvous</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Latencia (ms)</label>
          <input type="number" class="form-input" id="output-srt-latency" value="200" min="0" max="5000" />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Video Bitrate</label>
          <select class="form-select" id="output-srt-video-bitrate">
            <option value="1500k">1500 kbps</option>
            <option value="2500k">2500 kbps</option>
            <option value="4000k">4000 kbps</option>
            <option value="6000k">6000 kbps</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Audio Bitrate</label>
          <select class="form-select" id="output-srt-audio-bitrate">
            <option value="96k">96 kbps</option>
            <option value="128k">128 kbps</option>
            <option value="192k">192 kbps</option>
          </select>
        </div>
      </div>
    </div>
    
    <!-- RTMP Settings -->
    <div class="output-settings" id="output-rtmp-settings" style="display: none;">
      <div class="form-group">
        <label class="form-label">URL RTMP</label>
        <input type="text" class="form-input" id="output-rtmp-url" placeholder="rtmp://a.rtmp.youtube.com/live2/xxxx-xxxx-xxxx-xxxx" />
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Video Bitrate</label>
          <select class="form-select" id="output-rtmp-video-bitrate">
            <option value="1500k">1500 kbps</option>
            <option value="2500k" selected>2500 kbps</option>
            <option value="4000k">4000 kbps</option>
            <option value="6000k">6000 kbps</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Audio Bitrate</label>
          <select class="form-select" id="output-rtmp-audio-bitrate">
            <option value="96k">96 kbps</option>
            <option value="128k" selected>128 kbps</option>
            <option value="192k">192 kbps</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Encoder</label>
        <select class="form-select" id="output-rtmp-encoder">
          <option value="auto">Auto (GPU/CPU)</option>
          <option value="cpu">CPU (libx264)</option>
          <option value="gpu_nvenc">NVIDIA NVENC</option>
          <option value="gpu_amf">AMD AMF</option>
          <option value="gpu_qsv">Intel QSV</option>
        </select>
      </div>
    </div>
    
    <!-- File Settings -->
    <div class="output-settings" id="output-file-settings" style="display: none;">
      <div class="form-group">
        <label class="form-label">Directorio de Salida</label>
        <input type="text" class="form-input" id="output-file-path" value="./output" />
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Guardar Video</label>
          <select class="form-select" id="output-file-video">
            <option value="true">Sí</option>
            <option value="false">No</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Guardar Audio</label>
          <select class="form-select" id="output-file-audio">
            <option value="true">Sí</option>
            <option value="false">No</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Guardar Subtítulos</label>
        <select class="form-select" id="output-file-subs">
          <option value="true">Sí</option>
          <option value="false">No</option>
        </select>
      </div>
    </div>
    
    <!-- Metrics -->
    <div class="form-group" id="output-metrics">
      <label class="form-label">Métricas</label>
      <div class="metrics-row">
        <div class="metric-mini">
          <span class="metric-label">Tiempo</span>
          <span class="metric-value" id="module-time-output">--</span>
        </div>
        <div class="metric-mini">
          <span class="metric-label">Chunks</span>
          <span class="metric-value" id="module-chunks-output">--</span>
        </div>
        <div class="metric-mini">
          <span class="metric-label">Formato</span>
          <span class="metric-value" id="module-format-output">--</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .output-card {
    background: var(--bg-card);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-md);
    padding: 12px;
    transition: all 0.3s ease;
  }

  .output-card.active {
    border-color: var(--success) !important;
    box-shadow: 0 0 12px rgba(16, 185, 129, 0.3) !important;
  }

  .process-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }

  .process-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--text-dim);
    transition: all 0.3s ease;
  }

  .process-indicator.active {
    background: #00ff00 !important;
    box-shadow: 0 0 6px #00ff00, 0 0 12px #00ff00 !important;
    animation: indicator-pulse 1.5s ease-in-out infinite;
  }

  @keyframes indicator-pulse {
    0%, 100% { opacity: 0.8; }
    50% { opacity: 1; }
  }

  .process-title {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-prime);
    flex: 1;
  }

  .toggle-switch {
    position: relative;
    display: inline-block;
    width: 36px;
    height: 20px;
  }

  .toggle-switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .toggle-slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--text-dim);
    transition: 0.3s;
    border-radius: 20px;
  }

  .toggle-slider:before {
    position: absolute;
    content: "";
    height: 14px;
    width: 14px;
    left: 3px;
    bottom: 3px;
    background-color: white;
    transition: 0.3s;
    border-radius: 50%;
  }

  input:checked + .toggle-slider {
    background-color: var(--success);
  }

  input:checked + .toggle-slider:before {
    transform: translateX(16px);
  }

  .process-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .output-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .stat-item {
    background: var(--bg-surface);
    padding: 8px;
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .stat-label {
    font-size: 9px;
    color: var(--text-sec);
    text-transform: uppercase;
  }

  .stat-value {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-prime);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .form-label {
    font-size: 10px;
    color: var(--text-sec);
    font-weight: 500;
  }

  .form-input, .form-select {
    width: 100%;
    padding: 8px 10px;
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-sm);
    color: var(--text-prime);
    font-size: 12px;
    outline: none;
    transition: border-color 0.2s;
  }

  .form-input:focus, .form-select:focus {
    border-color: var(--accent);
  }

  .form-select {
    cursor: pointer;
  }

  .output-settings {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .url-display {
    background: var(--bg-surface);
    padding: 8px;
    border-radius: var(--radius-sm);
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--text-prime);
    word-break: break-all;
  }

  .metrics-row {
    display: flex;
    gap: 12px;
    padding: 8px;
    background: var(--bg-surface);
    border-radius: var(--radius-sm);
  }

  .metric-mini {
    flex: 1;
    text-align: center;
  }

  .metric-mini .metric-label {
    display: block;
    font-size: 9px;
    color: var(--text-sec);
    margin-bottom: 2px;
  }

  .metric-mini .metric-value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    color: var(--text-prime);
  }
</style>
