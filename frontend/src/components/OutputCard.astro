---
---
<div class="output-card" id="card-output">
  <div class="process-header">
    <span class="process-indicator" id="indicator-output"></span>
    <span class="process-title">📤 OUTPUT</span>
  </div>
  <div class="process-content">
    <div class="output-list" id="output-list"></div>
    <div class="metrics-row">
      <span class="metric-mini"><span class="metric-label">Tiempo</span><span class="metric-value" id="module-time-output">--</span></span>
      <span class="metric-mini"><span class="metric-label">Chunks</span><span class="metric-value" id="module-chunks-output">--</span></span>
    </div>
  </div>
</div>

<style>
.output-card {
  background: var(--bg-card);
  border: 1px solid var(--border-dim);
  border-radius: var(--radius-md);
  padding: 12px;
}
.process-header {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 8px;
}
.process-indicator {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--text-dim);
}
.process-indicator.active {
  background: #00ff00;
  box-shadow: 0 0 6px #00ff00;
}
.process-title {
  font-weight: 600;
  font-size: 13px;
}
.output-list {
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin-bottom: 8px;
}
.output-item {
  background: var(--bg-deep);
  border: 1px solid var(--border-dim);
  border-radius: var(--radius-sm);
  padding: 6px 8px;
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 11px;
}
.output-item.active {
  border-color: var(--success);
  background: rgba(16,185,129,0.1);
}
.output-icon { font-size: 12px; }
.output-name { color: var(--text-prime); flex: 1; }
.output-type { color: var(--text-sec); font-size: 10px; text-transform: uppercase; }
.output-state { font-weight: 600; margin-left: auto; }
.output-state.running { color: var(--success); }
.output-chunks { color: var(--text-sec); }
.metrics-row {
  display: flex;
  gap: 16px;
  font-size: 11px;
}
.metric-mini {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.metric-label { color: var(--text-sec); font-size: 10px; }
.metric-value { color: var(--text-prime); font-weight: 600; font-size: 14px; }
</style>

<script>
const TYPE_ICONS = { web: '🌐', recording: '⏺', srt: '📡', rtmp: '📺', file: '📁' };
const TYPE_NAMES = { web: 'HLS', recording: 'Grabar', srt: 'SRT', rtmp: 'RTMP', file: 'Archivo' };

function renderOutputs(list) {
  const el = document.getElementById('output-list');
  if (!el) return;
  if (!list || list.length === 0) {
    el.innerHTML = '<div style="padding:8px;color:var(--text-sec);font-size:12px;">Sin salidas</div>';
    return;
  }
  el.innerHTML = list.map(o => `
    <div class="output-item ${o.state === 'running' ? 'active' : ''}">
      <span class="output-icon">${TYPE_ICONS[o.type] || '📤'}</span>
      <span class="output-name">${o.name}</span>
      <span class="output-type">${TYPE_NAMES[o.type] || o.type}</span>
      <span class="output-state ${o.state}">${o.state === 'running' ? '✓' : ''}</span>
      <span class="output-chunks">${o.processed_chunks || 0}</span>
    </div>
  `).join('');
}

function loadOutputs() {
  fetch('/api/outputs').then(r => r.json()).then(renderOutputs).catch(() => {});
}

if (typeof window !== 'undefined') {
  loadOutputs();
  setInterval(loadOutputs, 3000);
}
</script>