---
---

<div class="tts-card collapsible-card" id="card-tts">
  <div class="process-header">
    <span class="process-indicator" id="indicator-tts"></span>
    <span class="process-title">🎤 DOBLAR</span>
    <span class="gpu-badge" id="gpu-badge-tts_engine" style="display: none;" role="status" aria-label="Aceleración GPU">GPU</span>
    <label class="toggle-switch" aria-label="Activar/desactivar doblaje de audio">
      <input type="checkbox" id="tts-enabled" onchange="window.toggleModule('tts_engine', this.checked)" />
      <span class="toggle-slider"></span>
    </label>
  </div>
    <div class="process-content">
      <div class="form-group">
        <label class="form-label" for="tts-engine">Motor</label>
        <select class="form-select" id="tts-engine" onchange="window.handleTtsEngineChange(this.value)">
          <option value="edge-tts">Edge-TTS (Cloud)</option>
          <option value="piper">Piper (Local)</option>
        </select>
      </div>
      <div class="form-group" id="tts-device-group" style="display: none;">
        <label class="form-label" for="tts-device">Device</label>
        <select class="form-select" id="tts-device">
          <option value="auto">Auto</option>
          <option value="cuda">GPU</option>
          <option value="cpu">CPU</option>
        </select>
      </div>
      <div class="form-group" id="tts-voice-edge-group">
        <label class="form-label" for="tts-voice-edge">Voz (Edge-TTS)</label>
        <select class="form-select" id="tts-voice-edge">
          <option value="es-ES-AlvaroNeural">Alvaro (ES)</option>
          <option value="es-ES-ElviraNeural">Elvira (ES)</option>
          <option value="en-US-AriaNeural">Aria (EN)</option>
          <option value="en-US-GuyNeural">Guy (EN)</option>
          <option value="fr-FR-DeniseNeural">Denise (FR)</option>
          <option value="de-DE-ConradNeural">Conrad (DE)</option>
        </select>
      </div>
      <div class="form-group" id="tts-voice-piper-group" style="display: none;">
        <label class="form-label" for="tts-voice-piper">Voz (Piper)</label>
        <select class="form-select" id="tts-voice-piper">
          <optgroup label="English">
            <option value="en_US-amy-low">Amy (EN, Female)</option>
            <option value="en_US-ryan-low">Ryan (EN, Male)</option>
          </optgroup>
          <optgroup label="Español">
            <option value="es_ES-sharvard-medium">Sharvard (ES, Female, Medium)</option>
            <option value="es_ES-davefx-medium">Davefx (ES, Male, Medium)</option>
            <option value="es_MX-claude-high">Claude (MX, Female, High)</option>
            <option value="es_MX-ald-medium">Ald (MX, Male, Medium)</option>
            <option value="es_AR-daniela-high">Daniela (AR, Female, High)</option>
          </optgroup>
          <optgroup label="Français">
            <option value="fr_FR-siwis-medium">Siwis (FR, Female)</option>
            <option value="fr_FR-gilles-low">Gilles (FR, Male)</option>
          </optgroup>
          <optgroup label="Deutsch">
            <option value="de_DE-eva_k-x_low">Eva K (DE, Female)</option>
            <option value="de_DE-thorsten-medium">Thorsten (DE, Male)</option>
          </optgroup>
          <optgroup label="Italiano">
            <option value="it_IT-paola-medium">Paola (IT, Female)</option>
            <option value="it_IT-riccardo-x_low">Riccardo (IT, Male)</option>
          </optgroup>
          <optgroup label="Português">
            <option value="pt_BR-cadu-medium">Cadu (PT-BR, Female)</option>
            <option value="pt_PT-tugao-medium">Tugão (PT-PT, Male)</option>
          </optgroup>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label" id="tts-speed-label">Velocidad: <span id="tts-speed-value">1.0</span>x</label>
        <input type="range" class="form-range" id="tts-speed" min="0.5" max="2.0" step="0.1" value="1.0"
                aria-labelledby="tts-speed-label"
                oninput="document.getElementById('tts-speed-value').textContent = this.value" />
      </div>
      <div class="form-group" id="tts-metrics">
        <label class="form-label">Métricas</label>
        <div class="metrics-row">
          <div class="metric-mini">
            <span class="metric-label">Tiempo</span>
            <span class="metric-value" id="module-time-tts_engine">--</span>
          </div>
          <div class="metric-mini">
            <span class="metric-label">Memoria</span>
            <span class="metric-value" id="module-memory-tts_engine">--</span>
          </div>
          <div class="metric-mini">
            <span class="metric-label">Chunks</span>
            <span class="metric-value" id="module-chunks-tts_engine">--</span>
          </div>
          <div class="metric-mini">
            <span class="metric-label">Device</span>
            <span class="metric-value" id="module-device-tts_engine">--</span>
          </div>
        </div>
      </div>
    </div>
  </div>

<style>
  .tts-card {
    background: var(--bg-card);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-md);
    padding: 12px;
    transition: all 0.3s ease;
  }

  .tts-card.active {
    border-color: var(--success) !important;
    box-shadow: 0 0 12px rgba(16, 185, 129, 0.3) !important;
  }

  .process-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }

  .process-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--text-dim);
    transition: all 0.3s ease;
  }

  .process-indicator.active {
    background: #00ff00 !important;
    box-shadow: 0 0 6px #00ff00, 0 0 12px #00ff00 !important;
    animation: indicator-pulse 1.5s ease-in-out infinite;
  }

  @keyframes indicator-pulse {
    0%, 100% { opacity: 0.8; }
    50% { opacity: 1; }
  }

  .process-title {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-prime);
    flex: 1;
  }

  .toggle-switch {
    position: relative;
    display: inline-block;
    width: 36px;
    height: 20px;
  }

  .toggle-switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .toggle-slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--text-dim);
    transition: 0.3s;
    border-radius: 20px;
  }

  .toggle-slider:before {
    position: absolute;
    content: "";
    height: 14px;
    width: 14px;
    left: 3px;
    bottom: 3px;
    background-color: white;
    transition: 0.3s;
    border-radius: 50%;
  }

  input:checked + .toggle-slider {
    background-color: var(--success);
  }

  input:checked + .toggle-slider:before {
    transform: translateX(16px);
  }

  .process-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .form-label {
    font-size: 10px;
    color: var(--text-sec);
    font-weight: 500;
  }

  .form-select {
    width: 100%;
    padding: 8px 10px;
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-sm);
    color: var(--text-prime);
    font-size: 12px;
    outline: none;
    cursor: pointer;
  }

  .form-select:focus {
    border-color: var(--accent);
  }

  .form-range {
    width: 100%;
    height: 6px;
    -webkit-appearance: none;
    background: var(--bg-surface);
    border-radius: 3px;
    outline: none;
  }

  .form-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 16px;
    height: 16px;
    background: var(--accent);
    border-radius: 50%;
    cursor: pointer;
  }

  .metrics-row {
    display: flex;
    gap: 12px;
    padding: 8px;
    background: var(--bg-surface);
    border-radius: var(--radius-sm);
  }

  .metric-mini {
    flex: 1;
    text-align: center;
  }

  .metric-mini .metric-label {
    display: block;
    font-size: 9px;
    color: var(--text-sec);
    margin-bottom: 2px;
  }

  .metric-mini .metric-value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    color: var(--text-prime);
  }

  .gpu-badge {
    background: var(--text-dim);
    color: var(--text-sec);
    font-size: 8px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
  }

  .gpu-badge.active {
    background: linear-gradient(135deg, #76b900, #a8e600);
    color: #000;
  }
</style>
