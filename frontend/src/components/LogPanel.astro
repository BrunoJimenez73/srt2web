---

---

<div class="log-panel" role="region" aria-label="Panel de registros del sistema">
  <div class="log-header">
    <span class="log-title">📋 Logs</span>
    <div class="log-actions">
      <input 
        type="text" 
        class="log-search" 
        id="log-search" 
        placeholder="Filtrar..." 
        aria-label="Filtrar registros"
      />
      <button class="btn-clear" onclick="clearLogs()" aria-label="Limpiar todos los registros">Limpiar</button>
    </div>
  </div>
  <div class="log-content" id="log-content" role="log" aria-live="polite" aria-atomic="false">
    <div class="log-empty" id="log-empty">
      <span class="log-empty-icon">📝</span>
      <span class="log-empty-text">Sin registros aún</span>
    </div>
  </div>
</div>

<style>
  .log-panel {
    background: var(--bg-card);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-md);
    margin-top: 16px;
    overflow: hidden;
  }

  .log-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 12px;
    border-bottom: 1px solid var(--border-dim);
    gap: 8px;
  }

  .log-title {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-prime);
    flex-shrink: 0;
  }

  .log-actions {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .log-search {
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-sm);
    padding: 4px 8px;
    font-size: 10px;
    color: var(--text-prime);
    width: 120px;
    outline: none;
    transition: border-color 0.2s;
  }

  .log-search:focus {
    border-color: var(--accent);
    width: 160px;
  }

  .btn-clear {
    background: transparent;
    border: 1px solid var(--border-dim);
    color: var(--text-sec);
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    font-size: 10px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-clear:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .log-content {
    max-height: 200px;
    overflow-y: auto;
    padding: 8px 12px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    line-height: 1.6;
  }

  .log-content::-webkit-scrollbar {
    width: 6px;
  }

  .log-content::-webkit-scrollbar-track {
    background: var(--bg-surface);
  }

  .log-content::-webkit-scrollbar-thumb {
    background: var(--border-dim);
    border-radius: 3px;
  }

  .log-entry {
    margin-bottom: 4px;
    display: flex;
    gap: 8px;
  }

  .log-timestamp {
    color: var(--text-dim);
    flex-shrink: 0;
  }

  .log-level {
    flex-shrink: 0;
    width: 60px;
    font-weight: 600;
  }

  .log-level.info { color: var(--accent); }
  .log-level.warning { color: var(--warning); }
  .log-level.error { color: var(--error); }
  .log-level.success { color: var(--success); }

  .log-message {
    color: var(--text-prime);
    word-break: break-word;
  }

  .log-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px;
    color: var(--text-dim);
    gap: 8px;
  }

  .log-empty-icon {
    font-size: 24px;
    opacity: 0.5;
  }

  .log-empty-text {
    font-size: 11px;
  }
</style>

<script>
  import type { LogMessage } from '../lib/types';
  import { formatTimestamp } from '../lib/utils';

  const logContent = document.getElementById('log-content');
  const maxLogs = 500;

  const logEmpty = document.getElementById('log-empty');

  const logSearch = document.getElementById('log-search') as HTMLInputElement;
  let currentFilter = '';

  function addLog(level: LogMessage['level'], message: string, timestamp?: string): void {
    if (!logContent) return;
    
    // Hide empty state when adding first log
    if (logEmpty && logEmpty.parentElement === logContent) {
      logEmpty.remove();
    }
    
    const entry = document.createElement('div');
    entry.className = 'log-entry';
    entry.setAttribute('role', 'listitem');
    entry.dataset.level = level;
    entry.dataset.message = message.toLowerCase();
    
    const time = timestamp ? formatTimestamp(timestamp) : new Date().toLocaleTimeString('es-ES');
    
    entry.innerHTML = `
      <span class="log-timestamp">${time}</span>
      <span class="log-level ${level}">[${level.toUpperCase()}]</span>
      <span class="log-message">${escapeHtml(message)}</span>
    `;
    
    // Apply current filter
    if (currentFilter && !entry.dataset.message.includes(currentFilter.toLowerCase())) {
      entry.style.display = 'none';
    }
    
    logContent.appendChild(entry);
    
    while (logContent.children.length > maxLogs) {
      logContent.removeChild(logContent.firstChild!);
    }
    
    logContent.scrollTop = logContent.scrollHeight;
  }

  // Filter logs on search input
  logSearch?.addEventListener('input', (e) => {
    currentFilter = (e.target as HTMLInputElement).value;
    const entries = logContent?.querySelectorAll('.log-entry');
    entries?.forEach((entry) => {
      const el = entry as HTMLElement;
      if (currentFilter) {
        const matches = el.dataset.message?.includes(currentFilter.toLowerCase());
        el.style.display = matches ? '' : 'none';
      } else {
        el.style.display = '';
      }
    });
  });

  function escapeHtml(text: string): string {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  (window as unknown as { addLog: typeof addLog }).addLog = addLog;

  (window as unknown as { clearLogs: () => void }).clearLogs = function(): void {
    if (logContent) {
      logContent.innerHTML = '';
      // Restore empty state
      const emptyDiv = document.createElement('div');
      emptyDiv.className = 'log-empty';
      emptyDiv.id = 'log-empty';
      emptyDiv.innerHTML = `
        <span class="log-empty-icon">📝</span>
        <span class="log-empty-text">Sin registros aún</span>
      `;
      logContent.appendChild(emptyDiv);
    }
  };
</script>
