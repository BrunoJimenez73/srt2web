---

<div class="log-panel collapsed" role="region" aria-label="Panel de registros del sistema">
  <div class="log-header" id="log-header" onclick="window.toggleLogPanel()">
    <div class="log-header-left">
      <span class="log-collapse-icon" id="log-collapse-icon">▶</span>
      <span class="log-title">📋 Logs</span>
    </div>
    <div class="log-actions">
      <input 
        type="text" 
        class="log-search" 
        id="log-search" 
        placeholder="Filtrar..." 
        aria-label="Filtrar registros"
        onclick="event.stopPropagation()"
      />
      <button class="btn-clear" onclick="event.stopPropagation(); clearLogs()" aria-label="Limpiar todos los registros">Limpiar</button>
    </div>
  </div>
  <div class="log-content" id="log-content" role="log" aria-live="polite" aria-atomic="false">
    <div class="log-empty" id="log-empty">
      <span class="log-empty-icon">📝</span>
      <span class="log-empty-text">Sin registros aún</span>
    </div>
  </div>
</div>

<script>
  import { initLogPanel } from '../../lib/modules/logpanel';
  
  // Initialize log panel on component mount
  initLogPanel();
</script>