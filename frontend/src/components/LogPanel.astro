---

---

<div class="log-panel">
  <div class="log-header">
    <span class="log-title">📋 Logs</span>
    <button class="btn-clear" onclick="clearLogs()">Limpiar</button>
  </div>
  <div class="log-content" id="log-content">
  </div>
</div>

<style>
  .log-panel {
    background: var(--bg-card);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-md);
    margin-top: 16px;
    overflow: hidden;
  }

  .log-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 12px;
    border-bottom: 1px solid var(--border-dim);
  }

  .log-title {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-prime);
  }

  .btn-clear {
    background: transparent;
    border: 1px solid var(--border-dim);
    color: var(--text-sec);
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    font-size: 10px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-clear:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .log-content {
    max-height: 200px;
    overflow-y: auto;
    padding: 8px 12px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    line-height: 1.6;
  }

  .log-content::-webkit-scrollbar {
    width: 6px;
  }

  .log-content::-webkit-scrollbar-track {
    background: var(--bg-surface);
  }

  .log-content::-webkit-scrollbar-thumb {
    background: var(--border-dim);
    border-radius: 3px;
  }

  .log-entry {
    margin-bottom: 4px;
    display: flex;
    gap: 8px;
  }

  .log-timestamp {
    color: var(--text-dim);
    flex-shrink: 0;
  }

  .log-level {
    flex-shrink: 0;
    width: 60px;
    font-weight: 600;
  }

  .log-level.info { color: var(--accent); }
  .log-level.warning { color: var(--warning); }
  .log-level.error { color: var(--error); }
  .log-level.success { color: var(--success); }

  .log-message {
    color: var(--text-prime);
    word-break: break-word;
  }
</style>

<script>
  import type { LogMessage } from '../lib/types';
  import { formatTimestamp } from '../lib/utils';

  const logContent = document.getElementById('log-content');
  const maxLogs = 500;

  function addLog(level: LogMessage['level'], message: string, timestamp?: string): void {
    if (!logContent) return;
    
    const entry = document.createElement('div');
    entry.className = 'log-entry';
    
    const time = timestamp ? formatTimestamp(timestamp) : new Date().toLocaleTimeString('es-ES');
    
    entry.innerHTML = `
      <span class="log-timestamp">${time}</span>
      <span class="log-level ${level}">[${level.toUpperCase()}]</span>
      <span class="log-message">${escapeHtml(message)}</span>
    `;
    
    logContent.appendChild(entry);
    
    while (logContent.children.length > maxLogs) {
      logContent.removeChild(logContent.firstChild!);
    }
    
    logContent.scrollTop = logContent.scrollHeight;
  }

  function escapeHtml(text: string): string {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  (window as unknown as { addLog: typeof addLog }).addLog = addLog;

  (window as unknown as { clearLogs: () => void }).clearLogs = function(): void {
    if (logContent) logContent.innerHTML = '';
  };
</script>
