---
---

<div class="log-panel collapsed" role="region" aria-label="Panel de registros del sistema">
  <div class="log-header" id="log-header" role="button" tabindex="0" aria-expanded="false" aria-controls="log-content">
    <div class="log-header-left">
      <span class="log-collapse-icon" id="log-collapse-icon" aria-hidden="true">▶</span>
      <span class="log-title">📋 Logs</span>
      <span class="log-count" id="log-count"></span>
    </div>
    <div class="log-actions">
      <select
        class="log-level-select"
        id="log-level-filter"
        aria-label="Filtrar por nivel"
        onclick="event.stopPropagation()"
      >
        <option value="ALL">Todos</option>
        <option value="INFO">INFO</option>
        <option value="WARNING">WARNING</option>
        <option value="ERROR">ERROR</option>
      </select>
      <input
        type="text"
        class="log-search"
        id="log-search"
        placeholder="Buscar..."
        aria-label="Buscar en registros"
        onclick="event.stopPropagation()"
      />
      <button class="btn-export" id="btn-export-json" aria-label="Exportar JSON" title="Exportar JSON">📥</button>
      <button class="btn-export" id="btn-export-txt" aria-label="Exportar TXT" title="Exportar TXT">📄</button>
      <button class="btn-clear" id="btn-clear-logs" aria-label="Limpiar todos los registros">Limpiar</button>
    </div>
  </div>
  <div class="log-content" id="log-content" role="log" aria-live="polite" aria-atomic="false" aria-relevant="additions text">
    <div class="log-empty" id="log-empty" role="status">
      <span class="log-empty-icon">📝</span>
      <span class="log-empty-text">Sin registros aún</span>
    </div>
  </div>
</div>

<style>
  .log-search {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    color: #fff;
    padding: 4px 8px;
    font-size: 12px;
    width: 100px;
    outline: none;
    transition: border-color 0.2s;
  }

  .log-search:focus {
    border-color: #3b82f6;
  }

  .log-search::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }

  .log-level-select {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    color: #fff;
    padding: 4px 6px;
    font-size: 11px;
    outline: none;
    cursor: pointer;
  }

  .log-level-select:focus {
    border-color: #3b82f6;
  }

  .log-level-select option {
    background: #1e293b;
    color: #fff;
  }

  .btn-export {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    color: #fff;
    padding: 4px 8px;
    font-size: 12px;
    cursor: pointer;
    transition: background 0.2s;
  }

  .btn-export:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .log-count {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.6);
    margin-left: 8px;
  }

  .log-entry {
    padding: 2px 8px;
    font-size: 12px;
    font-family: monospace;
    white-space: pre-wrap;
    word-break: break-all;
    border-left: 3px solid transparent;
    line-height: 18px;
  }

  .log-entry[data-level="info"] {
    border-left-color: #3b82f6;
    background: rgba(59, 130, 246, 0.1);
  }

  .log-entry[data-level="success"] {
    border-left-color: #22c55e;
    background: rgba(34, 197, 94, 0.1);
  }

  .log-entry[data-level="warning"] {
    border-left-color: #f59e0b;
    background: rgba(245, 158, 11, 0.1);
  }

  .log-entry[data-level="error"] {
    border-left-color: #ef4444;
    background: rgba(239, 68, 68, 0.1);
  }

  .log-entry.hidden {
    display: none;
  }
</style>

<script>
  import { initLogPanel } from '../lib/modules/logpanel';

  // Virtual scroll state
  const ROW_HEIGHT = 22; // px per log entry (line-height 18 + padding 4)
  const OVERSCAN = 10;   // extra rows above/below viewport
  const MAX_VISIBLE_ROWS = 30; // max rendered rows at once

  let allEntries: Array<{level: string, message: string, timestamp: string}> = [];
  let filteredIndices: number[] = [];
  let currentFilter = '';
  let currentLevel = 'ALL';
  let scrollTop = 0;
  let containerHeight = 400;
  let rafId = 0;

  function getLogContent(): HTMLElement | null {
    return document.getElementById('log-content');
  }

  function getEmptyMsg(): HTMLElement | null {
    return document.getElementById('log-empty');
  }

  function updateEmptyState(): void {
    const empty = getEmptyMsg();
    if (!empty) return;
    empty.style.display = filteredIndices.length === 0 ? '' : 'none';
  }

  function applyFilters(): void {
    filteredIndices = [];
    allEntries.forEach((entry, idx) => {
      // Level filter
      if (currentLevel !== 'ALL' && entry.level.toUpperCase() !== currentLevel) return;
      // Text filter
      if (currentFilter) {
        const q = currentFilter.toLowerCase();
        if (!entry.message.toLowerCase().includes(q) && !entry.level.toLowerCase().includes(q)) return;
      }
      filteredIndices.push(idx);
    });
    updateEmptyState();
    renderVisible();
  }

  function renderVisible(): void {
    const container = getLogContent();
    if (!container) return;

    const totalHeight = filteredIndices.length * ROW_HEIGHT;
    const scrollPos = scrollTop;
    const viewportHeight = container.clientHeight || containerHeight;

    // Calculate visible range
    let startIdx = Math.floor(scrollPos / ROW_HEIGHT) - OVERSCAN;
    let endIdx = Math.ceil((scrollPos + viewportHeight) / ROW_HEIGHT) + OVERSCAN;
    startIdx = Math.max(0, startIdx);
    endIdx = Math.min(filteredIndices.length, endIdx);

    // Get existing entry elements
    const existing = container.querySelectorAll('.log-entry');
    const existingCount = existing.length;

    // Find which indices are currently rendered
    const renderedSet = new Set<number>();
    existing.forEach(el => {
      const idx = parseInt((el as HTMLElement).dataset.vindex || '-1', 10);
      if (idx >= 0) renderedSet.add(idx);
    });

    // Remove entries that are no longer visible
    existing.forEach(el => {
      const idx = parseInt((el as HTMLElement).dataset.vindex || '-1', 10);
      if (idx < startIdx || idx >= endIdx) {
        el.remove();
      }
    });

    // Add entries that became visible
    const fragment = document.createDocumentFragment();
    for (let i = startIdx; i < endIdx; i++) {
      if (renderedSet.has(i)) continue;
      const entry = allEntries[filteredIndices[i]];
      if (!entry) continue;

      const div = document.createElement('div');
      div.className = 'log-entry';
      div.dataset.level = entry.level;
      div.dataset.message = entry.message;
      div.dataset.vindex = String(i);
      div.textContent = `[${entry.timestamp}] ${entry.message}`;
      div.style.position = 'absolute';
      div.style.top = `${i * ROW_HEIGHT}px`;
      div.style.left = '0';
      div.style.right = '0';
      div.style.height = `${ROW_HEIGHT}px`;
      div.style.overflow = 'hidden';
      fragment.appendChild(div);
    }
    container.appendChild(fragment);

    // Update container padding to simulate full scroll height
    if (startIdx === 0) {
      container.style.paddingTop = '0';
    } else {
      container.style.paddingTop = `${startIdx * ROW_HEIGHT}px`;
    }

    // Set total height spacer
    const existingSpacer = container.querySelector('.log-spacer');
    if (totalHeight > 0) {
      if (existingSpacer) {
        (existingSpacer as HTMLElement).style.height = `${totalHeight}px`;
      } else {
        const spacer = document.createElement('div');
        spacer.className = 'log-spacer';
        spacer.style.height = `${totalHeight}px`;
        container.insertBefore(spacer, container.firstChild);
      }
    }
  }

  function onScroll(): void {
    const container = getLogContent();
    if (!container) return;
    scrollTop = container.scrollTop;
    if (rafId) cancelAnimationFrame(rafId);
    rafId = requestAnimationFrame(() => {
      renderVisible();
      rafId = 0;
    });
  }

  // Exposed: add a log entry
  function addLogEntry(level: string, message: string, timestamp: string): void {
    allEntries.push({ level, message, timestamp });

    // Keep max 1000 entries
    if (allEntries.length > 1000) {
      allEntries = allEntries.slice(-1000);
    }

    applyFilters();

    // Auto-scroll to bottom if already at bottom
    const container = getLogContent();
    if (container) {
      const atBottom = container.scrollTop + container.clientHeight >= container.scrollHeight - 50;
      if (atBottom) {
        setTimeout(() => {
          container.scrollTop = container.scrollHeight;
        }, 0);
      }
    }
  }

  // Clear all logs
  function clearLogs(): void {
    allEntries = [];
    filteredIndices = [];
    const container = getLogContent();
    if (container) {
      container.querySelectorAll('.log-entry').forEach(el => el.remove());
      const spacer = container.querySelector('.log-spacer');
      if (spacer) spacer.remove();
      container.style.paddingTop = '0';
      container.scrollTop = 0;
    }
    updateEmptyState();
  }

  // Filter functions exposed to global
  function setLevelFilter(level: string): void {
    currentLevel = level;
    applyFilters();
  }

  function setSearchFilter(text: string): void {
    currentFilter = text;
    applyFilters();
  }

  // Initialize on mount
  initLogPanel();

  document.addEventListener('DOMContentLoaded', function() {
    // Toggle log panel
    const logHeader = document.getElementById('log-header');
    if (logHeader) {
      logHeader.addEventListener('click', function() {
        window.toggleLogPanel();
        const panel = document.querySelector('.log-panel');
        logHeader.setAttribute('aria-expanded', panel?.classList.contains('collapsed') ? 'false' : 'true');
        // Re-render on expand
        if (!panel?.classList.contains('collapsed')) {
          setTimeout(() => renderVisible(), 50);
        }
      });
      logHeader.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          window.toggleLogPanel();
          const panel = document.querySelector('.log-panel');
          logHeader.setAttribute('aria-expanded', panel?.classList.contains('collapsed') ? 'false' : 'true');
        }
      });
    }

    // Setup scroll handler on log-content
    const logContent = getLogContent();
    if (logContent) {
      logContent.addEventListener('scroll', onScroll);
      containerHeight = logContent.clientHeight || 400;
    }

    // Setup level filter
    const levelSelect = document.getElementById('log-level-filter') as HTMLSelectElement;
    if (levelSelect) {
      levelSelect.addEventListener('change', (e) => {
        setLevelFilter((e.target as HTMLSelectElement).value);
      });
    }

    // Setup search with debounce
    const searchInput = document.getElementById('log-search') as HTMLInputElement;
    if (searchInput) {
      let debounceTimer: number;
      searchInput.addEventListener('input', (e) => {
        clearTimeout(debounceTimer);
        debounceTimer = window.setTimeout(() => {
          setSearchFilter((e.target as HTMLInputElement).value);
        }, 200);
      });
    }

    // Clear logs button
    const btnClearLogs = document.getElementById('btn-clear-logs');
    if (btnClearLogs) {
      btnClearLogs.addEventListener('click', function(e) {
        e.stopPropagation();
        clearLogs();
      });
    }

    // Stop propagation on search input
    const logSearch = document.getElementById('log-search');
    if (logSearch) {
      logSearch.addEventListener('click', function(e) {
        e.stopPropagation();
      });
    }
  });

  // Expose functions globally for logpanel.ts
  (window as unknown as {
    addLogEntry: typeof addLogEntry;
    clearLogs: typeof clearLogs;
    setLevelFilter: typeof setLevelFilter;
    setSearchFilter: typeof setSearchFilter;
  }).addLogEntry = addLogEntry;
  (window as unknown as { clearLogs: typeof clearLogs }).clearLogs = clearLogs;
</script>
