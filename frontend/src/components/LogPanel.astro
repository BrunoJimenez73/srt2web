---
import { t, initLanguage } from "../lib/i18n";
initLanguage();
---

<div
  class="log-panel collapsed"
  role="region"
  aria-label={t("log_title")}
  data-testid="log-panel"
>
  <div
    class="log-header"
    id="log-header"
    role="button"
    tabindex="0"
    aria-expanded="false"
    aria-controls="log-content"
    data-testid="btn-toggle-logs"
  >
    <div class="log-header-left">
      <span class="log-collapse-icon" id="log-collapse-icon" aria-hidden="true">▶</span>
      <span class="log-title">📋 {t("log_title")}</span>
      <span class="log-count" id="log-count"></span>
    </div>
    <div class="log-actions" id="log-actions">
      <select
        class="log-level-select"
        id="log-level-filter"
        data-testid="log-level-filter"
        aria-label={t("log_filter_all")}
      >
        <option value="ALL">{t("log_filter_all")}</option>
        <option value="INFO">{t("log_filter_info")}</option>
        <option value="WARNING">{t("log_filter_warning")}</option>
        <option value="ERROR">{t("log_filter_error")}</option>
      </select>
      <input
        type="text"
        class="log-search"
        id="log-search"
        data-testid="log-search"
        placeholder={t("log_search_placeholder")}
        aria-label={t("search_logs")}
      />
      <button
        class="btn-export"
        id="btn-export-json"
        data-testid="btn-export-logs"
        aria-label={t("log_export_json")}
        title={t("log_export_json")}
      >📥</button>
      <button
        class="btn-export"
        id="btn-export-txt"
        aria-label={t("log_export_txt")}
        title={t("log_export_txt")}
      >📄</button>
      <button
        class="btn-clear"
        id="btn-clear-logs"
        aria-label={t("clear_logs")}
      >{t("log_clear")}</button>
    </div>
  </div>
  <div
    class="log-content"
    id="log-content"
    role="log"
    aria-live="polite"
    aria-atomic="false"
    aria-relevant="additions text"
  >
    <div class="log-empty" id="log-empty" role="status">
      <span class="log-empty-icon" aria-hidden="true">📝</span>
      <span class="log-empty-text">{t("no_logs_yet")}</span>
    </div>
  </div>
</div>

<style>
  .log-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-left: 12px;
  }

  .log-search {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    color: #fff;
    padding: 4px 8px;
    font-size: 12px;
    width: 100px;
    outline: none;
    transition: border-color 0.2s;
  }

  .log-search:focus {
    border-color: #3b82f6;
  }

  .log-search::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }

  .log-level-select {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    color: #fff;
    padding: 4px 6px;
    font-size: 11px;
    outline: none;
    cursor: pointer;
  }

  .log-level-select:focus {
    border-color: #3b82f6;
  }

  .log-level-select option {
    background: #1e293b;
    color: #fff;
  }

  .btn-export {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    color: #fff;
    padding: 4px 8px;
    font-size: 12px;
    cursor: pointer;
    transition: background 0.2s;
  }

  .btn-export:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .btn-clear {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: 4px;
    color: #fff;
    padding: 4px 10px;
    font-size: 11px;
    cursor: pointer;
    transition: background 0.2s;
  }

  .btn-clear:hover {
    background: rgba(239, 68, 68, 0.3);
  }

  .log-count {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.6);
    margin-left: 8px;
  }

  .log-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 7px 14px;
    cursor: pointer;
    user-select: none;
  }

  .log-header:hover {
    background: rgba(212, 160, 65, 0.04);
  }

  .log-header:focus-visible {
    outline: 2px solid var(--accent, #3b82f6);
    outline-offset: -2px;
  }

  .log-header-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .log-collapse-icon {
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    color: var(--accent, #d4a041);
    width: 12px;
    text-align: center;
    transition: transform 0.15s;
  }

  .log-panel.collapsed .log-collapse-icon {
    transform: rotate(0deg);
  }

  .log-panel:not(.collapsed) .log-collapse-icon {
    transform: rotate(90deg);
  }

  .log-panel.collapsed .log-content,
  .log-panel.collapsed .log-actions {
    display: none;
  }

  .log-entry {
    padding: 2px 8px;
    font-size: 12px;
    font-family: monospace;
    white-space: pre-wrap;
    word-break: break-all;
    border-left: 3px solid transparent;
    line-height: 18px;
  }

  .log-entry[data-level="info"] {
    border-left-color: #3b82f6;
    background: rgba(59, 130, 246, 0.1);
  }

  .log-entry[data-level="success"] {
    border-left-color: #22c55e;
    background: rgba(34, 197, 94, 0.1);
  }

  .log-entry[data-level="warning"] {
    border-left-color: #f59e0b;
    background: rgba(245, 158, 94, 0.1);
  }

  .log-entry[data-level="error"] {
    border-left-color: #ef4444;
    background: rgba(239, 68, 68, 0.1);
  }

  .log-entry.hidden {
    display: none;
  }
</style>
