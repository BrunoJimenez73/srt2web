---

---

<div class="log-panel collapsed" role="region" aria-label="Panel de registros del sistema">
  <div class="log-header" id="log-header" role="button" tabindex="0" aria-expanded="false" aria-controls="log-content">
    <div class="log-header-left">
      <span class="log-collapse-icon" id="log-collapse-icon" aria-hidden="true">▶</span>
      <span class="log-title">📋 Logs</span>
      <span class="log-count" id="log-count"></span>
    </div>
    <div class="log-actions">
      <select
        class="log-level-select"
        id="log-level-filter"
        aria-label="Filtrar por nivel"
        onclick="event.stopPropagation()"
      >
        <option value="ALL">Todos</option>
        <option value="INFO">INFO</option>
        <option value="WARNING">WARNING</option>
        <option value="ERROR">ERROR</option>
      </select>
      <input
        type="text"
        class="log-search"
        id="log-search"
        placeholder="Buscar..."
        aria-label="Buscar en registros"
        onclick="event.stopPropagation()"
      />
      <button class="btn-export" id="btn-export-json" aria-label="Exportar JSON" title="Exportar JSON">📥</button>
      <button class="btn-export" id="btn-export-txt" aria-label="Exportar TXT" title="Exportar TXT">📄</button>
      <button class="btn-clear" id="btn-clear-logs" aria-label="Limpiar todos los registros">Limpiar</button>
    </div>
  </div>
  <div class="log-content" id="log-content" role="log" aria-live="polite" aria-atomic="false" aria-relevant="additions text">
    <div class="log-empty" id="log-empty" role="status">
      <span class="log-empty-icon">📝</span>
      <span class="log-empty-text">Sin registros aún</span>
    </div>
  </div>
</div>

<style>
  .log-search {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    color: #fff;
    padding: 4px 8px;
    font-size: 12px;
    width: 100px;
    outline: none;
    transition: border-color 0.2s;
  }

  .log-search:focus {
    border-color: #3b82f6;
  }

  .log-search::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }

  .log-level-select {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    color: #fff;
    padding: 4px 6px;
    font-size: 11px;
    outline: none;
    cursor: pointer;
  }

  .log-level-select:focus {
    border-color: #3b82f6;
  }

  .log-level-select option {
    background: #1e293b;
    color: #fff;
  }

  .btn-export {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    color: #fff;
    padding: 4px 8px;
    font-size: 12px;
    cursor: pointer;
    transition: background 0.2s;
  }

  .btn-export:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .log-count {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.6);
    margin-left: 8px;
  }

  .log-entry {
    padding: 2px 8px;
    font-size: 12px;
    font-family: monospace;
    white-space: pre-wrap;
    word-break: break-all;
    border-left: 3px solid transparent;
  }

  .log-entry[data-level="info"] {
    border-left-color: #3b82f6;
    background: rgba(59, 130, 246, 0.1);
  }

  .log-entry[data-level="success"] {
    border-left-color: #22c55e;
    background: rgba(34, 197, 94, 0.1);
  }

  .log-entry[data-level="warning"] {
    border-left-color: #f59e0b;
    background: rgba(245, 158, 11, 0.1);
  }

  .log-entry[data-level="error"] {
    border-left-color: #ef4444;
    background: rgba(239, 68, 68, 0.1);
  }

  .log-entry.hidden {
    display: none;
  }
</style>

<script>
  import { initLogPanel } from '../lib/modules/logpanel';

  // Current filter state for log search
  let currentFilter = '';

  // Filter log entries based on search input
  function filterLogs(searchTerm: string): void {
    currentFilter = searchTerm.toLowerCase();
    const entries = document.querySelectorAll('.log-entry');
    entries.forEach(entry => {
      const level = (entry as HTMLElement).dataset.level || '';
      const message = (entry as HTMLElement).dataset.message || '';
      if (currentFilter === '' || message.toLowerCase().includes(currentFilter) || level.includes(currentFilter)) {
        entry.classList.remove('hidden');
      } else {
        entry.classList.add('hidden');
      }
    });
  }

  // Add a log entry with data attributes for filtering
  function addLogEntry(level: string, message: string, timestamp: string): void {
    const logContent = document.getElementById('log-content');
    if (!logContent) return;

    const entry = document.createElement('div');
    entry.className = 'log-entry';
    entry.dataset.level = level;
    entry.dataset.message = message;
    entry.textContent = `[${timestamp}] ${message}`;

    // Apply filter if active
    if (currentFilter) {
      const msgLower = message.toLowerCase();
      if (!msgLower.includes(currentFilter) && !level.includes(currentFilter)) {
        entry.classList.add('hidden');
      }
    }

    logContent.appendChild(entry);
    logContent.scrollTop = logContent.scrollHeight;
  }

  // Initialize log panel on component mount
  initLogPanel();

  // Add event listeners for LogPanel
  document.addEventListener('DOMContentLoaded', function() {
    // Toggle log panel
    const logHeader = document.getElementById('log-header');
    if (logHeader) {
      logHeader.addEventListener('click', function() {
        window.toggleLogPanel();
        const panel = document.querySelector('.log-panel');
        logHeader.setAttribute('aria-expanded', panel?.classList.contains('collapsed') ? 'false' : 'true');
      });
      logHeader.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          window.toggleLogPanel();
          const panel = document.querySelector('.log-panel');
          logHeader.setAttribute('aria-expanded', panel?.classList.contains('collapsed') ? 'false' : 'true');
        }
      });
    }

    // Stop propagation on search input
    const logSearch = document.getElementById('log-search');
    if (logSearch) {
      logSearch.addEventListener('click', function(e) {
        e.stopPropagation();
      });
    }

    // Clear logs button
    const btnClearLogs = document.getElementById('btn-clear-logs');
    if (btnClearLogs) {
      btnClearLogs.addEventListener('click', function(e) {
        e.stopPropagation();
        clearLogs();
      });
    }
  });

  // Setup search filter
  const searchInput = document.getElementById('log-search');
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      filterLogs((e.target as HTMLInputElement).value);
    });
  }

  // Expose functions globally
  (window as unknown as { addLogEntry: typeof addLogEntry }).addLogEntry = addLogEntry;
</script>
