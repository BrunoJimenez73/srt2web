---
import Button from '../ui/Button.astro';

type HeaderProps = {
  version?: string;
};

const { version = '0.6.1' }: HeaderProps = Astro.props;
---

<header class="flex justify-between items-center mb-4 pb-3 border-b border-white/8">
  <div class="flex items-center gap-2.5">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" fill="none" class="w-8 h-8" aria-hidden="true">
      <circle cx="16" cy="16" r="14" stroke="url(#grad)" stroke-width="2"/>
      <path d="M10 20L16 10L22 20H10Z" fill="url(#grad)"/>
      <defs>
        <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#6366f1"/>
          <stop offset="100%" stop-color="#a855f7"/>
        </linearGradient>
      </defs>
    </svg>
    <span class="text-lg font-bold text-accent">SRT2Web</span>
    <span class="bg-card px-2 py-0.5 rounded-full text-xs text-surface-dim border border-white/8" aria-label="Versión">{version}</span>
    </div>

    <div class="flex items-center gap-2.5">
      <!-- Preset Controls (F19) -->
      <div class="relative">
        <button id="btn-save-preset" class="flex items-center gap-1.5 bg-card border border-white/8 px-2.5 py-1.5 rounded-md text-xs font-semibold transition-all hover:border-accent text-surface-dim hover:text-surface-light hover:bg-card cursor-pointer" aria-haspopup="true" aria-expanded="false" aria-label="Guardar preset">
          <span aria-hidden="true">💾</span>
          <span>Guardar</span>
          <span class="text-xs transition-transform" aria-hidden="true">▾</span>
        </button>
        <div id="preset-panel" class="absolute top-[calc(100%+8px)] right-0 w-64 bg-card border border-white/8 rounded-lg p-2 shadow-xl z-50 hidden" role="menu" aria-label="Panel de presets">
          <div class="flex gap-1 mb-2">
            <input type="text" id="preset-name-input" placeholder="Nombre del preset..." class="flex-1 bg-deep border border-white/8 rounded-md px-2 py-1 text-xs text-surface-light font-mono outline-none focus:border-accent" aria-label="Nombre del preset" />
            <button id="btn-confirm-save" class="bg-accent text-white border-none rounded-md px-2 py-1 text-xs font-semibold cursor-pointer transition-all hover:bg-accent-hover" aria-label="Guardar preset">
              Guardar
            </button>
          </div>
          <div id="preset-list" class="max-h-48 overflow-y-auto text-xs">
            <!-- Built-in presets -->
            <div class="text-surface-dim font-semibold px-2 py-1 border-b border-white/10">Built-in</div>
            <button class="preset-item w-full text-left px-2 py-1.5 hover:bg-white/10 rounded text-surface-light text-xs" data-preset="low_latency" data-builtin="true">
              <span class="font-medium">Low Latency</span>
              <div class="text-surface-dim text-[10px]">10s chunks, sin traducción/TTS</div>
            </button>
            <button class="preset-item w-full text-left px-2 py-1.5 hover:bg-white/10 rounded text-surface-light text-xs" data-preset="high_quality" data-builtin="true">
              <span class="font-medium">High Quality</span>
              <div class="text-surface-dim text-[10px]">Large Whisper, pipeline completo</div>
            </button>
            <button class="preset-item w-full text-left px-2 py-1.5 hover:bg-white/10 rounded text-surface-light text-xs" data-preset="spanish_stream" data-builtin="true">
              <span class="font-medium">Spanish Stream</span>
              <div class="text-surface-dim text-[10px]">es→en, voz Sharvard</div>
            </button>
            <!-- Saved presets -->
            <div id="saved-presets-header" class="text-surface-dim font-semibold px-2 py-1 border-b border-white/10 hidden">Guardados</div>
            <div id="saved-presets-list" class="hidden"></div>
            <div id="no-presets-msg" class="px-2 py-2 text-surface-dim text-xs hidden">No hay presets guardados</div>
          </div>
        </div>
      </div>

      <button id="btn-export-config" class="text-surface-dim no-underline px-2.5 py-1.5 rounded-md text-xs font-semibold transition-all border border-white/8 hover:bg-card hover:text-surface-light hover:border-accent" aria-label="Exportar configuración YAML" title="Exportar config como YAML">
        📤 Export YAML
      </button>

      <button id="btn-shortcuts-help" class="text-surface-dim no-underline px-2.5 py-1.5 rounded-md text-xs font-semibold transition-all border border-white/8 hover:bg-card hover:text-surface-light hover:border-accent" aria-label="Keyboard shortcuts" title="Ctrl+S: Save | Space: Start/Stop | Ctrl+D: Dark mode">
        ⌨️ Shortcuts
      </button>
      <a href="/docs/" class="text-surface-dim no-underline px-2.5 py-1.5 rounded-md text-xs font-semibold transition-all border border-white/8 hover:bg-card hover:text-surface-light hover:border-accent" target="_blank" rel="noopener noreferrer">
        📚 Docs
      </a>
    <div id="ws-status" class="ws-status disconnected" role="status" aria-label="Estado WebSocket">
      <span class="ws-status-dot"></span>
      <span class="ws-status-label">WS OFF</span>
    </div>

    <!-- Security Toggle -->
    <div class="relative">
      <button id="btn-secure-toggle" class="flex items-center gap-1.5 bg-card border border-white/8 px-2.5 py-1.5 rounded-md text-xs text-surface-dim cursor-pointer transition-all hover:border-accent" aria-haspopup="true" aria-expanded="false">
        <span aria-hidden="true">🔐</span>
        <span id="secure-label">Secure OFF</span>
        <span id="secure-arrow" class="text-xs transition-transform" aria-hidden="true">▾</span>
      </button>
      <div id="secure-panel" class="absolute top-[calc(100%+8px)] right-0 w-70 bg-card border border-white/8 rounded-lg p-3 shadow-xl z-50 hidden" role="dialog" aria-label="Panel de autenticación">
        <div class="flex justify-between items-center mb-2.5 text-xs font-semibold text-surface-dim">
          <span>Token de autenticación</span>
          <button id="btn-close-secure" class="text-surface-dimmer cursor-pointer text-sm px-1 hover:text-surface-light" aria-label="Cerrar panel">✕</button>
        </div>
        <div class="flex gap-1 mb-2.5">
          <input type="password" id="secure-token-input" placeholder="Ingresa token..." class="flex-1 bg-deep border border-white/8 rounded-md px-2 py-1.5 text-xs text-surface-light font-mono outline-none focus:border-accent" aria-label="Token de autenticación" />
          <button id="btn-eye-token" title="Mostrar/Ocultar" class="bg-deep border border-white/8 rounded-md px-2 py-1.5 cursor-pointer text-xs" aria-label="Mostrar u ocultar token">👁</button>
        </div>
        <div class="flex gap-1.5">
          <button id="btn-gen-token" title="Generar token" class="bg-deep border border-white/8 rounded-md px-2.5 py-1.5 cursor-pointer text-sm transition-all hover:bg-card" aria-label="Generar token aleatorio">🎲</button>
          <button id="btn-save-secure" class="flex-1 bg-accent text-white border-none rounded-md px-2.5 py-1.5 text-xs font-semibold cursor-pointer transition-all hover:bg-accent-hover" aria-label="Guardar token">💾 Guardar</button>
        </div>
      </div>
    </div>

    <span id="live-clock" class="live-clock" role="timer" aria-label="Hora actual">--:--:--</span>
    <Button id="btn-save-config" onclick="saveConfig()" aria-label="Guardar configuración actual">
      <span class="btn-text">💾 Guardar Config</span>
      <span class="btn-loading hidden" aria-hidden="true"></span>
    </Button>
  </div>
</header>

<script>
  import { initSecurityPanel } from '../../lib/modules/header';
  import { loadPresets, applyPreset, savePreset, exportConfig } from '../../lib/modules/pipeline-control';
  import { presets, selectedPreset } from '../../lib/store/signals';

  // Initialize security panel on component mount
  initSecurityPanel();

  // Load presets on mount
  loadPresets();

  // Handle preset selection
  document.getElementById('preset-list').addEventListener('click', async (e) => {
    const item = e.target.closest('.preset-item');
    if (!item) return;
    const name = item.dataset.preset;
    if (name) {
      selectedPreset.value = name;
      await applyPreset(name);
    }
  });

  // Handle save preset
  document.getElementById('btn-confirm-save').addEventListener('click', async () => {
    const name = document.getElementById('preset-name-input').value.trim();
    if (name) {
      await savePreset(name);
      document.getElementById('preset-name-input').value = '';
    }
  });

  // Handle export YAML
  document.getElementById('btn-export-config').addEventListener('click', () => {
    exportConfig();
  });

  // Toggle preset panel
  document.getElementById('btn-save-preset').addEventListener('click', (e) => {
    e.stopPropagation();
    const panel = document.getElementById('preset-panel');
    panel.classList.toggle('hidden');
  });

  // Close panel on outside click
  document.addEventListener('click', (e) => {
    const panel = document.getElementById('preset-panel');
    const btn = document.getElementById('btn-save-preset');
    if (!panel.contains(e.target) && !btn.contains(e.target)) {
      panel.classList.add('hidden');
    }
  });
</script>