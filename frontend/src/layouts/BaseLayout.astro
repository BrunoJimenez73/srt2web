---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>
    <slot />
</body>
</html>

<style is:global>
    :root {
        --bg-deep: #0a0a0f;
        --bg-surface: #12121a;
        --bg-card: #1a1a24;
        --bg-card-hover: #222230;
        --border-dim: rgba(255,255,255,0.08);
        --border-accent: rgba(99,102,241,0.3);
        --text-pure: #fff;
        --text-prime: #e4e4e8;
        --text-sec: #8888a0;
        --text-dim: #555570;
        --accent: #6366f1;
        --accent-hover: #7c7ff7;
        --success: #10b981;
        --warning: #f59e0b;
        --error: #ef4444;
        --radius-lg: 12px;
        --radius-md: 8px;
        --radius-sm: 6px;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
        font-family: 'Inter', system-ui, sans-serif;
        background: var(--bg-deep);
        color: var(--text-prime);
        min-height: 100vh;
        font-size: 13px;
        overflow-y: auto;
        overflow-x: hidden;
    }

    @keyframes phosphor-pulse {
        0%, 100% { opacity: 0.8; box-shadow: 0 0 8px #00ff00, 0 0 15px #00ff00; }
        50% { opacity: 1; box-shadow: 0 0 15px #00ff00, 0 0 30px #00ff00, 0 0 45px #00ff00; }
    }

    @keyframes error-pulse {
        0%, 100% { opacity: 0.8; box-shadow: 0 0 8px #ff3333, 0 0 15px #ff3333; }
        50% { opacity: 1; box-shadow: 0 0 15px #ff3333, 0 0 30px #ff3333; }
    }

    @keyframes indicator-pulse {
        0%, 100% { opacity: 0.8; box-shadow: 0 0 4px #00ff00, 0 0 8px #00ff00; }
        50% { opacity: 1; box-shadow: 0 0 8px #00ff00, 0 0 16px #00ff00, 0 0 24px #00ff00; }
    }

    /* Process Card Indicators - Global */
    .process-indicator {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--text-dim);
        transition: all 0.3s ease;
        display: inline-block;
        flex-shrink: 0;
    }

    .process-indicator.active {
        background: #00ff00 !important;
        box-shadow: 0 0 6px #00ff00, 0 0 12px #00ff00, 0 0 18px #00ff00;
        animation: indicator-pulse 1.5s ease-in-out infinite;
    }

    /* Active state for cards */
    #card-input.active,
    #card-whisper.active,
    #card-translate.active,
    #card-tts.active,
    #card-subtitle.active,
    #card-hls.active,
    #card-output.active {
        border-color: var(--success);
        box-shadow: 0 0 12px rgba(16, 185, 129, 0.2);
    }

    /* Status dot */
    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--text-dim);
        display: inline-block;
    }

    .status-dot.running {
        background: #00ff00;
        box-shadow: 0 0 6px #00ff00, 0 0 12px #00ff00;
        animation: indicator-pulse 1.5s ease-in-out infinite;
    }

    /* Process Card Base */
    .process-card {
        background: var(--bg-card);
        border: 1px solid var(--border-dim);
        border-radius: var(--radius-md);
        padding: 12px;
        transition: all 0.3s ease;
    }

    .process-card.disabled {
        opacity: 0.5;
    }

    .process-header {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 10px;
    }

    .process-title {
        font-size: 11px;
        font-weight: 600;
        color: var(--text-prime);
        flex: 1;
    }

    .process-settings {
        opacity: 1;
        transition: opacity 0.3s ease;
    }

    .process-card.disabled .process-settings {
        opacity: 0.5;
    }

    /* Toggle Switch */
    .toggle-switch {
        position: relative;
        display: inline-block;
        width: 36px;
        height: 20px;
    }

    .toggle-switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .toggle-slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: var(--text-dim);
        transition: 0.3s;
        border-radius: 20px;
    }

    .toggle-slider:before {
        position: absolute;
        content: "";
        height: 14px;
        width: 14px;
        left: 3px;
        bottom: 3px;
        background-color: white;
        transition: 0.3s;
        border-radius: 50%;
    }

    input:checked + .toggle-slider {
        background-color: var(--success);
    }

    input:checked + .toggle-slider:before {
        transform: translateX(16px);
    }

    /* Form Elements */
    .form-group {
        margin-bottom: 8px;
    }

    .form-label {
        display: block;
        font-size: 10px;
        color: var(--text-sec);
        margin-bottom: 4px;
        font-weight: 500;
    }

    .form-input, .form-select {
        width: 100%;
        padding: 8px 10px;
        background: var(--bg-surface);
        border: 1px solid var(--border-dim);
        border-radius: var(--radius-sm);
        color: var(--text-prime);
        font-size: 12px;
        outline: none;
        transition: border-color 0.2s;
    }

    .form-input:focus, .form-select:focus {
        border-color: var(--accent);
    }

    .form-select {
        cursor: pointer;
    }

    /* Live Clock */
    .live-clock {
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        color: var(--text-sec);
        background: var(--bg-surface);
        padding: 4px 10px;
        border-radius: var(--radius-sm);
        border: 1px solid var(--border-dim);
        letter-spacing: 0.5px;
    }

    /* WebSocket Status Indicator */
    .ws-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 11px;
        color: var(--text-sec);
        padding: 4px 8px;
        border-radius: var(--radius-sm);
        background: var(--bg-surface);
        border: 1px solid var(--border-dim);
    }

    .ws-status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--text-dim);
        transition: all 0.3s ease;
    }

    .ws-status.connected .ws-status-dot {
        background: var(--success);
        box-shadow: 0 0 6px var(--success);
    }

    .ws-status.connecting .ws-status-dot {
        background: var(--warning);
        animation: blink 1s ease-in-out infinite;
    }

    .ws-status.disconnected .ws-status-dot {
        background: var(--error);
    }

    @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.3; }
    }

    /* Metrics Grid */
    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
        gap: 8px;
        padding: 10px;
        background: var(--bg-surface);
        border-radius: var(--radius-md);
        border: 1px solid var(--border-dim);
    }

    .metric-item {
        text-align: center;
        padding: 8px;
        background: var(--bg-card);
        border-radius: var(--radius-sm);
    }

    .metric-label {
        font-size: 10px;
        color: var(--text-sec);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 4px;
    }

    .metric-value {
        font-family: 'JetBrains Mono', monospace;
        font-size: 14px;
        font-weight: 600;
        color: var(--text-prime);
    }

    .metric-value.success {
        color: var(--success);
    }

    .metric-value.warning {
        color: var(--warning);
    }

    .metric-value.error {
        color: var(--error);
    }

    /* Module Metrics in Cards */
    .module-metrics {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        font-size: 10px;
        color: var(--text-sec);
        padding-top: 8px;
        border-top: 1px solid var(--border-dim);
        margin-top: 8px;
    }

    .module-metric {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .module-metric-label {
        opacity: 0.7;
    }

    .module-metric-value {
        font-family: 'JetBrains Mono', monospace;
        font-weight: 500;
    }

    /* Config Saved Indicator */
    .config-saved-indicator {
        font-size: 9px;
        color: var(--success);
        opacity: 0;
        transition: opacity 0.3s ease;
        margin-left: 4px;
    }

    /* Slider/Range Input Styles */
    input[type="range"] {
        -webkit-appearance: none;
        appearance: none;
        width: 100%;
        height: 6px;
        background: var(--bg-deep);
        border-radius: 3px;
        outline: none;
        padding: 0;
        margin: 8px 0;
    }

    input[type="range"]::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: var(--accent);
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 0 4px rgba(99, 102, 241, 0.4);
    }

    input[type="range"]::-webkit-slider-thumb:hover {
        transform: scale(1.2);
        box-shadow: 0 0 8px rgba(99, 102, 241, 0.6);
    }

    input[type="range"]::-moz-range-thumb {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: var(--accent);
        cursor: pointer;
        border: none;
        transition: all 0.2s ease;
        box-shadow: 0 0 4px rgba(99, 102, 241, 0.4);
    }

    input[type="range"]::-moz-range-thumb:hover {
        transform: scale(1.2);
        box-shadow: 0 0 8px rgba(99, 102, 241, 0.6);
    }

    /* Number Input with Spinners */
    input[type="number"] {
        -moz-appearance: textfield;
    }

    input[type="number"]::-webkit-outer-spin-button,
    input[type="number"]::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
</style>